        <div class="row g-4">
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="fw-bold mb-3" style="font-size:0.95rem;">
                    <i class="bi bi-shield-shaded text-primary me-2"></i>HELMET HAVEN
                </div>
                <p class="text-secondary" style="font-size:0.83rem; line-height:1.7; max-width:240px;">Designing the future of rider safety with uncompromising style and technology since 2012.</p>
            </div>
            <div class="col-6 col-sm-3 col-lg-2">
                <h6 class="fw-bold mb-3" style="font-size:0.82rem;">Shop</h6>
                <ul class="footer-link-list">
                    <li>Street Helmets</li>
                    <li>Racing Series</li>
                    <li>Accessories</li>
                </ul>
            </div>
