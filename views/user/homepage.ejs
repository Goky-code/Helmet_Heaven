      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:10px;
      font-weight:bold;
    "
  >0</span>
</a>

                </div>
            </div>

        </div>
    </nav>

    <!-- ── HERO ── -->
    <section class="hero-section">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
