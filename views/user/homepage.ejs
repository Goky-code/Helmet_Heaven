<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Helmet Haven | Safety Redefined</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-dark: #070b11;
            --card-bg: #111821;
            --accent-blue: #007bff;
            --text-gray: #8b949e;
            --border-color: #21262d;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--bg-dark);
            color: white;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }

        /* ── NAVBAR ── */
        .navbar {
            background-color: var(--bg-dark);
            padding: 14px 5%;
            border-bottom: 1px solid var(--border-color);
        }
        .navbar-brand { font-weight: 800; font-size: 1rem; white-space: nowrap; }
        .nav-link { color: var(--text-gray) !important; font-size: 0.9rem; padding: 6px 10px !important; }
        .nav-link:hover { color: white !important; }

        .search-bar {
            background: #1c2128;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: white;
            padding: 8px 14px;
            font-size: 0.8rem;
            width: 100%;
            max-width: 260px;
            outline: none;
        }
        .search-bar::placeholder { color: var(--text-gray); }
        .search-bar:focus { border-color: var(--accent-blue); }

        .nav-icons { display: flex; align-items: center; gap: 18px; font-size: 1.1rem; flex-shrink: 0; }
        .nav-icons a, .nav-icons i { color: var(--text-gray); text-decoration: none; cursor: pointer; }
        .nav-icons a:hover, .nav-icons i:hover { color: white; }

        /* Hamburger */
        .navbar-toggler {
            border: 1px solid var(--border-color);
            color: var(--text-gray);
            padding: 6px 10px;
            background: #1c2128;
            border-radius: 8px;
        }
        .navbar-toggler:focus { box-shadow: none; }
        .navbar-toggler-icon { filter: invert(1); }

        .mobile-search-wrapper {
            padding: 10px 0 4px;
            display: none;
        }
        .mobile-search-wrapper .search-bar { max-width: 100%; }

        /* ── HERO ── */
        .hero-section {
            padding: clamp(40px, 8vw, 90px) 5%;
        }
        .hero-tagline {
            color: var(--accent-blue);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.72rem;
            letter-spacing: 2.5px;
        }
        .hero-title {
            font-size: clamp(2.2rem, 6vw, 4.5rem);
            font-weight: 800;
            line-height: 1.08;
        }
        .hero-desc { color: var(--text-gray); max-width: 460px; line-height: 1.7; }
        .btn-blue {
            background: var(--accent-blue);
            border: none;
            padding: 12px 24px;
            font-weight: 700;
            font-size: 0.88rem;
            color: white;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s;
            white-space: nowrap;
        }
        .btn-blue:hover { background: #0066dd; }
        .btn-outline {
            background: transparent;
            border: 1px solid var(--border-color);
            color: white;
            padding: 12px 24px;
            font-weight: 600;
            font-size: 0.88rem;
            border-radius: 8px;
            cursor: pointer;
            transition: border-color 0.2s;
            white-space: nowrap;
        }
        .btn-outline:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
        .hero-img-wrapper { text-align: center; }
        .hero-img-wrapper img {
            max-height: 460px;
            width: 100%;
            object-fit: contain;
            filter: drop-shadow(0 20px 60px rgba(0,123,255,0.18));
        }

        /* ── FEATURES ── */
        .section-wrap { padding: clamp(30px, 5vw, 60px) 5%; }
        .feature-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: clamp(20px, 3vw, 30px);
            border-radius: 12px;
            height: 100%;
            transition: border-color 0.2s;
        }
        .feature-card:hover { border-color: var(--accent-blue); }
        .feature-icon {
            width: 44px;
            height: 44px;
            background: rgba(0,123,255,0.12);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
            font-size: 1.1rem;
            margin-bottom: 18px;
            flex-shrink: 0;
        }

        /* ── SALE BANNER ── */
        .sale-banner {
            background: linear-gradient(120deg, #0051d5 0%, #00a2ff 100%);
            border-radius: 16px;
            padding: clamp(28px, 5vw, 50px) clamp(24px, 5vw, 50px);
            margin: 20px 5% 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
            flex-wrap: wrap;
        }
        .sale-left { flex: 1; min-width: 200px; }
        .sale-right { text-align: center; flex-shrink: 0; }
        .sale-title { font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 800; margin: 10px 0 4px; line-height: 1.1; }
        .sale-discount { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; }
        .btn-white {
            background: white;
            color: var(--accent-blue);
            font-weight: 700;
            border: none;
            padding: 10px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            margin-top: 8px;
            transition: opacity 0.2s;
        }
        .btn-white:hover { opacity: 0.9; }

        /* ── PRODUCTS ── */
        .product-img-box {
            background: #161b22;
            border-radius: 12px;
            padding: clamp(18px, 3vw, 30px);
            margin-bottom: 14px;
            position: relative;
            transition: transform 0.3s, box-shadow 0.3s;
            aspect-ratio: 1 / 1;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        .product-img-box:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(0,123,255,0.12); }
        .product-img-box img { max-height: 100%; max-width: 100%; object-fit: contain; }
        .badge-sale {
            position: absolute;
            top: 12px;
            left: 12px;
            background: var(--accent-blue);
            font-size: 0.62rem;
            padding: 4px 10px;
            border-radius: 4px;
            font-weight: 700;
            letter-spacing: 0.04em;
        }
        .product-name { font-weight: 700; font-size: 0.95rem; margin-bottom: 2px; }
        .product-sub { font-size: 0.78rem; color: var(--text-gray); margin-bottom: 6px; }
        .price-current { font-weight: 700; font-size: 0.95rem; }
        .price-old { font-size: 0.78rem; text-decoration: line-through; color: var(--text-gray); margin-left: 6px; }

        /* ── FOOTER ── */
        footer {
            border-top: 1px solid var(--border-color);
            padding: clamp(40px, 6vw, 60px) 5% 28px;
            margin-top: 40px;
        }
        .footer-link-list { list-style: none; padding: 0; color: var(--text-gray); font-size: 0.84rem; }
        .footer-link-list li { margin-bottom: 10px; cursor: pointer; transition: color 0.15s; }
        .footer-link-list li:hover { color: white; }
        .footer-newsletter-input {
            background: #1c2128;
            border: 1px solid var(--border-color);
            color: white;
            font-size: 0.82rem;
            padding: 9px 14px;
        }
        .footer-newsletter-input:focus { border-color: var(--accent-blue); outline: none; box-shadow: none; background: #1c2128; color: white; }
        .footer-newsletter-input::placeholder { color: var(--text-gray); }
        .footer-bottom { font-size: 0.72rem; }

        /* ═══════════════════════════════════
           RESPONSIVE BREAKPOINTS
        ═══════════════════════════════════ */

        /* Medium screens */
        @media (max-width: 991px) {
            .mobile-search-wrapper { display: block; }
            /* hide desktop search inside collapse */
            .desktop-search { display: none !important; }

            .sale-banner { flex-direction: column; text-align: center; }
            .sale-right { width: 100%; }
        }

        /* Tablet */
        @media (max-width: 767px) {
            .hero-desc { max-width: 100%; }
            .hero-img-wrapper img { max-height: 320px; margin-top: 30px; }
            .hero-btns { flex-wrap: wrap; }
        }

        /* Small phones */
        @media (max-width: 575px) {
            .navbar { padding: 12px 16px; }
            .section-wrap { padding: 28px 16px; }
            footer { padding: 36px 16px 24px; }
            .sale-banner { margin: 16px 16px 32px; border-radius: 12px; }

            .hero-btns { gap: 10px !important; }
            .btn-blue, .btn-outline { width: 100%; text-align: center; }
        }

        /* Very small */
        @media (max-width: 360px) {
            .navbar-brand { font-size: 0.85rem; }
            .hero-title { font-size: 2rem; }
        }
    </style>
</head>
<body>

    <!-- ── NAVBAR ── -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container-fluid px-0">

            <a class="navbar-brand text-white" href="#">
