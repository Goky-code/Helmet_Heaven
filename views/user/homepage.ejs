                <input type="text" class="search-bar" placeholder="Search premium helmets...">
                <div class="nav-icons">
                   <a href="/user/cart" class="position-relative d-inline-block">
  <i class="bi bi-cart3 fs-5"></i>

  <span
    id="cartCount"
    style="
      position:absolute;
      top:-8px;
