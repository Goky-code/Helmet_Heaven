<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Helmet Haven - Profile Information</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
  <style>
    :root {
      --bg-main:           #0d1117;
      --bg-sidebar:        #0d1117;
      --bg-card:           #161b22;
      --bg-input:          #0d1117;
      --border-color:      #2a3240;
      --text-primary:      #e6edf3;
      --text-muted:        #8b949e;
      --accent-blue:       #1f6feb;
      --accent-blue-hover: #388bfd;
      --sidebar-active-bg: #161b22;
      --danger-color:      #f85149;
      --success-color:     #3fb950;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-main);
      color: var(--text-primary);
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 14px;
      min-height: 100vh;
      display: flex; flex-direction: column;
    }

    /* ── NAVBAR ── */
    .navbar-custom {
      background-color: #0d1117;
      border-bottom: 1px solid var(--border-color);
      padding: 10px 16px;
      position: sticky; top: 0; z-index: 1000;
    }
    .navbar-inner {
      display: flex; align-items: center;
      justify-content: space-between; gap: 12px; flex-wrap: wrap;
    }
    .navbar-left { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
    .navbar-brand-text {
      font-weight: 700; font-size: 18px; color: var(--text-primary) !important;
      display: flex; align-items: center; gap: 8px;
      text-decoration: none; white-space: nowrap;
    }
    .navbar-brand-text i { color: var(--accent-blue); font-size: 20px; }
    .nav-links { display: flex; gap: 2px; }
    .nav-link-custom {
      color: var(--text-primary) !important; font-size: 14px;
      padding: 6px 10px !important; text-decoration: none; white-space: nowrap;
    }
    .nav-link-custom:hover { color: var(--accent-blue) !important; }
    .search-input {
      background-color: #161b22; border: 1px solid var(--border-color);
      color: var(--text-muted); border-radius: 6px;
      padding: 6px 14px 6px 36px; font-size: 13px;
      width: 100%; max-width: 320px; min-width: 120px; outline: none;
    }
    .search-input:focus { border-color: var(--accent-blue); }
    .search-input::placeholder { color: var(--text-muted); }
    .search-wrapper { position: relative; flex: 1; max-width: 320px; }
    .search-wrapper i { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 14px; }

    .navbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

    /* ── NAV ICON BUTTON ── */
    .icon-btn {
      background: #161b22; border: 1px solid var(--border-color);
      color: var(--text-primary); border-radius: 8px;
      width: 38px; height: 38px;
      display: flex; align-items: center; justify-content: center;
      font-size: 17px; position: relative; cursor: pointer;
      text-decoration: none; flex-shrink: 0;
      transition: border-color .2s, color .2s;
    }
    .icon-btn:hover { border-color: var(--accent-blue); color: var(--accent-blue); }

    /* ── NAVBAR BADGE ── */
    .icon-btn .nbadge {
      position: absolute; top: -4px; right: -4px;
      background: var(--accent-blue); color: #fff;
      font-size: 9px; border-radius: 10px;
      padding: 1px 5px; font-weight: 700;
      border: 1px solid var(--bg-main);
      pointer-events: none;
    }

    .hamburger-btn {
      display: none; background: #161b22; border: 1px solid var(--border-color);
      color: var(--text-primary); border-radius: 8px;
      width: 38px; height: 38px; align-items: center; justify-content: center;
      font-size: 18px; cursor: pointer; flex-shrink: 0;
    }

    /* ── LAYOUT ── */
    .page-wrapper { display: flex; flex: 1; min-height: 0; }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 240px; min-width: 240px; background: var(--bg-sidebar);
      border-right: 1px solid var(--border-color);
      padding: 24px 0; transition: transform 0.3s ease;
    }
    .sidebar-heading {
      display: flex; align-items: center; gap: 10px;
      font-weight: 700; font-size: 15px; padding: 0 20px 20px;
      color: var(--text-primary);
    }
    .sidebar-heading i { color: var(--accent-blue); font-size: 18px; }
    .sidebar-item {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 20px; color: var(--text-primary);
      text-decoration: none; font-size: 14px; cursor: pointer;
      border-left: 3px solid transparent;
      transition: background .15s, color .15s; white-space: nowrap;
    }
    .sidebar-item:hover { background: var(--bg-card); color: var(--accent-blue); }
    .sidebar-item.active { background: var(--bg-card); color: var(--accent-blue); border-left-color: var(--accent-blue); }
    .sidebar-item i { font-size: 16px; width: 18px; text-align: center; }
    .sidebar-divider { border-top: 1px solid var(--border-color); margin: 12px 0; }
    .sidebar-item.logout { color: var(--danger-color); }
    .sidebar-item.logout:hover { background: rgba(248,81,73,0.08); color: var(--danger-color); }
    .sidebar-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.6); z-index: 900;
    }

    /* ── MAIN CONTENT ── */
    .main-content {
      flex: 1; padding: 32px 28px;
      background: var(--bg-main); overflow-x: hidden; min-width: 0;
    }
    .page-title { font-size: 22px; font-weight: 500; color: var(--text-primary); margin-bottom: 4px; }
    .page-subtitle { color: var(--text-muted); font-size: 13px; margin-bottom: 24px; }

    /* ── CARD ── */
    .profile-card {
      background: var(--bg-card); border: 1px solid var(--border-color);
      border-radius: 12px; padding: 28px 24px 24px;
    }

    /* ── FORM ── */
    .form-label-custom { color: var(--text-muted); font-size: 13px; margin-bottom: 6px; display: block; }
    .form-control-custom {
      background: var(--bg-input); border: 1px solid var(--border-color);
      border-radius: 8px; color: var(--text-primary);
      font-size: 14px; padding: 10px 14px; width: 100%; outline: none;
      transition: border-color 0.15s;
    }
    .form-control-custom:focus { border-color: var(--accent-blue); }
    .form-control-custom::placeholder { color: #3a4455; }

    /* ── EMAIL FIELD ── */
    .email-field-inner { display: flex; align-items: center; gap: 8px; }
    .email-field-inner .form-control-custom { flex: 1; }
    .btn-edit-email {
      background: transparent; border: 1px solid var(--border-color);
      color: var(--text-muted); border-radius: 7px; font-size: 12px;
      padding: 6px 12px; cursor: pointer; white-space: nowrap;
      display: flex; align-items: center; gap: 5px;
      transition: border-color 0.15s, color 0.15s; flex-shrink: 0;
    }
    .btn-edit-email:hover { border-color: var(--accent-blue); color: var(--accent-blue); }

    /* ── EMAIL DROPDOWN ── */
    .email-dropdown {
      display: none; background: #1c2333;
      border: 1px solid var(--border-color); border-radius: 10px;
      padding: 18px 16px 16px; margin-top: 8px; position: relative;
      animation: dropIn 0.2s ease;
    }
    .email-dropdown.open { display: block; }
    @keyframes dropIn {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .dropdown-arrow {
      position: absolute; top: -7px; left: 24px;
      width: 12px; height: 12px; background: #1c2333;
      border-left: 1px solid var(--border-color);
      border-top: 1px solid var(--border-color);
      transform: rotate(45deg);
    }
    .email-dropdown label { color: var(--text-muted); font-size: 12px; margin-bottom: 6px; display: block; font-weight: 500; }
    .email-dropdown input {
      background: var(--bg-input); border: 1px solid var(--border-color);
      border-radius: 7px; color: var(--text-primary); font-size: 13px;
      padding: 9px 12px; width: 100%; outline: none;
      transition: border-color 0.15s; font-family: inherit;
    }
    .email-dropdown input:focus { border-color: var(--accent-blue); }
    .email-dropdown input::placeholder { color: #3a4455; }
    .email-hint { font-size: 11px; color: var(--text-muted); margin-top: 6px; display: flex; align-items: center; gap: 5px; }
    .status-msg { font-size: 12px; margin-top: 8px; padding: 8px 12px; border-radius: 7px; display: none; }
    .status-msg.error   { background: rgba(248,81,73,0.12); color: var(--danger-color);  border: 1px solid rgba(248,81,73,0.3);  display: block; }
    .status-msg.success { background: rgba(63,185,80,0.12);  color: var(--success-color); border: 1px solid rgba(63,185,80,0.3);  display: block; }
    .dropdown-actions { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
    .btn-send-otp {
      background: var(--accent-blue); color: #fff; border: none;
      border-radius: 7px; font-size: 13px; font-weight: 700;
      padding: 9px 18px; cursor: pointer;
      display: flex; align-items: center; gap: 6px;
      transition: background 0.15s; flex: 1;
    }
    .btn-send-otp:hover { background: var(--accent-blue-hover); }
    .btn-send-otp:disabled { opacity: 0.55; cursor: not-allowed; }
    .btn-dropdown-cancel {
      background: transparent; border: 1px solid var(--border-color);
      color: var(--text-muted); border-radius: 7px;
      font-size: 13px; padding: 9px 14px; cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
    }
    .btn-dropdown-cancel:hover { border-color: var(--text-muted); color: var(--text-primary); }

    /* ── AVATAR ── */
    .avatar-wrapper { display: flex; flex-direction: column; align-items: center; gap: 10px; }
    .avatar-circle {
      width: 110px; height: 110px; border-radius: 50%;
      background: #1c2333; border: 2px solid var(--border-color);
      display: flex; align-items: center; justify-content: center; position: relative;
    }
    .avatar-circle i { font-size: 42px; color: var(--text-muted); }
    .avatar-edit-btn {
      position: absolute; bottom: 4px; right: 4px;
      background: var(--accent-blue); border: 2px solid var(--bg-card);
      color: #fff; border-radius: 50%; width: 28px; height: 28px;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; cursor: pointer;
    }
    .avatar-hint { font-size: 11px; color: var(--text-muted); text-align: center; }
    .btn-change-photo {
      background: transparent; border: 1px solid var(--border-color);
      color: var(--text-primary); border-radius: 8px; font-size: 13px;
      padding: 7px 18px; cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
    }
    .btn-change-photo:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
    .referral-row {
      display: flex; align-items: center; border-radius: 8px;
      overflow: hidden; border: 1px solid var(--border-color);
      width: 100%; max-width: 240px; margin-top: 10px;
    }
    .referral-code {
      background: #1c2333; color: var(--text-muted); font-size: 12px;
      padding: 8px 12px; letter-spacing: 0.04em; font-family: monospace;
      border-right: 1px solid var(--border-color); flex: 1;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .btn-copy {
      background: var(--accent-blue); color: #fff; border: none;
      font-size: 12px; font-weight: 600; padding: 8px 14px;
      cursor: pointer; letter-spacing: 0.04em;
      transition: background 0.15s; flex-shrink: 0;
    }
    .btn-copy:hover { background: var(--accent-blue-hover); }

    /* ── SAVE BUTTON ── */
    .btn-save {
      background: var(--accent-blue); color: #fff; border: none;
      border-radius: 8px; font-size: 14px; font-weight: 700;
      padding: 11px 28px; cursor: pointer; transition: background 0.15s;
    }
    .btn-save:hover { background: var(--accent-blue-hover); }

    /* ── MODALS ── */
    .edit-modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.72); z-index: 2000;
      align-items: center; justify-content: center;
      padding: 16px; backdrop-filter: blur(3px);
    }
    .edit-modal-overlay.open { display: flex; }
    .edit-modal {
      background: var(--bg-card); border: 1px solid var(--border-color);
      border-radius: 16px; padding: 32px 28px 28px;
      width: 100%; max-width: 520px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.6);
      position: relative; animation: modalIn 0.22s ease;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: translateY(18px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .edit-modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
    .edit-modal-title { font-size: 17px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 10px; }
    .edit-modal-title i { color: var(--accent-blue); }
    .modal-close-btn {
      background: #1c2333; border: 1px solid var(--border-color);
      color: var(--text-muted); border-radius: 8px;
      width: 32px; height: 32px;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; cursor: pointer;
      transition: border-color 0.15s, color 0.15s; flex-shrink: 0;
    }
    .modal-close-btn:hover { border-color: var(--danger-color); color: var(--danger-color); }
    .modal-label { color: var(--text-muted); font-size: 12.5px; margin-bottom: 6px; display: block; font-weight: 500; }
    .modal-input {
      background: var(--bg-input); border: 1px solid var(--border-color);
      border-radius: 8px; color: var(--text-primary); font-size: 14px;
      padding: 10px 14px; width: 100%; outline: none;
      transition: border-color 0.15s; font-family: inherit;
    }
    .modal-input:focus { border-color: var(--accent-blue); }
    .modal-input::placeholder { color: #3a4455; }
    .modal-footer-row { display: flex; align-items: center; gap: 10px; margin-top: 28px; flex-wrap: wrap; }
    .modal-btn-save {
      background: var(--accent-blue); color: #fff; border: none;
      border-radius: 8px; font-size: 14px; font-weight: 700;
      padding: 11px 28px; cursor: pointer; transition: background 0.15s; flex: 1;
    }
    .modal-btn-save:hover { background: var(--accent-blue-hover); }
    .modal-btn-cancel {
      background: transparent; border: 1px solid var(--border-color);
      color: var(--text-muted); border-radius: 8px; font-size: 14px;
      padding: 11px 20px; cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
    }
    .modal-btn-cancel:hover { border-color: var(--text-muted); color: var(--text-primary); }

    /* ── FOOTER ── */
    footer {
      background: var(--bg-main); border-top: 1px solid var(--border-color);
      padding: 36px 20px 20px;
    }
    .footer-brand { font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .footer-brand i { color: var(--accent-blue); }
    .footer-desc { color: var(--text-muted); font-size: 12.5px; max-width: 220px; line-height: 1.6; }
    .footer-heading { font-size: 13px; font-weight: 600; color: var(--text-primary); margin-bottom: 14px; }
    .footer-link { display: block; color: var(--text-muted); text-decoration: none; font-size: 12.5px; margin-bottom: 8px; transition: color 0.15s; }
    .footer-link:hover { color: var(--accent-blue); }
    .footer-input {
      background: var(--bg-input); border: 1px solid var(--border-color);
      border-radius: 6px 0 0 6px; color: var(--text-primary);
      font-size: 13px; padding: 8px 12px; outline: none; flex: 1; min-width: 0;
    }
    .footer-input:focus { border-color: var(--accent-blue); }
    .footer-input::placeholder { color: var(--text-muted); }
    .btn-join {
      background: var(--accent-blue); color: #fff; border: none;
      border-radius: 0 6px 6px 0; padding: 8px 16px;
      font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap;
    }
    .btn-join:hover { background: var(--accent-blue-hover); }
    .footer-newsletter-row { display: flex; width: 100%; max-width: 280px; }
    .footer-bottom {
      border-top: 1px solid var(--border-color); margin-top: 30px; padding-top: 16px;
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 8px;
    }
    .footer-bottom-text { color: var(--text-muted); font-size: 12px; }
    .footer-bottom-link { color: var(--text-muted); font-size: 12px; text-decoration: none; }
    .footer-bottom-link:hover { color: var(--text-primary); }

    .field-error {
  color: var(--danger-color);
  font-size: 12px;
  margin-top: 5px;
  min-height: 14px;
}

    /* ── RESPONSIVE ── */
    @media (max-width: 992px) {
      .sidebar { width: 200px; min-width: 200px; }
      .sidebar-item { font-size: 13px; padding: 10px 14px; gap: 10px; }
      .main-content { padding: 24px 20px; }
    }
    @media (max-width: 768px) {
      .hamburger-btn { display: flex; }
      .nav-links { display: none; }
      .sidebar {
        position: fixed; top: 0; left: 0; height: 100%; z-index: 950;
        transform: translateX(-100%); width: 240px; min-width: 240px; padding-top: 60px;
      }
      .sidebar.open { transform: translateX(0); }
      .sidebar-overlay.open { display: block; }
      .main-content { padding: 20px 16px; }
      .profile-card { padding: 20px 16px; }
      .referral-row { max-width: 100%; }
    }
    @media (max-width: 480px) {
      .navbar-brand-text { font-size: 16px; }
      .search-wrapper { display: none; }
      .page-title { font-size: 18px; }
      .btn-save { padding: 10px 20px; font-size: 13px; }
      .footer-desc { max-width: 100%; }
      .footer-bottom { flex-direction: column; align-items: flex-start; }
      .edit-modal { padding: 24px 16px 20px; }
    }
    @media (max-width: 360px) {
      .main-content { padding: 16px 12px; }
      .profile-card { padding: 16px 12px; }
      .navbar-custom { padding: 8px 12px; }
    }
  </style>
</head>
<body>

<%
 
  const _cartCount     = typeof cartCount     !== 'undefined' ? cartCount     : 0;
  const _wishlistCount = typeof wishlistCount !== 'undefined' ? wishlistCount : 0;
%>

<!-- Sidebar overlay -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- ── CROP MODAL ── -->
<div class="edit-modal-overlay" id="cropModalOverlay">
  <div class="edit-modal" style="max-width:500px;">
    <div class="edit-modal-header">
      <div class="edit-modal-title"><i class="bi bi-crop"></i> Crop Profile Picture</div>
      <button class="modal-close-btn" onclick="closeCropModal()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div style="margin-bottom:4px;">
      <img id="imageToCrop" style="max-width:100%; display:block;">
    </div>
    <div class="modal-footer-row" style="margin-top:16px;">
      <button type="button" class="modal-btn-cancel" onclick="closeCropModal()">Cancel</button>
      <button type="button" class="modal-btn-save" id="btnCropSave"><i class="bi bi-check-lg me-1"></i>Save Photo</button>
    </div>
  </div>
</div>

<!-- ── EDIT PROFILE MODAL ── -->
<!-- ── EDIT PROFILE MODAL ── -->
<div class="edit-modal-overlay" id="editModalOverlay">
  <div class="edit-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="edit-modal-header">
      <div class="edit-modal-title" id="modalTitle">
        <i class="bi bi-pencil-square"></i> Edit Profile
      </div>
      <button class="modal-close-btn" onclick="closeEditModal()" aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    <form id="editProfileForm" novalidate>
      <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6">
          <label class="modal-label" for="modal-firstname">First Name</label>
          <input type="text" id="modal-firstname" name="firstname" class="modal-input"
                 value="<%= user.firstName %>" placeholder="First name" maxlength="30">
          <div class="field-error" id="firstnameError"></div>
        </div>
        <div class="col-12 col-sm-6">
          <label class="modal-label" for="modal-lastname">Last Name</label>
          <input type="text" id="modal-lastname" name="lastname" class="modal-input"
                 value="<%= user.lastName %>" placeholder="Last name" maxlength="30">
          <div class="field-error" id="lastnameError"></div>
        </div>
      </div>
      <div class="mb-3">
        <label class="modal-label" for="modal-phone">Phone Number</label>
        <input type="tel" id="modal-phone" name="phone" class="modal-input"
               value="<%= user.phone || '' %>" placeholder="Phone number"
               inputmode="numeric" maxlength="10">
        <div class="field-error" id="phoneError"></div>
      </div>
      <div class="status-msg" id="editProfileStatus"></div>
      <div class="modal-footer-row">
        <button type="button" class="modal-btn-cancel" onclick="closeEditModal()"><i class="bi bi-x me-1"></i>Cancel</button>
        <button type="submit" class="modal-btn-save" id="btnSaveProfile"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
      </div>
    </form>
  </div>
</div>
<!-- ── NAVBAR ── -->
<nav class="navbar-custom">
  <div class="navbar-inner">

    <div class="navbar-left">
      <button class="hamburger-btn" id="hamburgerBtn" onclick="toggleSidebar()" aria-label="Menu">
        <i class="bi bi-list"></i>
      </button>
      <a class="navbar-brand-text" href="/user/homepage">
        <i class="bi bi-shield-fill"></i> Helmet Haven
      </a>
      <div class="nav-links">
        <a href="/user/homepage" class="nav-link-custom">Home</a>
        <a href="#" class="nav-link-custom">About Us</a>
        <a href="#" class="nav-link-custom">Contact Us</a>
      </div>
    </div>

    <div class="search-wrapper">
      <i class="bi bi-search"></i>
      <input type="text" class="search-input" placeholder="Search premium helmets..."/>
