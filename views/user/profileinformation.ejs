<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script>
  /* ── Sidebar ── */
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('open');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sidebarOverlay').classList.remove('open');
  }

  /* ── Edit Profile Modal ── */
  function openEditModal() {
    document.getElementById('editModalOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeEditModal() {
    document.getElementById('editModalOverlay').classList.remove('open');
    document.body.style.overflow = '';
  }
  document.getElementById('editModalOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeEditModal();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { closeEditModal(); closeEmailDropdown(); }
  });

  /* ── Referral Copy ── */
  function copyReferral() {
    navigator.clipboard.writeText('X9-WANGER-HEAVEN').then(() => {
      const btn = document.getElementById('copyBtn');
      btn.textContent = 'COPIED!';
      btn.style.background = 'var(--success-color)';
      setTimeout(() => { btn.textContent = 'COPY'; btn.style.background = ''; }, 2000);
    });
  }

  /* ── Email Dropdown ── */
  function toggleEmailDropdown() {
    const dd = document.getElementById('emailDropdown');
    if (dd.classList.contains('open')) {
      closeEmailDropdown();
    } else {
      dd.classList.add('open');
      setTimeout(() => document.getElementById('newEmailInput').focus(), 50);
    }
  }
  function closeEmailDropdown() {
    document.getElementById('emailDropdown').classList.remove('open');
    document.getElementById('newEmailInput').value = '';
    document.getElementById('sendStatus').className = 'status-msg';
    document.getElementById('sendStatus').textContent = '';
    const btn = document.getElementById('btnSendOtp');
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-send"></i> Send OTP';
  }
  function sendOtp() {
    const emailVal = document.getElementById('newEmailInput').value.trim();
    const statusEl = document.getElementById('sendStatus');
    const sendBtn  = document.getElementById('btnSendOtp');
    if (!emailVal) {
      statusEl.className = 'status-msg error';
      statusEl.textContent = 'Please enter a new email address.';
      document.getElementById('newEmailInput').focus(); return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
      statusEl.className = 'status-msg error';
      statusEl.textContent = 'Please enter a valid email address.';
      document.getElementById('newEmailInput').focus(); return;
    }
    sendBtn.disabled = true;
    sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Sending...';
    statusEl.className = 'status-msg';
    statusEl.textContent = '';
    fetch('/user/send-email-otp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ newEmail: emailVal })
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        statusEl.className = 'status-msg success';
        statusEl.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>OTP sent! Redirecting…';
        setTimeout(() => { window.location.href = '/user/editEmailotp'; }, 900);
      } else {
        sendBtn.disabled = false;
        sendBtn.innerHTML = '<i class="bi bi-send"></i> Send OTP';
        statusEl.className = 'status-msg error';
        statusEl.textContent = data.message || 'Failed to send OTP. Please try again.';
      }
    })
    .catch(() => {
      sendBtn.disabled = false;
      sendBtn.innerHTML = '<i class="bi bi-send"></i> Send OTP';
      statusEl.className = 'status-msg error';
      statusEl.textContent = 'Network error. Please try again.';
    });
  }
  document.addEventListener('click', function(e) {
    const dd  = document.getElementById('emailDropdown');
    const btn = document.getElementById('editEmailBtn');
    if (dd.classList.contains('open') && !dd.contains(e.target) && !btn.contains(e.target)) {
      closeEmailDropdown();
    }
  });

  /* ── Crop Modal ── */
  let cropper;
  const fileInput   = document.getElementById('fileInput');
  const cropOverlay = document.getElementById('cropModalOverlay');
  const imageToCrop = document.getElementById('imageToCrop');
  const btnCropSave = document.getElementById('btnCropSave');

  fileInput.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    if (!['image/jpeg', 'image/jpg'].includes(file.type)) {
      alert('Only JPEG/JPG images are allowed.');
      fileInput.value = ''; return;
    }
    const reader = new FileReader();
    reader.onload = (ev) => {
      imageToCrop.src = ev.target.result;
      cropOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
      if (cropper) cropper.destroy();
      cropper = new Cropper(imageToCrop, { aspectRatio: 1, viewMode: 1 });
    };
    reader.readAsDataURL(file);
  });

  btnCropSave.addEventListener('click', () => {
    cropper.getCroppedCanvas().toBlob((blob) => {
      const formData = new FormData();
      formData.append('profileImage', blob, 'profile.jpg');
      fetch('/user/profile', { method: 'POST', body: formData })
        .then(r => r.json())
        .then(data => {
          if (data.success) window.location.reload();
          else alert(data.message || 'Upload failed.');
        })
        .catch(err => console.error(err));
    }, 'image/jpeg', 0.9);
  });

  function closeCropModal() {
    cropOverlay.classList.remove('open');
    document.body.style.overflow = '';
    if (cropper) { cropper.destroy(); cropper = null; }
    fileInput.value = '';
  }
/* ── Edit Profile Form Validation & Submit ── */
const nameRegex  = /^[A-Za-z\s]+$/;   // letters + spaces only
const phoneRegex = /^[0-9]{10}$/;     // exactly 10 digits

const fnameInput = document.getElementById('modal-firstname');
const lnameInput = document.getElementById('modal-lastname');
const phoneInput = document.getElementById('modal-phone');

// Block invalid characters as the user types
fnameInput.addEventListener('input', () => {
  fnameInput.value = fnameInput.value.replace(/[^A-Za-z\s]/g, '');
});
lnameInput.addEventListener('input', () => {
  lnameInput.value = lnameInput.value.replace(/[^A-Za-z\s]/g, '');
});
phoneInput.addEventListener('input', () => {
  phoneInput.value = phoneInput.value.replace(/[^0-9]/g, '').slice(0, 10);
});

function validateEditProfileForm() {
  let isValid = true;
  const firstnameErr = document.getElementById('firstnameError');
  const lastnameErr  = document.getElementById('lastnameError');
  const phoneErr     = document.getElementById('phoneError');
  firstnameErr.textContent = '';
  lastnameErr.textContent  = '';
  phoneErr.textContent     = '';

  const firstname = fnameInput.value.trim();
  const lastname  = lnameInput.value.trim();
  const phone     = phoneInput.value.trim();

  if (!firstname) {
    firstnameErr.textContent = 'First name is required.';
    isValid = false;
  } else if (!nameRegex.test(firstname)) {
    firstnameErr.textContent = 'First name can only contain alphabets.';
    isValid = false;
  }

  if (!lastname) {
    lastnameErr.textContent = 'Last name is required.';
    isValid = false;
  } else if (!nameRegex.test(lastname)) {
    lastnameErr.textContent = 'Last name can only contain alphabets.';
    isValid = false;
  }

  if (phone && !phoneRegex.test(phone)) {
    phoneErr.textContent = 'Phone number must be exactly 10 digits.';
    isValid = false;
  }

  return isValid;
}

document.getElementById('editProfileForm').addEventListener('submit', function (e) {
  e.preventDefault();
  if (!validateEditProfileForm()) return;

  const statusEl = document.getElementById('editProfileStatus');
  const saveBtn  = document.getElementById('btnSaveProfile');
  statusEl.className = 'status-msg';
  statusEl.textContent = '';
  saveBtn.disabled = true;
  saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

  fetch('/user/profile', { method: 'POST', body: new FormData(this) })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        window.location.reload();
      } else {
        statusEl.className = 'status-msg error';
        statusEl.textContent = data.message || 'Failed to update profile.';
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Save Changes';
      }
    })
    .catch(() => {
      statusEl.className = 'status-msg error';
      statusEl.textContent = 'Network error. Please try again.';
      saveBtn.disabled = false;
      saveBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Save Changes';
    });
});

</script>
</body>
</html>