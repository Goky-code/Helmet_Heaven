 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up | Helmet Haven</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --bg-dark: #070b11;
            --card-bg: #111821;
            --accent-blue: #007bff;
            --text-muted-c: #8b949e;
            --border-color: #21262d;
            --error-color: #f85149;
            --success-color: #3fb950;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--bg-dark);
            color: white;
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── TOP NAV ── */
        .top-nav {
            padding: 16px 5%;
            font-weight: 800;
            font-size: 1rem;
            color: white;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        /* ── MAIN ── */
        .main-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(20px, 5vw, 52px) 5%;
        }

        /* ── INFO (LEFT) ── */
        .info-section { padding-right: clamp(20px, 4vw, 52px); }

        .tagline {
            color: var(--accent-blue);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
        }
        .main-title {
            font-size: clamp(2rem, 3.5vw, 3.8rem);
            font-weight: 800;
            line-height: 1.1;
            margin: 14px 0 18px;
        }
        .benefit-item {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
            color: #c9d1d9;
            font-size: 0.88rem;
        }
        .benefit-icon {
            width: 40px; height: 40px; min-width: 40px;
            background: rgba(0,123,255,0.1);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: var(--accent-blue);
        }

        /* ── CARD ── */
        .signup-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: clamp(22px, 4vw, 40px);
            width: 100%;
            max-width: 520px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.45);
        }

        /* ── FORM ── */
        .form-label {
            font-size: 0.82rem;
            font-weight: 600;
            color: #c9d1d9;
            margin-bottom: 6px;
        }
        .form-control {
            background: #0d1117;
            border: 1px solid var(--border-color);
            color: white;
            padding: 11px 14px;
            border-radius: 8px;
            font-size: 0.87rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .form-control:focus {
            background: #0d1117;
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(0,123,255,0.12);
            color: white;
        }
        .form-control::placeholder { color: #3a4455; }

        /* Validation states */
        .form-control.is-invalid {
            border-color: var(--error-color) !important;
            background-image: none;
        }
        .form-control.is-valid {
            border-color: var(--success-color) !important;
            background-image: none;
        }
        .field-error {
            font-size: 0.7rem;
            color: var(--error-color);
            margin-top: 4px;
            display: none;
        }
        .field-error.show { display: block; }

        /* Password strength bar */
        .strength-bar-wrap {
            height: 4px;
            background: var(--border-color);
            border-radius: 4px;
            margin-top: 8px;
            overflow: hidden;
        }
        .strength-bar {
            height: 100%;
            width: 0%;
            border-radius: 4px;
            transition: width 0.3s, background 0.3s;
        }
        .strength-label {
            font-size: 0.65rem;
            margin-top: 4px;
            color: var(--text-muted-c);
        }

        /* Buttons */
        .btn-create {
            background: var(--accent-blue);
            border: none;
            padding: 13px;
            font-weight: 700;
            border-radius: 10px;
            font-size: 0.9rem;
            margin-top: 14px;
            width: 100%;
            color: white;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-create:hover { background: #0062cc; }

        .btn-google {
            background: transparent;
            border: 1px solid var(--border-color);
            color: white;
            padding: 11px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.87rem;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: border-color 0.2s;
        }
        .btn-google:hover { border-color: var(--accent-blue); }

        /* Divider */
        .divider {
            display: flex;
            align-items: center;
            margin: 20px 0;
            color: #586069;
            font-size: 0.66rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid var(--border-color);
        }
        .divider:not(:empty)::before { margin-right: 1.2em; }
        .divider:not(:empty)::after  { margin-left: 1.2em; }

        /* Checkbox */
        .form-check-input {
            background-color: #0d1117;
            border-color: var(--border-color);
            flex-shrink: 0;
        }
        .form-check-input:checked { background-color: var(--accent-blue); border-color: var(--accent-blue); }
        .form-check-input:focus { box-shadow: none; }

        /* Server-side alert */
        .server-alert {
            background: rgba(248,81,73,0.12);
            border: 1px solid var(--error-color);
            color: #f85149;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.82rem;
            margin-bottom: 16px;
        }

        /* ── FOOTER ── */
        .footer-bar {
            padding: 18px 5%;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.74rem;
            color: #586069;
            flex-wrap: wrap;
            gap: 8px;
            flex-shrink: 0;
        }
        .footer-links { display: flex; flex-wrap: wrap; gap: 4px 14px; }
        .footer-links a { color: #586069; text-decoration: none; }
        .footer-links a:hover { color: white; }

        /* ══════════════════════════════
           RESPONSIVE
        ══════════════════════════════ */
        @media (max-width: 991px) {
            .info-col { display: none; }
            .card-col { display: flex; justify-content: center; }
            .signup-card { max-width: 520px; }
        }

        @media (max-width: 575px) {
            .main-wrapper { padding: 18px 14px; }
            .signup-card { border-radius: 14px; }
            /* Stack name fields on small phones */
            .name-col { width: 100% !important; flex: 0 0 100% !important; max-width: 100% !important; }
            .footer-bar { flex-direction: column; align-items: flex-start; }
        }

        @media (max-width: 360px) {
            .top-nav { padding: 12px 14px; font-size: 0.88rem; }
            .signup-card { padding: 18px 12px; }
        }
    </style>
</head>
<body>

    <header class="top-nav">
        <i class="bi bi-shield-shaded text-primary"></i> HELMET HAVEN
    </header>

    <main class="main-wrapper">
        <div class="container-fluid px-0">
            <div class="row align-items-center justify-content-center g-0">

                <!-- LEFT: Info panel -->
                <div class="col-lg-6 info-col">
                    <div class="info-section">
                        <span class="tagline">Join the Elite</span>
                        <h1 class="main-title">Gear Up for<br>Your Next Ride</h1>
                        <p style="color:var(--text-muted-c); font-size:0.87rem; max-width:400px; line-height:1.75; margin-bottom:32px;">
                            Create an account to access exclusive releases, personalized safety recommendations, and a seamless checkout experience.
                        </p>
                        <div class="benefit-item">
                            <div class="benefit-icon"><i class="bi bi-patch-check"></i></div>
                            <span>Verified Safety Standards</span>
                        </div>
                        <div class="benefit-item">
                            <div class="benefit-icon"><i class="bi bi-truck"></i></div>
                            <span>Priority Shipping on All Orders</span>
                        </div>
                        <div class="benefit-item">
                            <div class="benefit-icon"><i class="bi bi-gift"></i></div>
                            <span>Early Access to New Collections</span>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: Form card -->
                <div class="col-12 col-lg-6 card-col">
                    <div class="signup-card">

                        <h2 class="fw-bold mb-1" style="font-size:clamp(1.25rem,3vw,1.65rem);">Create Account</h2>
                        <p style="color:var(--text-muted-c); font-size:0.81rem; margin-bottom:20px;">
                            Enter your details to create your Helmet Haven profile.
                        </p>

                        <form id="signupForm" action="/auth/signup" method="POST" novalidate>

                            <!-- Server error (EJS) -->
                            <% if (typeof message !== 'undefined') { %>
                                <div class="server-alert">
                                    <i class="bi bi-exclamation-circle me-2"></i><%= message %>
                                </div>
                            <% } %>

                            <!-- Name row -->
                            <div class="row g-3 mb-3">
                                <div class="col-sm-6 name-col">
                                    <label class="form-label" for="firstname">First Name</label>
                                    <input type="text" id="firstname" name="firstname" class="form-control"
                                        placeholder="John"
                                        value="<%= typeof firstname !== 'undefined' ? firstname : '' %>"
                                        autocomplete="given-name">
                                    <div class="field-error" id="err-firstname">Please enter your first name.</div>
                                </div>
                                <div class="col-sm-6 name-col">
                                    <label class="form-label" for="lastname">Last Name</label>
                                    <input type="text" id="lastname" name="lastname" class="form-control"
                                        placeholder="Doe"
                                        value="<%= typeof lastname !== 'undefined' ? lastname : '' %>"
                                        autocomplete="family-name">
                                    <div class="field-error" id="err-lastname">Please enter your last name.</div>
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="mb-3">
                                <label class="form-label" for="email">Email Address</label>
                                <input type="email" id="email" name="email" class="form-control"
                                    placeholder="you@example.com"
                                    value="<%= typeof email !== 'undefined' ? email : '' %>"
                                    autocomplete="email">
                                <div class="field-error" id="err-email">Please enter a valid email address.</div>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <label class="form-label" for="password">Password</label>
                                <div class="position-relative">
                                    <input type="password" id="password" name="password"
                                        class="form-control pe-5"
                                        placeholder="Min. 8 characters with a symbol"
                                        autocomplete="new-password">
                                    <button type="button" id="togglePass"
                                        style="background:none;border:none;color:var(--text-muted-c);position:absolute;top:50%;right:12px;transform:translateY(-50%);padding:0;line-height:1;">
                                        <i class="bi bi-eye" id="passIcon"></i>
                                    </button>
                                </div>
                                <!-- Strength bar -->
                                <div class="strength-bar-wrap">
                                    <div class="strength-bar" id="strengthBar"></div>
                                </div>
                                <div class="strength-label" id="strengthLabel">Enter a password</div>
                                <div class="field-error" id="err-password">
                                    Must be at least 8 characters and include a symbol (!@#$%^&* etc).
                                </div>
                            </div>

                            <!-- Confirm Password -->
                            <div class="mb-3">
                                <label class="form-label" for="confirmpassword">Confirm Password</label>
                                <div class="position-relative">
                                    <input type="password" id="confirmpassword" name="confirmpassword"
                                        class="form-control pe-5"
                                        placeholder="Re-enter your password"
                                        autocomplete="new-password">
                                    <button type="button" id="toggleConfirm"
                                        style="background:none;border:none;color:var(--text-muted-c);position:absolute;top:50%;right:12px;transform:translateY(-50%);padding:0;line-height:1;">
                                        <i class="bi bi-eye" id="confirmIcon"></i>
                                    </button>
                                </div>
                                <div class="field-error" id="err-confirm">Passwords do not match.</div>
                            </div>

                            <!-- Referral Code -->
                            <div class="mb-3">
                                <label class="form-label" for="referalcode">
                                    Referral Code
                                    <span style="color:#586069; font-weight:400;">(Optional)</span>
                                </label>
                                <input type="text" id="referalcode" name="referalcode" class="form-control"
                                    placeholder="e.g. X9-HAVEN-2024"
                                    value="<%= typeof referalcode !== 'undefined' ? referalcode : '' %>">
                            </div>

                            <!-- Terms -->
                            <div class="form-check mb-2" style="font-size:0.79rem;">
                                <input class="form-check-input" type="checkbox" id="terms">
                                <label class="form-check-label" style="color:var(--text-muted-c);" for="terms">
                                    I agree to the
                                    <a href="#" class="text-primary text-decoration-none">Terms of Service</a>
                                    and
                                    <a href="#" class="text-primary text-decoration-none">Privacy Policy</a>.
                                </label>
                            </div>
                            <div class="field-error mb-2" id="err-terms">You must accept the terms to continue.</div>

                            <button type="submit" class="btn-create">Create Account</button>

                            <div class="divider">Or sign up with</div>

                            <button type="button" class="btn-google"
                                onclick="window.location.href='http://localhost:3000/auth/google'">
                                <i class="bi bi-google"></i> Continue with Google
                            </button>

                            <p class="text-center mt-4 mb-0" style="font-size:0.81rem; color:var(--text-muted-c);">
                                Already have an account?
                                <a href="/user/login" class="text-primary text-decoration-none fw-bold">Log In</a>
                            </p>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <footer class="footer-bar">
        <div>&copy; 2026 Helmet Haven. Professional grade protection for every rider.</div>
        <div class="footer-links">
            <a href="#">Privacy Policy</a>
            <a href="#">Safety Standards</a>
            <a href="#">Support</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        /* ── Helpers ── */
        const emailRx  = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        const symbolRx = /[^a-zA-Z0-9]/;

        function showErr(id, show) {
            const el = document.getElementById('err-' + id);
            if (el) el.classList.toggle('show', show);
        }
        function markField(id, valid) {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.toggle('is-valid',   valid);
            el.classList.toggle('is-invalid', !valid);
        }
        function setValid(id)   { markField(id, true);  showErr(id, false); }
        function setInvalid(id) { markField(id, false); showErr(id, true);  }

        /* ── Individual validators ── */
        function vFirstname() {
            const ok = !!document.getElementById('firstname').value.trim();
            ok ? setValid('firstname') : setInvalid('firstname');
            return ok;
        }
        function vLastname() {
            const ok = !!document.getElementById('lastname').value.trim();
            ok ? setValid('lastname') : setInvalid('lastname');
            return ok;
        }
        function vEmail() {
            const ok = emailRx.test(document.getElementById('email').value.trim());
            ok ? setValid('email') : setInvalid('email');
            return ok;
        }
        function vPassword() {
            const v  = document.getElementById('password').value;
            const ok = v.length >= 8 && symbolRx.test(v);
            ok ? setValid('password') : setInvalid('password');
            showErr('password', !ok);
            return ok;
        }
        function vConfirm() {
            const p  = document.getElementById('password').value;
            const c  = document.getElementById('confirmpassword').value;
            const ok = c.length > 0 && p === c;
            ok ? setValid('confirmpassword') : setInvalid('confirmpassword');
            showErr('confirm', !ok);
            return ok;
        }
        function vTerms() {
            const ok = document.getElementById('terms').checked;
            showErr('terms', !ok);
            return ok;
        }

        /* ── Password strength bar ── */
        document.getElementById('password').addEventListener('input', function () {
            const v = this.value;
            let score = 0;
            if (v.length >= 8)       score++;
            if (v.length >= 12)      score++;
            if (/[A-Z]/.test(v))     score++;
            if (/[0-9]/.test(v))     score++;
            if (symbolRx.test(v))    score++;

            const cfg = [
                { w: '0%',   bg: 'transparent', txt: 'Enter a password',            color: 'var(--text-muted-c)' },
                { w: '25%',  bg: '#f85149',      txt: 'Weak — add length & symbols', color: '#f85149' },
                { w: '50%',  bg: '#e3b341',      txt: 'Fair',                        color: '#e3b341' },
                { w: '75%',  bg: '#58a6ff',      txt: 'Good',                        color: '#58a6ff' },
                { w: '100%', bg: '#3fb950',      txt: 'Strong',                      color: '#3fb950' },
            ];
            const lvl = score === 0 ? cfg[0] : score <= 2 ? cfg[1] : score === 3 ? cfg[2] : score === 4 ? cfg[3] : cfg[4];

            const bar   = document.getElementById('strengthBar');
            const label = document.getElementById('strengthLabel');
            bar.style.width      = lvl.w;
            bar.style.background = lvl.bg;
            label.textContent    = lvl.txt;
            label.style.color    = lvl.color;

            if (v) vPassword(); else {
                const el = document.getElementById('password');
                el.classList.remove('is-valid','is-invalid');
                showErr('password', false);
            }
            if (document.getElementById('confirmpassword').value) vConfirm();
        });

        /* ── Blur listeners for live feedback ── */
        ['firstname','lastname','email','password','confirmpassword'].forEach(id => {
            const el = document.getElementById(id);
            const fn = { firstname: vFirstname, lastname: vLastname, email: vEmail, password: vPassword, confirmpassword: vConfirm }[id];
            el.addEventListener('blur', fn);
        });
        document.getElementById('confirmpassword').addEventListener('input', function () {
            if (this.value) vConfirm();
        });

        /* ── Show/hide password toggles ── */
        function makeToggle(btnId, inputId, iconId) {
            document.getElementById(btnId).addEventListener('click', function () {
                const inp  = document.getElementById(inputId);
                const icon = document.getElementById(iconId);
                const show = inp.type === 'password';
                inp.type       = show ? 'text' : 'password';
                icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        }
        makeToggle('togglePass',    'password',        'passIcon');
        makeToggle('toggleConfirm', 'confirmpassword', 'confirmIcon');

        /* ── Submit ── */
        document.getElementById('signupForm').addEventListener('submit', function (e) {
            const allOk = [vFirstname(), vLastname(), vEmail(), vPassword(), vConfirm(), vTerms()].every(Boolean);
            if (!allOk) {
                e.preventDefault();
                const first = this.querySelector('.is-invalid');
                if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    </script>
</body>
</html>      