<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Helmet Haven – Shopping Cart</title>
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:       #0d1117;
      --bg2:      #161b24;
      --bg3:      #1e2535;
      --border:   #2a3347;
      --accent:   #2d9cff;
      --accent2:  #0a78e8;
      --danger:   #ff4757;
      --success:  #2ecc71;
      --text:     #e8edf5;
      --muted:    #7a8ba3;
      --price:    #2d9cff;
      --radius:   12px;
      --shadow:   0 4px 24px rgba(0,0,0,.45);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg); color: var(--text);
      font-family: 'DM Sans', sans-serif; font-size: 15px;
      line-height: 1.6; min-height: 100vh;
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

    .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 20px; }

    /* ── NAVBAR ── */
    .navbar {
      position: sticky; top: 0; z-index: 100;
      background: rgba(13,17,23,.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .navbar-inner {
      display: flex; align-items: center; gap: 16px;
      padding: 14px 20px; max-width: 1200px; margin: 0 auto;
    }
    .brand {
      display: flex; align-items: center; gap: 8px;
      font-family: 'Rajdhani', sans-serif; font-size: 1.4rem; font-weight: 700;
      color: var(--text); text-decoration: none; flex-shrink: 0;
    }
    .brand-icon {
      width: 32px; height: 32px; background: var(--accent);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
    }
    .brand-icon svg { width: 18px; height: 18px; fill: #fff; }
    .nav-links { display: flex; gap: 24px; list-style: none; }
    .nav-links a { color: var(--muted); text-decoration: none; font-size: .9rem; transition: color .2s; }
    .nav-links a:hover { color: var(--text); }
    .search-wrap { flex: 1; max-width: 440px; position: relative; margin: 0 auto; }
    .search-wrap input {
      width: 100%; background: var(--bg3);
      border: 1px solid var(--border); border-radius: 8px;
      padding: 8px 16px 8px 38px;
      color: var(--text); font-size: .875rem; outline: none;
      transition: border-color .2s;
    }
    .search-wrap input::placeholder { color: var(--muted); }
    .search-wrap input:focus { border-color: var(--accent); }
    .search-wrap svg {
      position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
      width: 16px; height: 16px; stroke: var(--muted); pointer-events: none;
    }

    /* ── NAV ICONS ── */
    .nav-icons { display: flex; align-items: center; gap: 8px; margin-left: auto; }

    /* shared style for both <a> and <button> nav icon elements */
    .icon-btn {
      position: relative;
      background: none; border: none; cursor: pointer;
      padding: 8px; border-radius: 8px;
      color: var(--muted); text-decoration: none;
      display: flex; align-items: center; justify-content: center;
      transition: color .2s, background .2s;
    }
    .icon-btn:hover { color: var(--text); background: var(--bg3); }
    .icon-btn svg { width: 20px; height: 20px; }

    /* ── BADGE ── */
    .icon-btn .badge {
      position: absolute; top: 3px; right: 3px;
      background: var(--accent); color: #fff;
      font-size: .6rem; font-weight: 700;
      border-radius: 50%; width: 16px; height: 16px;
      display: flex; align-items: center; justify-content: center;
      pointer-events: none;
    }

    .hamburger {
      display: none; flex-direction: column; gap: 5px;
      background: none; border: none; cursor: pointer; padding: 6px;
    }
    .hamburger span {
      display: block; width: 22px; height: 2px;
      background: var(--muted); border-radius: 2px;
      transition: transform .3s, opacity .3s;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .mobile-menu {
      display: none; flex-direction: column;
      background: var(--bg2); border-bottom: 1px solid var(--border);
      padding: 16px 20px; gap: 12px;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a { color: var(--muted); text-decoration: none; font-size: .95rem; }
    .mobile-menu a:hover { color: var(--text); }

    /* ── BREADCRUMB ── */
    .breadcrumb {
      padding: 16px 0 4px; font-size: .8rem; color: var(--muted);
      display: flex; align-items: center; gap: 6px;
    }
    .breadcrumb a { color: var(--muted); text-decoration: none; }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb span { color: var(--text); font-weight: 500; }

    .page-title {
      font-family: 'Rajdhani', sans-serif;
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-weight: 700; padding: 12px 0 24px;
    }

    /* ── CART LAYOUT ── */
    .cart-layout { display: grid; grid-template-columns: 1fr 340px; gap: 28px; align-items: start; }

    /* ── CART ITEMS ── */
    .cart-items { display: flex; flex-direction: column; gap: 14px; }
    .cart-item {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 18px;
      display: grid; grid-template-columns: 90px 1fr auto;
      gap: 16px; align-items: center;
      transition: border-color .2s, box-shadow .2s;
      animation: fadeUp .35s ease both;
    }
    .cart-item:hover { border-color: #3a4a63; box-shadow: var(--shadow); }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .item-img { width: 90px; height: 90px; object-fit: contain; border-radius: 8px; background: var(--bg3); }
    .item-img-placeholder {
      width: 90px; height: 90px; border-radius: 8px; background: var(--bg3);
      display: flex; align-items: center; justify-content: center;
    }
    .item-info { display: flex; flex-direction: column; gap: 4px; }
    .item-name { font-family: 'Rajdhani', sans-serif; font-size: 1.1rem; font-weight: 600; }
    .item-meta { font-size: .82rem; color: var(--muted); }
    .item-meta strong { color: var(--text); }
    .item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; }
    .item-price { font-family: 'Rajdhani', sans-serif; font-size: 1.2rem; font-weight: 700; color: var(--price); }

    .qty-controls {
      display: flex; align-items: center;
      background: var(--bg3); border: 1px solid var(--border);
      border-radius: 8px; overflow: hidden;
    }
    .qty-btn {
      background: none; border: none; cursor: pointer;
      color: var(--muted); padding: 7px 12px;
      font-size: 1rem; font-weight: 700;
      transition: color .2s, background .2s; line-height: 1;
    }
    .qty-btn:hover:not(:disabled) { color: var(--text); background: var(--border); }
    .qty-btn:disabled { opacity: .35; cursor: not-allowed; }
    .qty-value {
      padding: 7px 14px; font-size: .9rem; font-weight: 600;
      min-width: 36px; text-align: center;
      border-left: 1px solid var(--border); border-right: 1px solid var(--border);
    }
    .remove-btn {
      background: none; border: none; cursor: pointer;
      color: var(--danger); font-size: .8rem; font-weight: 500;
      display: flex; align-items: center; gap: 5px;
      padding: 4px 0; transition: opacity .2s;
    }
    .remove-btn:hover { opacity: .75; }
    .remove-btn svg { width: 13px; height: 13px; }

    /* ── EMPTY CART ── */
    .empty-cart {
      text-align: center; padding: 60px 20px;
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    .empty-cart svg { width: 64px; height: 64px; stroke: var(--muted); margin-bottom: 16px; }
    .empty-cart h3 { font-family: 'Rajdhani', sans-serif; font-size: 1.4rem; margin-bottom: 8px; }
    .empty-cart p { color: var(--muted); font-size: .9rem; margin-bottom: 20px; }
    .btn-shop {
      background: var(--accent); color: #fff; border: none; border-radius: 8px;
      padding: 10px 28px; font-size: .9rem; font-weight: 600;
      cursor: pointer; transition: background .2s;
    }
    .btn-shop:hover { background: var(--accent2); }

    /* ── ORDER SUMMARY ── */
    .order-summary {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 24px;
      position: sticky; top: 80px;
    }
    .summary-title { font-family: 'Rajdhani', sans-serif; font-size: 1.25rem; font-weight: 700; margin-bottom: 20px; }
    .summary-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 0; font-size: .9rem;
    }
    .summary-row + .summary-row { border-top: 1px solid var(--border); }
    .summary-label { color: var(--muted); }
    .summary-value { font-weight: 500; }
    .summary-value.free { color: var(--success); font-weight: 600; }
    .summary-total { border-top: 2px solid var(--border) !important; margin-top: 4px; }
    .summary-total .summary-label { font-weight: 700; font-size: 1rem; color: var(--text); font-family: 'Rajdhani', sans-serif; }
    .summary-total .summary-value { font-family: 'Rajdhani', sans-serif; font-size: 1.5rem; font-weight: 700; color: var(--accent); }

    .promo-row { display: flex; gap: 8px; margin: 16px 0; }
    .promo-input {
      flex: 1; background: var(--bg3); border: 1px solid var(--border);
      border-radius: 8px; padding: 9px 12px; color: var(--text);
      font-size: .85rem; outline: none; transition: border-color .2s;
    }
    .promo-input::placeholder { color: var(--muted); }
    .promo-input:focus { border-color: var(--accent); }
    .promo-input.error { border-color: var(--danger); }
    .promo-btn {
      background: var(--bg3); border: 1px solid var(--border);
      color: var(--text); border-radius: 8px;
      padding: 9px 16px; font-size: .85rem; font-weight: 600;
      cursor: pointer; transition: border-color .2s, background .2s;
    }
    .promo-btn:hover { border-color: var(--accent); background: var(--bg); }
    .promo-feedback { font-size: .78rem; margin-top: 4px; min-height: 16px; }
    .promo-feedback.ok { color: var(--success); }
    .promo-feedback.err { color: var(--danger); }

    .checkout-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%; padding: 14px 20px; margin-top: 20px;
      background: var(--accent); color: #fff; border: none; border-radius: 10px;
      font-family: 'Rajdhani', sans-serif; font-size: 1.1rem; font-weight: 700;
      letter-spacing: .5px; cursor: pointer;
      transition: background .2s, transform .15s, box-shadow .2s;
      box-shadow: 0 4px 20px rgba(45,156,255,.3);
    }
    .checkout-btn:hover { background: var(--accent2); transform: translateY(-1px); box-shadow: 0 6px 24px rgba(45,156,255,.45); }
    .checkout-btn:active { transform: translateY(0); }
    .checkout-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }
    .checkout-btn svg { width: 18px; height: 18px; }
    .secure-note {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      font-size: .75rem; color: var(--muted); margin-top: 12px;
      text-transform: uppercase; letter-spacing: .08em;
    }
    .secure-note svg { width: 13px; height: 13px; stroke: var(--muted); }

    /* ── FOOTER ── */
    footer { margin-top: 64px; background: var(--bg2); border-top: 1px solid var(--border); padding: 48px 20px 28px; }
    .footer-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: 32px; }
    .footer-brand { display: flex; flex-direction: column; gap: 12px; }
    .footer-logo { display: flex; align-items: center; gap: 8px; font-family: 'Rajdhani', sans-serif; font-size: 1.2rem; font-weight: 700; }
    .footer-desc { color: var(--muted); font-size: .85rem; line-height: 1.7; }
    .footer-col h4 { font-family: 'Rajdhani', sans-serif; font-weight: 600; font-size: 1rem; margin-bottom: 14px; color: var(--text); }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .footer-col ul a { color: var(--muted); text-decoration: none; font-size: .875rem; transition: color .2s; }
    .footer-col ul a:hover { color: var(--accent); }
    .newsletter-row { display: flex; gap: 8px; margin-top: 4px; }
    .newsletter-input {
      flex: 1; background: var(--bg3); border: 1px solid var(--border);
      border-radius: 8px; padding: 9px 12px; color: var(--text);
      font-size: .85rem; outline: none; transition: border-color .2s;
    }
    .newsletter-input::placeholder { color: var(--muted); }
    .newsletter-input:focus { border-color: var(--accent); }
    .newsletter-input.error { border-color: var(--danger); }
    .newsletter-feedback { font-size: .75rem; margin-top: 4px; min-height: 14px; }
    .newsletter-feedback.ok { color: var(--success); }
    .newsletter-feedback.err { color: var(--danger); }
    .join-btn { background: var(--accent); color: #fff; border: none; border-radius: 8px; padding: 9px 18px; font-size: .85rem; font-weight: 600; cursor: pointer; transition: background .2s; }
    .join-btn:hover { background: var(--accent2); }
    .footer-bottom { max-width: 1200px; margin: 32px auto 0; border-top: 1px solid var(--border); padding-top: 20px; display: flex; justify-content: space-between; align-items: center; font-size: .78rem; color: var(--muted); flex-wrap: wrap; gap: 12px; }
    .footer-links { display: flex; gap: 20px; }
    .footer-links a { color: var(--muted); text-decoration: none; transition: color .2s; }
    .footer-links a:hover { color: var(--accent); }

    /* ── TOAST ── */
    .toast {
  position: fixed; bottom: 24px; right: 24px; z-index: 9999;
  background: var(--bg3); border: 1px solid var(--border);
  border-radius: 10px; padding: 16px 24px;
  font-size: 1.50rem; color: var(--text);
  box-shadow: 0 8px 32px rgba(0,0,0,.5);
  transform: translateY(80px); opacity: 0;
  transition: transform .3s, opacity .3s;
  max-width: 375px;
}
.toast.error {
  font-weight: 600;
  border-color: var(--danger);
}
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.success { border-color: var(--success); }
    

    /* ── RESPONSIVE ── */
    @media (max-width: 1024px) { .cart-layout { grid-template-columns: 1fr 300px; } .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; } }
    @media (max-width: 860px) { .cart-layout { grid-template-columns: 1fr; } .order-summary { position: static; } .nav-links { display: none; } .hamburger { display: flex; } .search-wrap { max-width: none; } .footer-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 600px) { .navbar-inner { gap: 10px; } .search-wrap { display: none; } .cart-item { grid-template-columns: 72px 1fr; gap: 12px; } .item-right { flex-direction: row; align-items: center; gap: 8px; grid-column: 1/-1; flex-wrap: wrap; justify-content: space-between; } .footer-grid { grid-template-columns: 1fr; } .footer-bottom { flex-direction: column; align-items: flex-start; } .item-img, .item-img-placeholder { width: 72px; height: 72px; } }
    @media (max-width: 400px) { .cart-item { grid-template-columns: 70px 1fr; } }
  </style>
</head>
<body>

<%
  
  const _cartCount     = typeof cartCount     !== 'undefined' ? cartCount     : 0;
  const _wishlistCount = typeof wishlistCount !== 'undefined' ? wishlistCount : 0;
%>

<!-- ── NAVBAR ── -->
<nav class="navbar" role="navigation" aria-label="Main navigation">
  <div class="navbar-inner">

    <a href="/user/homepage" class="brand" aria-label="Helmet Haven home">
      <div class="brand-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9v4l-2 2v1h18v-1l-2-2V9c0-3.87-3.13-7-7-7zm0 20c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2z"/></svg>
      </div>
      Helmet Haven
    </a>

    <ul class="nav-links" role="list">
      <li><a href="/user/homepage">Home</a></li>
      <li><a href="#">About Us</a></li>
      <li><a href="#">Contact Us</a></li>
    </ul>

    <div class="search-wrap" role="search">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
      </svg>
      <input type="search" placeholder="Search premium helmets…" aria-label="Search helmets" autocomplete="off" />
    </div>


    <div class="nav-icons">

     
      <a href="/user/cart" class="icon-btn" aria-label="Shopping cart">
        <svg fill="none" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" >
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2
             2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <% if (_cartCount > 0) { %>
          <span class="badge" id="cartBadge"><%= _cartCount %></span>
        <% } else { %>
          <span class="badge" id="cartBadge" style="display:none">0</span>
        <% } %>
      </a>

      
      <a href="/user/wishlist" class="icon-btn" aria-label="Wishlist">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 0 1 6.364 0L12 7.636l1.318-1.318a4.5 4.5 0 1 1 6.364 6.364L12 20.364l-7.682-7.682a4.5 4.5 0 0 1 0-6.364z"/>
        </svg>
        <% if (_wishlistCount > 0) { %>
          <span class="badge" id="wishlistBadge"><%= _wishlistCount %></span>
        <% } else { %>
          <span class="badge" id="wishlistBadge" style="display:none">0</span>
        <% } %>
      </a>

      <!-- Account -->
      <a href="/user/profileinformation" class="icon-btn" aria-label="Account">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0zM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
        </svg>
      </a>

      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu" role="menu">
    <a href="/user/homepage" role="menuitem">Home</a>
    <a href="#" role="menuitem">About Us</a>
    <a href="#" role="menuitem">Contact Us</a>
    <a href="/user/cart" role="menuitem">Cart (<%= _cartCount %>)</a>
    <a href="/user/wishlist" role="menuitem">Wishlist (<%= _wishlistCount %>)</a>
  </div>
</nav>
<!-- ── END NAVBAR ── -->


<!-- ── MAIN ── -->
<main class="container">
  <nav aria-label="Breadcrumb">
    <div class="breadcrumb">
      <a href="/user/homepage">Home   ></a>
       <a href="/shop">Shop</a>
      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/>
      </svg>
      <span>Shopping Cart</span>
    </div>
  </nav>
 
  <h1 class="page-title">Your Shopping Cart</h1>

  <div class="cart-layout">

    <!-- ── CART ITEMS ── -->
    <section aria-label="Cart items">

      <div class="cart-items" id="cartItems"
           style="display: <%= cart && cart.items && cart.items.length > 0 ? 'flex' : 'none' %>">

        <% if (cart && cart.items && cart.items.length > 0) { %>
          <% cart.items.forEach((item, index) => { %>
        <%
  const p = item.productId;
  if (!p) return;

  const isUnavailable =
    p.isBlocked || p.isDeleted ||
    !p.category || !p.category.isListed || p.category.isDeleted ||
    !p.brand || !p.brand.isListed || p.brand.isDeleted;

  const variant = p?.variants?.find(v => v.size === item.size);
  const price   = variant?.price || 0;
  const stock   = variant?.stock ?? 0;
  const displayQty = (stock === 0 || isUnavailable) ? 0 : item.quantity;
%>
<article class="cart-item" data-id="<%= p._id %>" data-size="<%= item.size %>" data-base-price="<%= price %>" data-stock="<%= isUnavailable ? 0 : stock %>" style="animation-delay:<%= index * 0.07 %>s">
  <% if (p?.productImage?.[0]) { %>
  <img class="item-img" src="<%= p.productImage[0] %>" alt="<%= p.productName %>"/>
<% } else { %>
  <div class="item-img-placeholder" aria-hidden="true">
    <svg width="48" height="48" fill="none" stroke="#3a4a63" stroke-width="1.2" viewBox="0 0 64 64">
      <ellipse cx="32" cy="28" rx="20" ry="18" stroke-linecap="round"/>
      <path d="M14 32c0 8.8 8.1 16 18 16s18-7.2 18-16" stroke-linecap="round"/>
    </svg>
  </div>
<% } %>
  <div class="item-info">
    <div class="item-name"><%= p?.productName %></div>
    <div class="item-meta">Brand: <strong><%= p?.brand?.name || '' %></strong></div>
    <div class="item-meta">Size: <strong><%= item.size %></strong></div>
    <% if (isUnavailable) { %>
      <div style="font-size:.75rem; color:var(--danger); font-weight:600; margin-top:4px;">⚠ This product is currently unavailable</div>
    <% } else if (stock === 0) { %>
      <div style="font-size:.75rem; color:var(--danger); font-weight:600; margin-top:4px;">⚠ Out of Stock</div>
    <% } %>
  </div>

  <div class="item-right">
    <div class="item-price" style="<%= (stock === 0 || isUnavailable) ? 'color:var(--muted);text-decoration:line-through;' : '' %>">₹ <%= price.toLocaleString() %></div>
    <div class="qty-controls" role="group" aria-label="Quantity">
      <button class="qty-btn dec-btn" data-id="<%= p._id %>" data-size="<%= item.size %>" <%= (stock === 0 || isUnavailable) ? 'disabled' : '' %>>−</button>
      <div class="qty-value" id="qty-<%= p._id %>-<%= item.size %>"><%= displayQty %></div>
      <button class="qty-btn inc-btn" data-id="<%= p._id %>" data-size="<%= item.size %>" <%= (stock === 0 || isUnavailable) ? 'disabled' : '' %>>+</button>
    </div>
    <button class="remove-btn" onclick="removeCartItem('<%= p._id %>','<%= item.size %>')">Remove</button>
  </div>
</article>
  <% }) %>
<% } %>
      </div>

      <!-- Empty state -->
      <div class="empty-cart" id="emptyCart" role="alert" aria-live="polite"
           style="display: <%= !cart || !cart.items || cart.items.length === 0 ? 'block' : 'none' %>">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.5 6h13M7 13l-.6-3M17 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-8 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
        </svg>
        <h3>Your cart is empty</h3>
        <p>Looks like you haven't added any helmets yet.</p>
        <button class="btn-shop" onclick="window.location.href='/shop'">Continue Shopping</button>
      </div>

    </section>

    <!-- ── ORDER SUMMARY ── -->
    <aside aria-label="Order summary">
      <div class="order-summary">
        <div class="summary-title">Order Summary</div>
<%
  let subtotal = 0;
  if (cart && cart.items && cart.items.length > 0) {
    cart.items.forEach(item => {
      const p = item.productId;
      if (!p || p.isBlocked || p.isDeleted) return;
      const variant = p.variants?.find(v => v.size === item.size && v.status === "ACTIVE");
      const price = variant?.price || 0;
      const stock = variant?.stock ?? 0;
      if (stock > 0) subtotal += price * item.quantity;
    });
  }

  const shipping = subtotal > 500 ? 0 : 99;
  const tax      = Math.round(subtotal * 0.08);
  const total    = subtotal + shipping + tax;
%>

        <div class="summary-row">
          <span class="summary-label">Subtotal</span>
          <span class="summary-value" id="subtotal">₹ <%= subtotal.toLocaleString() %></span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Shipping Estimate</span>
          <span class="summary-value <%= shipping === 0 ? 'free' : '' %>" id="shipping">
            <%= shipping === 0 ? 'Free' : '₹ ' + shipping %>
          </span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Tax (8%)</span>
          <span class="summary-value" id="tax">₹ <%= tax.toLocaleString() %></span>
        </div>
        <div class="summary-row summary-total">
          <span class="summary-label">Total</span>
          <span class="summary-value" id="total">₹ <%= total.toLocaleString() %></span>
        </div>

        <!-- Promo code -->
        <div class="promo-row">
          <input type="text" class="promo-input" id="promoInput" placeholder="Promo code" aria-label="Promo code"/>
          <button class="promo-btn" id="promoBtn">Apply</button>
        </div>
        <div class="promo-feedback" id="promoFeedback" aria-live="polite"></div>

        <!-- Checkout -->
        <button class="checkout-btn" id="checkoutBtn">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
          Proceed to Checkout
        </button>

        <div class="secure-note">
