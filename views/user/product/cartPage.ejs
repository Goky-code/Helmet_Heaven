<!-- ── TOAST ──────────────────────────────────────── -->
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
  // ── Toast ───────────────────────────────────────────────────
  function showToast(msg, type = 'success') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast ' + type + ' show';
    clearTimeout(t._timer);
    t._timer = setTimeout(() => { t.className = 'toast'; }, 3000);
  }

  // ── Remove ──────────────────────────────────────────────────
  document.querySelectorAll('.remove-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const productId = btn.dataset.id;
      const size = btn.dataset.size;

      const res = await fetch('/user/remove-cart-item', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId, size })
      });
      const data = await res.json();

      if (data.success) {
        const el = document.querySelector(`.cart-item[data-id="${productId}"][data-size="${size}"]`);
        el.style.transition = 'opacity .3s, transform .3s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(16px)';
        setTimeout(() => { el.remove(); location.reload(); }, 300);
      } else {
        showToast(data.message, 'error');
      }
    });
  });

  // ── Quantity ────────────────────────────────────────────────
  document.querySelectorAll('.inc-btn, .dec-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const productId = btn.dataset.id;
      const size = btn.dataset.size;
      const count = btn.classList.contains('inc-btn') ? 1 : -1;

      const res = await fetch('/user/update-cart', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId, size, count })
      });
      const data = await res.json();

      if (data.success) {
        location.reload();
      } else {
        showToast(data.message, 'error');
      }
    });
  });

  // ── Promo code ──────────────────────────────────────────────
  const PROMO_CODES = { SAVE10: 0.10, HELMET20: 0.20, HAVEN15: 0.15 };
  let appliedDiscount = 0;

  document.getElementById('promoBtn').addEventListener('click', () => {
    const inp = document.getElementById('promoInput');
    const fb  = document.getElementById('promoFeedback');
    const code = inp.value.trim().toUpperCase();

    if (!code) {
      inp.classList.add('error');
      fb.textContent = 'Please enter a promo code.';
      fb.className = 'promo-feedback err';
      return;
    }
    inp.classList.remove('error');

    if (PROMO_CODES[code]) {
      appliedDiscount = PROMO_CODES[code];
      fb.textContent = `Code applied! ${(appliedDiscount * 100).toFixed(0)}% off.`;
      fb.className = 'promo-feedback ok';
      inp.disabled = true;
      document.getElementById('promoBtn').disabled = true;
      showToast('Promo code applied!');
    } else {
      inp.classList.add('error');
      fb.textContent = 'Invalid or expired promo code.';
      fb.className = 'promo-feedback err';
    }
  });

  document.getElementById('promoInput').addEventListener('input', () => {
    document.getElementById('promoInput').classList.remove('error');
    const fb = document.getElementById('promoFeedback');
    if (fb.classList.contains('err')) { fb.textContent = ''; fb.className = 'promo-feedback'; }
  });

  // ── Checkout ────────────────────────────────────────────────
  document.getElementById('checkoutBtn').addEventListener('click', () => {
    window.location.href = '/user/checkout';
  });

  // ── Newsletter ───────────────────────────────────────────────
  document.getElementById('joinBtn').addEventListener('click', () => {
    const inp = document.getElementById('newsletterEmail');
    const fb  = document.getElementById('newsletterFeedback');
    const val = inp.value.trim();
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!val) {
      inp.classList.add('error');
      fb.textContent = 'Please enter your email address.';
      fb.className = 'newsletter-feedback err';
      return;
    }
    if (!emailRe.test(val)) {
      inp.classList.add('error');
      fb.textContent = 'Please enter a valid email address.';
      fb.className = 'newsletter-feedback err';
      return;
    }
    inp.classList.remove('error');
    inp.value = '';
    fb.textContent = "You're in! Welcome to Helmet Haven.";
    fb.className = 'newsletter-feedback ok';
    showToast('Subscribed successfully!');
  });

  document.getElementById('newsletterEmail').addEventListener('input', () => {
    document.getElementById('newsletterEmail').classList.remove('error');
    const fb = document.getElementById('newsletterFeedback');
    if (fb.classList.contains('err')) { fb.textContent = ''; fb.className = 'newsletter-feedback'; }
  });

  // ── Enter key shortcuts ──────────────────────────────────────
  document.getElementById('promoInput').addEventListener('keydown', e => {
    if (e.key === 'Enter') document.getElementById('promoBtn').click();
  });
  document.getElementById('newsletterEmail').addEventListener('keydown', e => {
    if (e.key === 'Enter') document.getElementById('joinBtn').click();
  });

  // ── Hamburger ───────────────────────────────────────────────
  const ham = document.getElementById('hamburger');
  const mob = document.getElementById('mobileMenu');
  ham.addEventListener('click', () => {
    const open = mob.classList.toggle('open');
    ham.classList.toggle('open', open);
    ham.setAttribute('aria-expanded', open);
  });
</script>
</body>
