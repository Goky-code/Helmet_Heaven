<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
 /* ── Toast ── */
function showToast(msg, type = 'success') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast ' + type + ' show';
  clearTimeout(t._timer);
  const duration = type === 'error' ? 4500 : 3000;
  t._timer = setTimeout(() => { t.className = 'toast'; }, duration);
}

/* ── Update summary totals ── */
function updateSummary() {
  let subtotal = 0;
  document.querySelectorAll('.cart-item').forEach(item => {
    const stock = Number(item.dataset.stock) ?? 0;
    if (stock === 0) return;
    const basePrice = Number(item.dataset.basePrice) || 0;
    const productId = item.dataset.id;
    const size      = item.dataset.size;
    const qtyEl     = document.getElementById(`qty-${productId}-${size}`);
    const qty       = Number(qtyEl?.textContent) || 0;
    subtotal += basePrice * qty;
  });
  const shipping = subtotal > 500 ? 0 : 99;
  const tax      = Math.round(subtotal * 0.08);
  const total    = subtotal + shipping + tax;
  document.getElementById('subtotal').textContent = '₹ ' + subtotal.toLocaleString('en-IN');
  document.getElementById('shipping').textContent = shipping === 0 ? 'Free' : '₹ ' + shipping;
  document.getElementById('shipping').className   = 'summary-value' + (shipping === 0 ? ' free' : '');
  document.getElementById('tax').textContent      = '₹ ' + tax.toLocaleString('en-IN');
  document.getElementById('total').textContent    = '₹ ' + total.toLocaleString('en-IN');
}

/* ── Update navbar cart badge ── */
function updateCartBadge(count) {
  const badge = document.getElementById('cartBadge');
  if (!badge) return;
  badge.textContent   = count;
  badge.style.display = count > 0 ? 'flex' : 'none';
}

