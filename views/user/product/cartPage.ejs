  style="display: <%= cart && cart.items.length > 0 ? 'flex' : 'none' %>">

  <% if (cart && cart.items.length > 0) { %>
    <% cart.items.forEach((item, index) => { %>
      <%
        const p = item.productId;
        const variant = p?.variants?.find(v => v.size === item.size);
        const price = variant?.price || 0;
      %>

      <article class="cart-item" data-id="<%= p._id %>" data-size="<%= item.size %>" data-base-price="<%= price %>" style="animation-delay:<%= index * 0.07 %>s">

        <% if (p?.productImage?.[0]) { %>
          <img class="item-img" src="<%= p.productImage[0] %>" alt="<%= p.productName %>"/>
        <% } else { %>
          <div class="item-img-placeholder" aria-hidden="true">
            <svg width="48" height="48" fill="none" stroke="#3a4a63" stroke-width="1.2" viewBox="0 0 64 64">
              <ellipse cx="32" cy="28" rx="20" ry="18" stroke-linecap="round"/>
              <path d="M14 32c0 8.8 8.1 16 18 16s18-7.2 18-16" stroke-linecap="round"/>
            </svg>
          </div>
        <% } %>

        <div class="item-info">
          <div class="item-name"><%= p?.productName %></div>
          <div class="item-meta">
            Brand: <strong><%= p?.brand?.name || '' %></strong>
          </div>
          <div class="item-meta">
            Size: <strong><%= item.size %></strong>
          </div>
        </div>

        <div class="item-right">
          <div class="item-price">₹ <%= price.toLocaleString() %></div>

          <div class="qty-controls" role="group" aria-label="Quantity">
            <button class="qty-btn dec-btn" data-id="<%= p._id %>" data-size="<%= item.size %>">−</button>
            <div class="qty-value" id="qty-<%= p._id %>-<%= item.size %>"><%= item.quantity %></div>
            <button class="qty-btn inc-btn" data-id="<%= p._id %>" data-size="<%= item.size %>">+</button>
          </div>

          <button class="remove-btn" data-id="<%= p._id %>" data-size="<%= item.size %>">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16"/>
            </svg>
            REMOVE
          </button>
        </div>

      </article>
    <% }) %>
  <% } %>

