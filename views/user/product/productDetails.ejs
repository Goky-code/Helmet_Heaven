      <div
        class="thumb <%= index === 0 ? 'active' : '' %>"
        role="listitem"
        tabindex="0"
        data-src="<%= image %>"
        onclick="setThumb(this)"
        onkeydown="if(event.key==='Enter')setThumb(this)"
      >

        <img
          src="<%= image %>"
          alt="<%= product.productName %>"
        />

