<!-- ─── SCRIPT ─── -->
<script>
  let qty = 1;
  let cartCount = 0;

  /* ---------- TOAST ---------- */
  function showToast(msg, color) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.background = color || 'var(--success)';
    t.classList.add('show');
    clearTimeout(t._timer);
    t._timer = setTimeout(() => t.classList.remove('show'), 2800);
  }

  /* ---------- HAMBURGER ---------- */
  const hamburger = document.getElementById('hamburger');
  const navDrawer = document.getElementById('navDrawer');
  hamburger.addEventListener('click', () => {
    const open = navDrawer.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', open);
  });

  /* ---------- GALLERY ---------- */
  function setThumb(el){
    document.querySelectorAll(".thumb").forEach(t=>{
      t.classList.remove("active")
    })
    el.classList.add("active")
    const newSrc = el.dataset.src
    document.getElementById("mainImg").src = newSrc
  }

  /* ---------- ZOOM ---------- */
  function openZoom(src) {
    document.getElementById('zoomImg').src = src;
    document.getElementById('zoomOverlay').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  function closeZoom() {
    document.getElementById('zoomOverlay').classList.remove('active');
    document.body.style.overflow = '';
  }
  document.getElementById('zoomOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeZoom();
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeZoom(); });

  /* ---------- WISHLIST ---------- */
  function toggleWish(btn) {
    btn.classList.toggle('active');
    const wished = btn.classList.contains('active');
    showToast(wished ? '❤ Added to wishlist!' : 'Removed from wishlist', wished ? '#e91e63' : '#607d8b');
  }

  /* ---------- SIZE ---------- */
  let selectedSize = null

  function selectSize(btn){
    document.querySelectorAll(".size-btn").forEach(el=>{
      el.classList.remove("active")
    })
    btn.classList.add("active")
    selectedSize = btn.dataset.size
    const price = btn.dataset.price
    document.getElementById("displayPrice").innerText = `₹ ${Number(price).toLocaleString()}`
    const stock = Number(btn.dataset.stock)
    const stockMsg = document.getElementById("stockMsg")
    if(stock > 0){
      stockMsg.innerText = "In Stock"
      stockMsg.style.color = "#22c55e"
    }else{
      stockMsg.innerText = "Out Of Stock"
      stockMsg.style.color = "red"
    }
    const qtyInput = document.getElementById("qtyDisplay")
    qtyInput.max = stock
    if(Number(qtyInput.value) > stock){
      qtyInput.value = stock
    }
  }

  function changeQty(change){
    const qtyInput = document.getElementById("qtyDisplay")
    let current = Number(qtyInput.value)
    const max = Number(qtyInput.max)
    current += change
    if(current < 1) current = 1
    if(current > max) current = max
    qtyInput.value = current
    qty = current
  }

  /* ---------- CART ---------- */
  function validateBeforeAction() {
    if (!selectedSize) {
      const err = document.getElementById('sizeError');
      err.style.display = 'block';
      err.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      return false;
    }
    return true;
  }

  function addToCart() {
    if (!validateBeforeAction()) return;
    cartCount += qty;
    document.getElementById('cartBadge').textContent = cartCount;
    showToast(`✓ ${qty}× added to cart! (${selectedSize})`);
  }

  function buyNow() {
    if (!validateBeforeAction()) return;
    showToast(`⚡ Redirecting to checkout… (${selectedSize}, Qty ${qty})`, 'var(--accent)');
  }

  /* ---------- NEWSLETTER ---------- */
  function submitNewsletter(e) {
    e.preventDefault();
    const input = document.getElementById('newsletterEmail');
    const msg   = document.getElementById('newsletterMsg');
    const email = input.value.trim();
    const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    if (!email) {
      msg.style.display = 'block';
      msg.style.color   = 'var(--danger)';
      msg.textContent   = '⚠ Please enter your email address.';
      return;
    }
    if (!valid) {
      msg.style.display = 'block';
      msg.style.color   = 'var(--danger)';
      msg.textContent   = '⚠ Please enter a valid email address.';
      return;
    }
    msg.style.display = 'block';
    msg.style.color   = 'var(--success)';
    msg.textContent   = '✓ You\'re subscribed! Check your inbox soon.';
    input.value = '';
    setTimeout(() => { msg.style.display = 'none'; }, 4000);
  }

const image = document.getElementById("mainImg")

image.addEventListener("mousemove", (e) => {

  const rect = image.getBoundingClientRect()

  const x = ((e.clientX - rect.left) / rect.width) * 100
  const y = ((e.clientY - rect.top) / rect.height) * 100

  image.style.transformOrigin = `${x}% ${y}%`
  image.style.transform = "scale(2)"

})

image.addEventListener("mouseleave", () => {

  image.style.transform = "scale(1)"
  image.style.transformOrigin = "center"

})


</script>
</body>
</html>

