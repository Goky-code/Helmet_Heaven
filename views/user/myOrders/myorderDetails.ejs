<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Helmet Haven - Order Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
  <style>
    :root {
      --bg-main:           #0d1117;
      --bg-sidebar:        #0d1117;
      --bg-card:           #161b22;
      --bg-input:          #0d1117;
      --border-color:      #2a3240;
      --text-primary:      #e6edf3;
      --text-muted:        #8b949e;
      --accent-blue:       #1f6feb;
      --accent-blue-hover: #388bfd;
      --sidebar-active-bg: #161b22;
      --danger-color:      #f85149;
      --success-color:     #3fb950;
      --warning-color:     #d29922;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-main);
      color: var(--text-primary);
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 14px;
      min-height: 100vh;
      display: flex; flex-direction: column;
    }

    /* ── NAVBAR ── */
    .navbar-custom {
      background-color: #0d1117;
      border-bottom: 1px solid var(--border-color);
      padding: 10px 16px;
      position: sticky; top: 0; z-index: 1000;
    }
    .navbar-inner {
      display: flex; align-items: center;
      justify-content: space-between; gap: 12px; flex-wrap: wrap;
    }
    .navbar-left { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
    .navbar-brand-text {
      font-weight: 700; font-size: 18px; color: var(--text-primary) !important;
      display: flex; align-items: center; gap: 8px;
      text-decoration: none; white-space: nowrap;
    }
    .navbar-brand-text i { color: var(--accent-blue); font-size: 20px; }
    .nav-links { display: flex; gap: 2px; }
    .nav-link-custom {
      color: var(--text-primary) !important; font-size: 14px;
      padding: 6px 10px !important; text-decoration: none; white-space: nowrap;
    }
    .nav-link-custom:hover { color: var(--accent-blue) !important; }
    .search-input {
      background-color: #161b22; border: 1px solid var(--border-color);
      color: var(--text-muted); border-radius: 6px;
      padding: 6px 14px 6px 36px; font-size: 13px;
      width: 100%; max-width: 320px; min-width: 120px; outline: none;
    }
    .search-input:focus { border-color: var(--accent-blue); }
    .search-input::placeholder { color: var(--text-muted); }
    .search-wrapper { position: relative; flex: 1; max-width: 320px; }
    .search-wrapper i { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 14px; }

    .navbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

    .icon-btn {
      background: #161b22; border: 1px solid var(--border-color);
      color: var(--text-primary); border-radius: 8px;
      width: 38px; height: 38px;
      display: flex; align-items: center; justify-content: center;
      font-size: 17px; position: relative; cursor: pointer;
      text-decoration: none; flex-shrink: 0;
      transition: border-color .2s, color .2s;
    }
    .icon-btn:hover { border-color: var(--accent-blue); color: var(--accent-blue); }

    .icon-btn .nbadge {
      position: absolute; top: -4px; right: -4px;
      background: var(--accent-blue); color: #fff;
      font-size: 9px; border-radius: 10px;
      padding: 1px 5px; font-weight: 700;
      border: 1px solid var(--bg-main);
      pointer-events: none;
    }

    .hamburger-btn {
      display: none; background: #161b22; border: 1px solid var(--border-color);
      color: var(--text-primary); border-radius: 8px;
      width: 38px; height: 38px; align-items: center; justify-content: center;
      font-size: 18px; cursor: pointer; flex-shrink: 0;
    }

    /* ── LAYOUT ── */
    .page-wrapper { display: flex; flex: 1; min-height: 0; }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 240px; min-width: 240px; background: var(--bg-sidebar);
      border-right: 1px solid var(--border-color);
      padding: 24px 0; transition: transform 0.3s ease;
    }
    .sidebar-heading {
      display: flex; align-items: center; gap: 10px;
      font-weight: 700; font-size: 15px; padding: 0 20px 20px;
      color: var(--text-primary);
    }
    .sidebar-heading i { color: var(--accent-blue); font-size: 18px; }
    .sidebar-item {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 20px; color: var(--text-primary);
      text-decoration: none; font-size: 14px; cursor: pointer;
      border-left: 3px solid transparent;
      transition: background .15s, color .15s; white-space: nowrap;
    }
    .sidebar-item:hover { background: var(--bg-card); color: var(--accent-blue); }
    .sidebar-item.active { background: var(--bg-card); color: var(--accent-blue); border-left-color: var(--accent-blue); }
    .sidebar-item i { font-size: 16px; width: 18px; text-align: center; }
    .sidebar-divider { border-top: 1px solid var(--border-color); margin: 12px 0; }
    .sidebar-item.logout { color: var(--danger-color); }
    .sidebar-item.logout:hover { background: rgba(248,81,73,0.08); color: var(--danger-color); }
    .sidebar-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.6); z-index: 900;
    }


#returnModal .modal-content,
#cancelModal .modal-content {
    background: #111820 !important;
    color: #f1f5f9 !important;
}

/* Header */
#returnModal .modal-header,
#cancelModal .modal-header {
    background: #111820 !important;
    border-bottom: 1px solid #2a3441 !important;
}

#returnModal .modal-title,
#cancelModal .modal-title {
    color: #ffffff !important;
}

/* Body */
#returnModal .modal-body,
#cancelModal .modal-body {
    background: #111820 !important;
    color: #f1f5f9 !important;
}

/* Each product box */
#returnModal .modal-body .border,
#cancelModal .modal-body .border {
    background: #18212b !important;
    border-color: #303b49 !important;
    color: #f1f5f9 !important;
}

/* Product name */
#returnModal h6,
#cancelModal strong {
    color: #ffffff !important;
}

/* Size / Quantity */
#returnModal .text-muted,
#cancelModal .d-flex {
    color: #aeb8c4 !important;
}

/* Reason / Comment */
#returnModal .form-label,
#cancelModal .form-label {
    color: #e5e7eb !important;
}

/* Dropdown */
#returnModal .form-select,
#cancelModal .form-select {
    background: #0d141c !important;
    color: #f1f5f9 !important;
    border-color: #3a4655 !important;
}

#returnModal .form-select option,
#cancelModal .form-select option {
    background: #0d141c;
    color: #ffffff;
}

/* Comment textarea */
#returnModal .form-control,
#cancelModal .form-control {
    background: #0d141c !important;
    color: #f1f5f9 !important;
    border-color: #3a4655 !important;
}

#returnModal .form-control::placeholder,
#cancelModal .form-control::placeholder {
    color: #7f8b99 !important;
}

/* Footer */
#returnModal .modal-footer,
#cancelModal .modal-footer {
    background: #111820 !important;
    border-top: 1px solid #2a3441 !important;
}

/* Checkbox */
#returnModal .form-check-input,
#cancelModal .form-check-input {
    background-color: #0d141c;
    border-color: #64748b;
}

    /* ── MAIN CONTENT ── */
    .main-content {
      flex: 1; padding: 32px 28px;
      background: var(--bg-main); overflow-x: hidden; min-width: 0;
    }
    .back-link {
      color: var(--accent-blue); font-size: 13.5px; font-weight: 600;
      text-decoration: none; display: inline-flex; align-items: center;
      gap: 6px; margin-bottom: 18px;
    }
    .back-link:hover { color: var(--accent-blue-hover); }
    .page-title { font-size: 24px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px; }
    .page-subtitle { color: var(--text-muted); font-size: 13px; margin-bottom: 24px; }

    /* ── INFO CARDS ROW ── */
    .info-card {
      background: var(--bg-card); border: 1px solid var(--border-color);
      border-radius: 12px; padding: 20px; height: 100%;
    }
    .info-card-title {
      font-size: 12px; font-weight: 700; letter-spacing: 0.04em;
      text-transform: uppercase; color: var(--accent-blue);
      display: flex; align-items: center; gap: 8px; margin-bottom: 16px;
    }
    .info-row {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 13.5px; margin-bottom: 10px; gap: 10px;
    }
    .info-row:last-of-type { margin-bottom: 0; }
    .info-row-label { color: var(--text-muted); }
    .info-row-value { color: var(--text-primary); font-weight: 600; text-align: right; }
    .info-row-value.price { color: var(--accent-blue); }
    .order-status-inline {
      display: inline-flex; align-items: center; gap: 5px; font-weight: 700;
    }
    .order-status-inline.status-delivered { color: var(--success-color); }
    .order-status-inline.status-cancelled { color: var(--danger-color); }
    .order-status-inline.status-pending,
    .order-status-inline.status-shipped,
    .order-status-inline.status-processing { color: var(--warning-color); }

    .address-lines { color: var(--text-primary); font-size: 13.5px; line-height: 1.8; }
    .address-lines .addr-name { font-weight: 700; margin-bottom: 2px; }

    .payment-method-row { display: flex; align-items: center; gap: 12px; }
    .payment-badge {
      background: #1c2333; border: 1px solid var(--border-color);
      border-radius: 6px; padding: 6px 10px; font-size: 10px;
      font-weight: 800; letter-spacing: 0.03em; color: var(--text-muted);
    }
    .payment-name { font-size: 13.5px; font-weight: 600; color: var(--text-primary); }

    .btn-cancel-order {
      width: 100%; margin-top: 18px;
      background: rgba(248,81,73,0.1); border: 1px solid rgba(248,81,73,0.35);
      color: var(--danger-color); border-radius: 8px; font-size: 13.5px;
      font-weight: 700; padding: 10px 16px; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 7px;
      transition: background 0.15s, border-color 0.15s;
    }
    .btn-cancel-order:hover { background: rgba(248,81,73,0.18); border-color: var(--danger-color); }

    /* ── ORDER ITEMS CARD ── */
    .items-card {
      background: var(--bg-card); border: 1px solid var(--border-color);
      border-radius: 12px; margin-top: 20px; overflow: hidden;
    }
    .items-card-header {
      padding: 16px 24px; border-bottom: 1px solid var(--border-color);
      color: var(--text-muted); font-size: 14px; font-weight: 600;
    }
    .order-item-row {
      display: flex; align-items: center; gap: 18px;
      padding: 20px 24px; border-bottom: 1px solid var(--border-color);
    }
    .order-item-thumb {
      width: 76px; height: 76px; border-radius: 8px;
      background: #fff; object-fit: cover; flex-shrink: 0;
      border: 1px solid var(--border-color);
    }
    .order-item-info { flex: 1; min-width: 0; }
    .order-item-name { font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 3px; }
    .order-item-desc {
      font-size: 11.5px; letter-spacing: 0.03em; text-transform: uppercase;
      color: var(--text-muted); margin-bottom: 8px;
    }
    .order-item-attrs { font-size: 13px; color: var(--text-muted); }
    .order-item-attrs strong { color: var(--text-primary); font-weight: 600; }
    .order-item-attrs .sep { margin: 0 10px; }
    .order-item-price { font-size: 15px; font-weight: 700; color: var(--text-primary); white-space: nowrap; }

    /* ── TOTALS ── */
    .totals-block { padding: 22px 24px; }
    .totals-row {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 14px; color: var(--text-muted); padding: 7px 0;
      max-width: 340px; margin-left: auto;
    }
    .totals-row .val { color: var(--text-primary); font-weight: 600; }
    .totals-row .val.free { color: var(--success-color); font-weight: 700; }
    .totals-row.total-final {
      border-top: 1px solid var(--border-color); margin-top: 10px; padding-top: 16px;
      font-size: 16px; font-weight: 700; color: var(--text-primary);
    }
    .totals-row.total-final .val { color: var(--accent-blue); font-size: 18px; }

    /* ── FOOTER ── */
    footer {
      background: var(--bg-main); border-top: 1px solid var(--border-color);
      padding: 36px 20px 20px;
    }
    .footer-brand { font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .footer-brand i { color: var(--accent-blue); }
    .footer-desc { color: var(--text-muted); font-size: 12.5px; max-width: 220px; line-height: 1.6; }
    .footer-heading { font-size: 13px; font-weight: 600; color: var(--text-primary); margin-bottom: 14px; }
    .footer-link { display: block; color: var(--text-muted); text-decoration: none; font-size: 12.5px; margin-bottom: 8px; transition: color 0.15s; }
    .footer-link:hover { color: var(--accent-blue); }
    .footer-input {
      background: var(--bg-input); border: 1px solid var(--border-color);
      border-radius: 6px 0 0 6px; color: var(--text-primary);
      font-size: 13px; padding: 8px 12px; outline: none; flex: 1; min-width: 0;
    }
    .footer-input:focus { border-color: var(--accent-blue); }
    .footer-input::placeholder { color: var(--text-muted); }
    .btn-join {
      background: var(--accent-blue); color: #fff; border: none;
      border-radius: 0 6px 6px 0; padding: 8px 16px;
      font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap;
    }
    .btn-join:hover { background: var(--accent-blue-hover); }
    .footer-newsletter-row { display: flex; width: 100%; max-width: 280px; }
    .footer-bottom {
      border-top: 1px solid var(--border-color); margin-top: 30px; padding-top: 16px;
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 8px;
    }
    .footer-bottom-text { color: var(--text-muted); font-size: 12px; }
    .footer-bottom-link { color: var(--text-muted); font-size: 12px; text-decoration: none; }
    .footer-bottom-link:hover { color: var(--text-primary); }

    /* ── RESPONSIVE ── */
    @media (max-width: 992px) {
      .sidebar { width: 200px; min-width: 200px; }
      .sidebar-item { font-size: 13px; padding: 10px 14px; gap: 10px; }
      .main-content { padding: 24px 20px; }
    }
    @media (max-width: 768px) {
      .hamburger-btn { display: flex; }
      .nav-links { display: none; }
      .sidebar {
        position: fixed; top: 0; left: 0; height: 100%; z-index: 950;
        transform: translateX(-100%); width: 240px; min-width: 240px; padding-top: 60px;
      }
      .sidebar.open { transform: translateX(0); }
      .sidebar-overlay.open { display: block; }
      .main-content { padding: 20px 16px; }
      .order-item-row { flex-wrap: wrap; padding: 16px 18px; }
      .order-item-price { margin-left: auto; }
      .totals-row { max-width: 100%; }
    }
    @media (max-width: 480px) {
      .navbar-brand-text { font-size: 16px; }
      .search-wrapper { display: none; }
      .page-title { font-size: 19px; }
      .footer-desc { max-width: 100%; }
      .footer-bottom { flex-direction: column; align-items: flex-start; }
      .order-item-thumb { width: 60px; height: 60px; }
      .order-item-name { font-size: 14.5px; }
    }
    @media (max-width: 360px) {
      .main-content { padding: 16px 12px; }
      .navbar-custom { padding: 8px 12px; }
    }
  </style>
</head>
<body>

<%
  const _cartCount     = typeof cartCount     !== 'undefined' ? cartCount     : 0;
  const _wishlistCount = typeof wishlistCount !== 'undefined' ? wishlistCount : 0;
  const _order         = typeof order         !== 'undefined' ? order        : null;

  function statusClass(status) {
    const s = String(status || '').toLowerCase();
    if (s === 'delivered') return 'status-delivered';
    if (s === 'cancelled' || s === 'canceled') return 'status-cancelled';
    if (s === 'shipped') return 'status-shipped';
    if (s === 'processing') return 'status-processing';
    return 'status-pending';
  }
  function statusIcon(status) {
    const s = String(status || '').toLowerCase();
    if (s === 'delivered') return 'bi-check-circle-fill';
    if (s === 'cancelled' || s === 'canceled') return 'bi-x-circle-fill';
    if (s === 'shipped') return 'bi-truck';
    if (s === 'processing') return 'bi-arrow-repeat';
    return 'bi-clock-fill';
  }
  // Order can only be cancelled while it's still pending/processing
  const _cancellableStatuses = ['pending', 'processing'];
  const _isCancellable = _order && _cancellableStatuses.includes(String(_order.status || '').toLowerCase());
%>

<!-- Sidebar overlay -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- ── NAVBAR ── -->
<nav class="navbar-custom">
  <div class="navbar-inner">

    <div class="navbar-left">
      <button class="hamburger-btn" id="hamburgerBtn" onclick="toggleSidebar()" aria-label="Menu">
        <i class="bi bi-list"></i>
      </button>
      <a class="navbar-brand-text" href="/user/homepage">
        <i class="bi bi-shield-fill"></i> Helmet Haven
      </a>
      <div class="nav-links">
        <a href="/user/homepage" class="nav-link-custom">Home</a>
        <a href="#" class="nav-link-custom">About Us</a>
        <a href="#" class="nav-link-custom">Contact Us</a>
      </div>
    </div>

    <div class="search-wrapper">
      <i class="bi bi-search"></i>
      <input type="text" class="search-input" placeholder="Search premium helmets..."/>
    </div>

    <div class="navbar-right">

      <a href="/user/cart" class="icon-btn" aria-label="Cart">
        <i class="bi bi-cart2"></i>
        <% if (_cartCount > 0) { %>
          <span class="nbadge" id="cartBadge"><%= _cartCount %></span>
        <% } else { %>
          <span class="nbadge" id="cartBadge" style="display:none">0</span>
        <% } %>
      </a>

      <a href="/user/wishlist" class="icon-btn" aria-label="Wishlist">
        <i class="bi bi-heart"></i>
        <% if (_wishlistCount > 0) { %>
          <span class="nbadge" id="wishlistBadge"><%= _wishlistCount %></span>
        <% } else { %>
          <span class="nbadge" id="wishlistBadge" style="display:none">0</span>
        <% } %>
      </a>

      <a href="/user/profileinformation" class="icon-btn" aria-label="Account">
        <i class="bi bi-person"></i>
      </a>

    </div>
  </div>
</nav>
<!-- ── END NAVBAR ── -->


<!-- ── PAGE BODY ── -->
<div class="page-wrapper">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-heading"><i class="bi bi-person-circle"></i> My Account</div>
    <a href="/user/profileinformation" class="sidebar-item"><i class="bi bi-person"></i> Profile Info</a>
    <a href="/user/myOrders" class="sidebar-item active"><i class="bi bi-bag"></i> My Orders</a>
    <a href="/user/address/addressPage" class="sidebar-item"><i class="bi bi-geo-alt"></i> Address</a>
    <a href="#" class="sidebar-item"><i class="bi bi-wallet2"></i> Wallet</a>
    <a href="#" class="sidebar-item"><i class="bi bi-scissors"></i> Coupon</a>
    <a href="/user/passwordChange" class="sidebar-item"><i class="bi bi-lock"></i> Password Change</a>
    <div class="sidebar-divider"></div>
    <a href="/user/logout" class="sidebar-item logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
  </aside>

  <!-- MAIN -->
  <main class="main-content">

    <% if (!_order) { %>

      <a href="/user/myOrders" class="back-link"><i class="bi bi-arrow-left"></i> Back to Orders</a>
      <div class="info-card" style="text-align:center; padding:60px 24px;">
        <i class="bi bi-exclamation-circle" style="font-size:36px; color:var(--text-muted); display:block; margin-bottom:14px;"></i>
        <p style="color:var(--text-muted); margin-bottom:0;">Order not found.</p>
      </div>

    <% } else { %>

      <a href="/user/myOrders" class="back-link"><i class="bi bi-arrow-left"></i> Back to Orders</a>

      <h1 class="page-title">Order #<%= _order.orderId %></h1>
      <p class="page-subtitle">Placed on <%= _order.datePlaced %></p>

      <div class="row g-3">
        <!-- ORDER SUMMARY -->
        <div class="col-12 col-lg-4">
          <div class="info-card">
            <div class="info-card-title"><i class="bi bi-file-earmark-text"></i> Order Summary</div>
            <div class="info-row">
              <span class="info-row-label">Order ID</span>
              <span class="info-row-value">#<%= _order.orderId %></span>
            </div>
            <div class="info-row">
              <span class="info-row-label">Date</span>
              <span class="info-row-value"><%= _order.datePlaced %></span>
            </div>
            <div class="info-row">
              <span class="info-row-label">Total Price</span>
              <span class="info-row-value price"><%= _order.totalPrice %></span>
            </div>
            <div class="info-row">
              <span class="info-row-label">Status</span>
              <span class="order-status-inline <%= statusClass(_order.status) %>">
                <i class="bi <%= statusIcon(_order.status) %>"></i> <%= _order.status %>
              </span>
            </div>
<% if (order.CanDownloadInvoice) { %>
    <a href="/user/orders/<%= order.orderId %>/invoice"
       class="btn btn-primary">
        Download Invoice
    </a>
<% } %>


<% if (order.canReturn) { %>

<button
    class="btn btn-warning"
    data-bs-toggle="modal"
    data-bs-target="#returnModal">

    Return Order

</button>

<% } %>

<% if (order.canCancel) { %>

<button
    class="btn btn-danger"
    data-bs-toggle="modal"
    data-bs-target="#cancelModal">

    Cancel Order

</button>

<% } %>

<% if (_order.status === "Return Requested") { %>

<button class="btn btn-secondary mt-3 w-100" disabled>
    Return Requested
</button>

<% } %>

<% if (_order.status === "Returned") { %>

<button class="btn btn-success mt-3 w-100" disabled>
    Returned
</button>

<% } %>

<% if (_order.status === "Cancelled") { %>

<button class="btn btn-danger mt-3 w-100" disabled>
    Order Cancelled
</button>

<% } %>
          </div>
        </div>

        <!-- SHIPPING ADDRESS -->
        <div class="col-12 col-lg-4">
          <div class="info-card">
            <div class="info-card-title"><i class="bi bi-truck"></i> Shipping Address</div>
            <% if (_order.shippingAddress) { %>
              <div class="address-lines">
                <div class="addr-name"><%= _order.shippingAddress.name %></div>
                <% if (_order.shippingAddress.line1) { %><div><%= _order.shippingAddress.line1 %></div><% } %>
                <% if (_order.shippingAddress.line2) { %><div><%= _order.shippingAddress.line2 %></div><% } %>
                <div>
                  <%= _order.shippingAddress.city %><% if (_order.shippingAddress.pincode) { %>, <%= _order.shippingAddress.pincode %><% } %>
                </div>
                <% if (_order.shippingAddress.state) { %><div><%= _order.shippingAddress.state %></div><% } %>
              </div>
            <% } else { %>
              <p style="color:var(--text-muted); font-size:13px;">No shipping address on file.</p>
            <% } %>
          </div>
        </div>

        <!-- PAYMENT METHOD -->
        <div class="col-12 col-lg-4">
          <div class="info-card">
            <div class="info-card-title"><i class="bi bi-credit-card"></i> Payment Method</div>
            <% if (_order.paymentMethod) { %>
              <div class="payment-method-row">
                <span class="payment-badge"><%= _order.paymentMethod.badge || _order.paymentMethod.name %></span>
               
              </div>
            <% } else { %>
              <p style="color:var(--text-muted); font-size:13px;">No payment info available.</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- ORDER ITEMS -->
      <div class="items-card">
        <div class="items-card-header">Order Items</div>

        <% (_order.items || []).forEach(function(item) { %>
          <div class="order-item-row">
            <img class="order-item-thumb" src="<%= item.image %>" alt="<%= item.name %>">
            <div class="order-item-info">
              <div class="order-item-name"><%= item.name %></div>
              <% if (item.description) { %>
                <div class="order-item-desc"><%= item.description %></div>
              <% } %>
              <div class="order-item-attrs">
                Size: <strong><%= item.size %></strong>
                <span class="sep">•</span>
                Qty: <strong><%= item.qty %></strong>
              </div>
            </div>
            <div class="order-item-price"><%= item.price %></div>
          </div>
        <% }); %>

        <!-- TOTALS -->
        <div class="totals-block">
          <div class="totals-row">
            <span>Subtotal</span>
            <span class="val"><%= _order.subtotal %></span>
          </div>
          <div class="totals-row">
            <span>Shipping Fee</span>
            <% if (!_order.shippingFee || String(_order.shippingFee).toLowerCase() === 'free') { %>
              <span class="val free">Free</span>
            <% } else { %>
              <span class="val"><%= _order.shippingFee %></span>
            <% } %>
          </div>
          <div class="totals-row">
            <span>Tax <% if (_order.taxLabel) { %>(<%= _order.taxLabel %>)<% } %></span>
            <span class="val"><%= _order.tax %></span>
          </div>
          <div class="totals-row total-final">
            <span>Total</span>
            <span class="val"><%= _order.total %></span>
          </div>
        </div>
      </div>

    <% } %>

  </main>
</div>


<!-- ── FOOTER ── -->
<footer>
  <div class="row g-4">
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="footer-brand"><i class="bi bi-shield-fill"></i> Helmet Haven</div>
      <p class="footer-desc">The world's premier destination for high-end safety and performance headgear.</p>
    </div>
    <div class="col-6 col-sm-3 col-lg-2">
      <p class="footer-heading">Shop</p>
      <a href="#" class="footer-link">Full Face</a>
      <a href="#" class="footer-link">Off-Road</a>
      <a href="#" class="footer-link">Modular</a>
      <a href="#" class="footer-link">Accessories</a>
    </div>
    <div class="col-6 col-sm-3 col-lg-2">
      <p class="footer-heading">Support</p>
      <a href="#" class="footer-link">Shipping Policy</a>
      <a href="#" class="footer-link">Return &amp; Exchange</a>
      <a href="#" class="footer-link">Size Guide</a>
      <a href="#" class="footer-link">FAQ</a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <p class="footer-heading">Newsletter</p>
      <p class="footer-desc mb-3">Get early access to drops and exclusive offers.</p>
      <div class="footer-newsletter-row">
        <input type="email" class="footer-input" placeholder="Email address"/>
        <button class="btn-join">Join</button>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-bottom-text">© 2024 Helmet Haven. All rights reserved.</span>
    <div class="d-flex gap-3 flex-wrap">
      <a href="#" class="footer-bottom-link">Privacy Policy</a>
      <a href="#" class="footer-bottom-link">Terms of Service</a>
    </div>
  </div>

  <div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Return Order</h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>
            </div>

            <form action="/user/orders/<%= order.orderId %>/return" method="POST">

                <div class="modal-body">

                    <% order.items.forEach(function(item){ %>

                        <div class="border rounded p-3 mb-4">

                            <div class="d-flex align-items-center">

                                <input
                                    type="checkbox"
                                    class="form-check-input me-3 mt-0"
                                    name="items"
                                    value="<%= item.productId %>">

                                <img
                                    src="<%= item.image %>"
                                    alt="<%= item.name %>"
                                    width="70"
                                    height="70"
                                    class="rounded border me-3">

                                <div>

                                    <h6 class="mb-1">
                                        <%= item.name %>
                                    </h6>

                                    <small class="text-muted">
                                        Size :
                                        <%= item.size %>

                                        |

                                        Qty :
                                        <%= item.qty %>
                                    </small>

                                </div>

                            </div>

                            <div class="mt-3">

                                <label class="form-label">
                                    Reason
                                </label>

                                <select
                                    class="form-select"
                                    name="reason_<%= item.productId %>">

                                    <option value="">
                                        Select Reason
                                    </option>

                                    <option value="Wrong Product">
                                        Wrong Product
                                    </option>

                                    <option value="Damaged Product">
                                        Damaged Product
                                    </option>

                                    <option value="Size Issue">
                                        Size Issue
                                    </option>

                                    <option value="Quality Issue">
                                        Quality Issue
                                    </option>

                                    <option value="Changed My Mind">
                                        Changed My Mind
                                    </option>

                                    <option value="Other">
                                        Other
                                    </option>

                                </select>

                            </div>

                            <div class="mt-3">

                                <label class="form-label">
                                    Comment
                                </label>

                                <textarea
                                    class="form-control"
                                    rows="3"
                                    name="comment_<%= item.productId %>"
                                    placeholder="Optional"></textarea>

                            </div>

                        </div>

                    <% }) %>

                </div>

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                        Close

                    </button>

                    <button
                        type="submit"
                        class="btn btn-warning">

                        Submit Return

                    </button>

                </div>

            </form>

        </div>
    </div>
</div>


<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Cancel Products
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>

            </div>

            <form action="/user/orders/<%= order.orderId %>/cancel" method="POST">

                <div class="modal-body">

                    <% order.items.forEach(function(item){ %>

                        <% if(item.status !== "Cancelled"){ %>

                        <div class="border rounded p-3 mb-3">

                            <div class="d-flex align-items-center">

                                <input
                                    class="form-check-input me-3"
                                    type="checkbox"
                                    name="items"
                                    value="<%= item.productId %>">

                                <img
                                    src="<%= item.image %>"
                                    width="70"
                                    height="70"
                                    class="rounded me-3">

                                <div>

                                    <strong>
                                        <%= item.name %>
                                    </strong>

                                    <br>

                                    Size :
                                    <%= item.size %>

                                    |

                                    Qty :
                                    <%= item.qty %>

                                </div>

                            </div>

                            <div class="mt-3">

                                <label class="form-label">
                                    Cancellation Reason
                                </label>

                                <select
                                    class="form-select"
                                    name="reason_<%= item.productId %>">

                                    <option value="">
                                        Select Reason
                                    </option>

                                    <option value="Ordered by mistake">
                                        Ordered by mistake
                                    </option>

                                    <option value="Found better price">
                                        Found better price
                                    </option>

                                    <option value="Delivery too late">
                                        Delivery too late
                                    </option>

                                    <option value="Changed my mind">
                                        Changed my mind
                                    </option>

                                    <option value="Other">
                                        Other
                                    </option>

                                </select>

                                <div class="mt-3">

    <label class="form-label">
         Comment
    </label>

    <textarea
        class="form-control"
        name="comment_<%= item.productId %>"
        rows="3"
        placeholder="Write your comment (optional)"></textarea>

</div>

                            </div>

                        </div>

                        <% } %>

                    <% }) %>

                </div>

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                        Close

                    </button>

                    <button
                        class="btn btn-danger"
                        type="submit">

                        Cancel Selected Products

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('open');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sidebarOverlay').classList.remove('open');
  }
</script>
</body>
</html>