  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    /* ══════════════════════════
       SIDEBAR TOGGLE (mobile)
    ══════════════════════════ */
    const hamburger = document.getElementById('hamburgerBtn');
    const sidebar   = document.getElementById('sidebar');
    const overlay   = document.getElementById('sidebarOverlay');

    function openSidebar()  { sidebar.classList.add('open');  overlay.classList.add('show'); }
    function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('show'); }

    hamburger.addEventListener('click', () => {
      sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
    });
    overlay.addEventListener('click', closeSidebar);

    /* ══════════════════════════
       VALIDATION HELPERS
    ══════════════════════════ */
    function showErr(inputEl, errEl, msg) {
      inputEl.classList.add('is-invalid');
      inputEl.classList.remove('is-valid');
      errEl.querySelector('span').textContent = msg;
      errEl.classList.add('show');
    }

    function clearErr(inputEl, errEl) {
      inputEl.classList.remove('is-invalid');
      errEl.classList.remove('show');
    }

    function markValid(inputEl) {
      inputEl.classList.add('is-valid');
      inputEl.classList.remove('is-invalid');
    }

    /* ── RULES ── */
    const rules = {
     name: {
  el: document.getElementById('nameField'),
  errEl: document.getElementById('nameErr'),
  validate(val) {
    if (!val.trim()) return 'Recipient name is required.';
    if (val.trim().length < 2) return 'Name must be at least 2 characters.';
    if (val.trim().length > 60) return 'Name must not exceed 60 characters.';
    if (!/^[a-zA-Z\s'-]+$/.test(val.trim())) return 'Name can only contain letters, spaces, hyphens or apostrophes.';
    return null;
  }
},
      street: {
        el: document.getElementById('streetField'),
        errEl: document.getElementById('streetErr'),
        validate(val) {
          if (!val.trim()) return 'Street address is required.';
          if (val.trim().length < 5) return 'Please enter a valid street address.';
          if (val.trim().length > 120) return 'Address is too long (max 120 chars).';
          return null;
        }
      },
      city: {
        el: document.getElementById('cityField'),
        errEl: document.getElementById('cityErr'),
        validate(val) {
          if (!val.trim()) return 'City is required.';
          if (val.trim().length < 2) return 'Enter a valid city name.';
          if (!/^[a-zA-Z\s\-'.]+$/.test(val.trim())) return 'City name contains invalid characters.';
          return null;
        }
      },
     state: {
  el: document.getElementById('stateField'),
  errEl: document.getElementById('stateErr'),
  validate(val) {
    if (!val.trim()) return 'State/Province is required.';
    if (val.trim().length < 2) return 'Enter a valid state name.';
    if (!/^[a-zA-Z\s\-'.]+$/.test(val.trim())) return 'State name contains invalid characters.';
    return null;
  }
},
      zip: {
        el: document.getElementById('zipField'),
        errEl: document.getElementById('zipErr'),
        validate(val) {
          if (!val.trim()) return 'ZIP/Postal code is required.';
          // Accepts Indian PIN (6 digits), US ZIP (5 or 5+4), alphanumeric (UK, CA etc.)
          if (!/^[a-zA-Z0-9\s\-]{3,10}$/.test(val.trim())) return 'Enter a valid ZIP/postal code (3–10 chars).';
          return null;
        }
      },
      phone: {
        el: document.getElementById('phoneField'),
        errEl: document.getElementById('phoneErr'),
        validate(val) {
          if (!val.trim()) return 'Phone number is required.';
          // Strip spaces, dashes, parens, plus for digit check
          const digits = val.replace(/[\s\-().+]/g, '');
          if (!/^\d+$/.test(digits)) return 'Phone number can only contain digits, spaces, +, -, ().';
          if (digits.length < 7 || digits.length > 15) return 'Phone number must be 7–15 digits.';
          return null;
        }
      }
    };

    /* Run a single field validation, return true if valid */
    function validateField(key) {
      const { el, errEl, validate } = rules[key];
      const msg = validate(el.value);
      if (msg) { showErr(el, errEl, msg); return false; }
      clearErr(el, errEl);
      markValid(el);
      return true;
    }

    /* Live validation on blur + input */
    Object.keys(rules).forEach(key => {
      const { el } = rules[key];
      el.addEventListener('blur', () => validateField(key));
      el.addEventListener('input', () => {
        // Only clear error live; re-validate on blur
        if (el.classList.contains('is-invalid')) validateField(key);
      });
    });

    /* ── PHONE: allow only valid phone chars while typing ── */
    document.getElementById('phoneField').addEventListener('keypress', e => {
      if (!/[\d\s\+\-\(\).]/.test(e.key) && !['Backspace','Delete','ArrowLeft','ArrowRight','Tab'].includes(e.key)) {
        e.preventDefault();
      }
    });

    /* ── ZIP: allow only alphanumeric + space + hyphen ── */
    document.getElementById('zipField').addEventListener('keypress', e => {
      if (!/[a-zA-Z0-9\s\-]/.test(e.key) && !['Backspace','Delete','ArrowLeft','ArrowRight','Tab'].includes(e.key)) {
        e.preventDefault();
      }
    });

    document.getElementById('nameField').addEventListener('keypress', e => {
  if (!/[a-zA-Z\s]/.test(e.key) && !['Backspace','Delete','ArrowLeft','ArrowRight','Tab'].includes(e.key)) {
    e.preventDefault();
  }
});

/* ── STATE: allow only letters and spaces while typing ── */
document.getElementById('stateField').addEventListener('keypress', e => {
  if (!/[a-zA-Z\s]/.test(e.key) && !['Backspace','Delete','ArrowLeft','ArrowRight','Tab'].includes(e.key)) {
    e.preventDefault();
  }
});

    /* ══════════════════════════
       FORM SUBMIT
    ══════════════════════════ */
    document.getElementById('editAddressForm').addEventListener('submit', function(e) {
      let valid = true;
      Object.keys(rules).forEach(key => {
        if (!validateField(key)) valid = false;
      });

      if (!valid) {
        e.preventDefault();
        // Scroll to first error
        const firstErr = this.querySelector('.hh-input.is-invalid');
        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      // If valid, form submits normally with the original action
    });
  </script>
</body>
