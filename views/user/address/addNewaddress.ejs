<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Helmet Haven - Add New Address</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
  <style>
    :root { --bg-main:#0d1117; --bg-card:#161b22; --bg-input:#0d1117; --border-color:#2a3240; --text-primary:#e6edf3; --text-muted:#8b949e; --text-label:#4a5a72; --accent-blue:#1f6feb; --accent-blue-hover:#388bfd; --danger-color:#f85149; }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: var(--bg-main); color: var(--text-primary); font-family: 'Segoe UI', system-ui, sans-serif; font-size: 14px; min-height: 100vh; display: flex; flex-direction: column; }

    /* ── NAVBAR ── */
    .navbar-custom { background-color: var(--bg-main); border-bottom: 1px solid var(--border-color); padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; position: sticky; top: 0; z-index: 100; }
    .navbar-left { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .navbar-brand-text { font-weight: 700; font-size: 18px; color: var(--text-primary); display: flex; align-items: center; gap: 8px; text-decoration: none; white-space: nowrap; }
    .navbar-brand-text .brand-icon { color: var(--accent-blue); font-size: 22px; }
    .navbar-links { display: flex; flex-wrap: wrap; gap: 2px; }
    .nav-link-custom { color: var(--text-primary); font-size: 14px; padding: 6px 14px; text-decoration: none; white-space: nowrap; }
    .nav-link-custom:hover { color: var(--accent-blue); }
    .search-wrapper { position: relative; flex: 1; min-width: 180px; max-width: 320px; }
    .search-wrapper .si { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 14px; }
    .search-input { background-color: #161b22; border: 1px solid var(--border-color); color: var(--text-muted); border-radius: 20px; padding: 7px 16px 7px 34px; font-size: 13px; width: 100%; outline: none; }
    .search-input:focus { border-color: var(--accent-blue); }
    .search-input::placeholder { color: var(--text-muted); }
    .navbar-right { display: flex; align-items: center; gap: 8px; }

    /* ── NAV ICON BUTTON ── */
    .icon-btn { background: #161b22; border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 8px; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; font-size: 16px; position: relative; cursor: pointer; text-decoration: none; flex-shrink: 0; transition: border-color .2s, color .2s; }
    .icon-btn:hover { border-color: var(--accent-blue); color: var(--accent-blue); }

    /* ── NAVBAR BADGE ── */
    .icon-btn .nbadge { position: absolute; top: -5px; right: -5px; background: var(--accent-blue); color: #fff; font-size: 9px; border-radius: 10px; padding: 1px 5px; font-weight: 700; border: 1px solid var(--bg-main); pointer-events: none; }

    .navbar-toggle { display: none; background: #161b22; border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 6px; width: 38px; height: 38px; align-items: center; justify-content: center; font-size: 18px; cursor: pointer; flex-shrink: 0; }

    /* ── LAYOUT ── */
    .page-wrapper { display: flex; flex: 1; }

    /* ── SIDEBAR ── */
    .sidebar { width: 248px; min-width: 248px; background: var(--bg-main); border-right: 1px solid var(--border-color); padding: 28px 0; flex-shrink: 0; }
    .sidebar-heading { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 15px; padding: 0 20px 22px; color: var(--text-primary); }
    .sidebar-heading i { color: var(--accent-blue); font-size: 18px; }
    .sidebar-item { display: flex; align-items: center; gap: 12px; padding: 11px 20px; color: var(--text-primary); text-decoration: none; font-size: 14px; border-left: 3px solid transparent; transition: background .15s, color .15s; }
    .sidebar-item:hover { background: var(--bg-card); color: var(--accent-blue); }
    .sidebar-item.active { background: var(--bg-card); color: var(--accent-blue); border-left-color: var(--accent-blue); }
    .sidebar-item i { font-size: 15px; width: 18px; text-align: center; }
    .sidebar-divider { border-top: 1px solid var(--border-color); margin: 12px 0; }
    .sidebar-item.logout { color: var(--danger-color); }
    .sidebar-item.logout:hover { background: rgba(248,81,73,0.08); }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 199; }
    .sidebar-overlay.active { display: block; }

    /* ── MAIN ── */
    .main-content { flex: 1; padding: 28px 44px 44px; background: var(--bg-main); min-width: 0; }
    .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent-blue); font-size: 13px; text-decoration: none; margin-bottom: 18px; }
    .back-link:hover { color: var(--accent-blue-hover); }
    .page-title { font-size: 28px; font-weight: 800; color: var(--text-primary); margin-bottom: 5px; }
    .page-subtitle { color: var(--text-muted); font-size: 13px; margin-bottom: 26px; }
    .form-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 32px 36px 36px; }
    .field-label { display: block; font-size: 11px; font-weight: 600; letter-spacing: .09em; color: var(--text-label); text-transform: uppercase; margin-bottom: 8px; }
    .form-control-custom { background: var(--bg-input); border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-primary); font-size: 14px; padding: 12px 14px; width: 100%; outline: none; transition: border-color .15s; }
    .form-control-custom:focus { border-color: var(--accent-blue); }
    .form-control-custom::placeholder { color: var(--text-muted); }
    .form-control-custom.is-invalid { border-color: var(--danger-color) !important; }
    .err-msg { display: none; color: var(--danger-color); font-size: 11.5px; margin-top: 5px; }
    .err-msg.visible { display: block; }
    .checkbox-row { display: flex; align-items: center; gap: 10px; margin-top: 20px; margin-bottom: 28px; }
    .custom-checkbox { width: 17px; height: 17px; border: 2px solid var(--border-color); border-radius: 4px; background: var(--bg-input); cursor: pointer; appearance: none; -webkit-appearance: none; flex-shrink: 0; }
    .custom-checkbox:checked { background: var(--accent-blue); border-color: var(--accent-blue); }
    .checkbox-label { font-size: 14px; color: var(--text-primary); cursor: pointer; }
    .btn-save { background: var(--accent-blue); color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; padding: 13px 32px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: background .15s; white-space: nowrap; }
    .btn-save:hover { background: var(--accent-blue-hover); }
    .btn-cancel-addr { background: transparent; border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 8px; font-size: 14px; font-weight: 500; padding: 13px 28px; cursor: pointer; transition: border-color .2s, background .2s; white-space: nowrap; }
    .btn-cancel-addr:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
    .mb-form { margin-bottom: 18px; }

    /* ── FOOTER ── */
    footer { background: var(--bg-main); border-top: 1px solid var(--border-color); padding: 44px 40px 20px; }
    .footer-brand { font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .footer-brand i { color: var(--accent-blue); }
    .footer-desc { color: var(--text-muted); font-size: 12.5px; max-width: 200px; line-height: 1.6; }
    .footer-heading { font-size: 13px; font-weight: 600; color: var(--text-primary); margin-bottom: 14px; }
    .footer-link { display: block; color: var(--text-muted); text-decoration: none; font-size: 12.5px; margin-bottom: 8px; }
    .footer-link:hover { color: var(--accent-blue); }
    .footer-input { background: var(--bg-input); border: 1px solid var(--border-color); border-radius: 6px 0 0 6px; color: var(--text-primary); font-size: 13px; padding: 8px 12px; outline: none; flex: 1; min-width: 0; }
    .footer-input:focus { border-color: var(--accent-blue); }
    .footer-input::placeholder { color: var(--text-muted); }
    .footer-input.input-error { border-color: var(--danger-color); }
    .btn-join { background: var(--accent-blue); color: #fff; border: none; border-radius: 0 6px 6px 0; padding: 8px 16px; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .btn-join:hover { background: var(--accent-blue-hover); }
    .footer-bottom { border-top: 1px solid var(--border-color); margin-top: 30px; padding-top: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
    .footer-bottom-text { color: var(--text-muted); font-size: 12px; }
    .footer-bottom-link { color: var(--text-muted); font-size: 12px; text-decoration: none; }
    .footer-bottom-link:hover { color: var(--text-primary); }

    /* Toast */
    .toast-container { position: fixed; top: 70px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 8px; }
    .toast-msg { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px 18px; color: var(--text-primary); font-size: 13px; display: flex; align-items: center; gap: 10px; animation: slideIn .3s ease; min-width: 240px; }
    .toast-msg.error { border-left: 3px solid var(--danger-color); }
    @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    /* ── RESPONSIVE ── */
    @media (max-width: 991px) { .navbar-links { display: none; } .navbar-toggle { display: flex; } .search-wrapper { max-width: 100%; } .sidebar { position: fixed; left: -260px; top: 0; height: 100vh; z-index: 200; transition: left .25s ease; overflow-y: auto; padding-top: 60px; width: 248px; } .sidebar.open { left: 0; } .main-content { padding: 24px 20px 36px; } .form-card { padding: 24px 20px 28px; } footer { padding: 36px 20px 16px; } .page-title { font-size: 22px; } }
    @media (max-width: 767px) { .navbar-custom { padding: 10px 14px; } .search-wrapper { order: 3; flex-basis: 100%; max-width: 100%; } .main-content { padding: 18px 14px 32px; } .form-card { padding: 20px 16px 24px; } footer { padding: 28px 14px 14px; } .footer-desc { max-width: 100%; } .d-flex.gap-3.btn-row { flex-direction: column; } .btn-save, .btn-cancel-addr { width: 100%; justify-content: center; } }
    @media (max-width: 480px) { .page-title { font-size: 19px; } }
  </style>
</head>
<body>

<%
  const _cartCount     = typeof cartCount     !== 'undefined' ? cartCount     : 0;
  const _wishlistCount = typeof wishlistCount !== 'undefined' ? wishlistCount : 0;
%>

<div class="toast-container" id="toastContainer"></div>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- ── NAVBAR ── -->
<nav class="navbar-custom">
  <div class="navbar-left">
    <button class="navbar-toggle" onclick="toggleSidebar()" aria-label="Menu">
      <i class="bi bi-list"></i>
    </button>
    <a class="navbar-brand-text" href="/user/homepage">
      <i class="bi bi-shield-fill brand-icon"></i> Helmet Haven
    </a>
    <div class="navbar-links">
      <a href="/user/homepage" class="nav-link-custom">Home</a>
      <a href="#" class="nav-link-custom">About Us</a>
      <a href="#" class="nav-link-custom">Contact Us</a>
    </div>
  </div>

  <div class="search-wrapper">
    <i class="bi bi-search si"></i>
    <input type="text" class="search-input" placeholder="Search premium helmets..."/>
  </div>

  <div class="navbar-right">

    <!-- ✅ CART badge from res.locals -->
    <a href="/user/cart" class="icon-btn" aria-label="Cart">
      <i class="bi bi-cart2"></i>
      <% if (_cartCount > 0) { %>
        <span class="nbadge" id="cartBadge"><%= _cartCount %></span>
      <% } else { %>
        <span class="nbadge" id="cartBadge" style="display:none">0</span>
      <% } %>
    </a>

    <!-- ✅ WISHLIST badge from res.locals -->
    <a href="/user/wishlist" class="icon-btn" aria-label="Wishlist">
      <i class="bi bi-heart"></i>
      <% if (_wishlistCount > 0) { %>
        <span class="nbadge" id="wishlistBadge"><%= _wishlistCount %></span>
      <% } else { %>
        <span class="nbadge" id="wishlistBadge" style="display:none">0</span>
      <% } %>
    </a>

    <a href="/user/profileinformation" class="icon-btn" aria-label="Profile">
      <i class="bi bi-person-fill"></i>
    </a>

  </div>
</nav>
<!-- ── END NAVBAR ── -->

<div class="page-wrapper">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-heading"><i class="bi bi-person-circle"></i> My Account</div>
    <a href="/user/profileinformation" class="sidebar-item"><i class="bi bi-person"></i> Profile Info</a>
    <a href="#" class="sidebar-item"><i class="bi bi-bag"></i> My Orders</a>
    <a href="/user/address/addressPage" class="sidebar-item active"><i class="bi bi-geo-alt-fill"></i> Address</a>
    <a href="#" class="sidebar-item"><i class="bi bi-wallet2"></i> Wallet</a>
    <a href="#" class="sidebar-item"><i class="bi bi-scissors"></i> Coupon</a>
    <a href="/user/passwordChange" class="sidebar-item"><i class="bi bi-shield-lock"></i> Password Change</a>
    <div class="sidebar-divider"></div>
    <a href="/user/logout" class="sidebar-item logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
  </aside>

  <main class="main-content">
    <a href="/user/address/addressPage" class="back-link"><i class="bi bi-arrow-left"></i> Back to Addresses</a>
    <h1 class="page-title">Add New Address</h1>
    <p class="page-subtitle">Provide your shipping details for faster checkout.</p>

    <div class="form-card">
      <form action="/user/addNewaddress" method="POST" id="addressForm" novalidate>

    <input
        type="hidden"
        name="redirect"
        value="<%= redirect || '' %>"
    >

        <div class="mb-form">
          <label class="field-label" for="name">Recipient Name</label>
          <input type="text" name="name" id="name" class="form-control-custom" placeholder="" oninput="clearErr('name'); this.value=this.value.replace(/[^A-Za-z\s]/g,'')"/>
          <span class="err-msg" id="err-name"></span>
        </div>

        <div class="mb-form">
          <label class="field-label" for="street">Street Address</label>
          <input type="text" name="street" id="street" class="form-control-custom" placeholder="" oninput="clearErr('street')"/>
          <span class="err-msg" id="err-street"></span>
        </div>

        <div class="mb-form">
          <label class="field-label" for="apartment">Apartment / Suite (Optional)</label>
          <input type="text" name="apartment" id="" class="form-control-custom" placeholder=""/>
        </div>

        <div class="row g-3 mb-form">
          <div class="col-6">
            <label class="field-label" for="city">City</label>
            <input type="text" name="city" id="city" class="form-control-custom" placeholder="" oninput="clearErr('city')"/>
            <span class="err-msg" id="err-city"></span>
          </div>
          <div class="col-6">
            <label class="field-label" for="state">State / Province</label>
            <input type="text" name="state" id="state" class="form-control-custom" placeholder="" oninput="clearErr('state'); this.value=this.value.replace(/[^A-Za-z\s]/g,'')"/>
            <span class="err-msg" id="err-state"></span>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-6">
            <label class="field-label" for="zip">Zip / Postal Code</label>
            <input type="text" name="zip" id="zip" class="form-control-custom" placeholder="" maxlength="6" oninput="clearErr('zip'); this.value=this.value.replace(/[^0-9]/g,'')"/>
            <span class="err-msg" id="err-zip"></span>
          </div>
          <div class="col-6">
            <label class="field-label" for="phone">Phone Number</label>
            <input type="tel" name="phone" id="phone" class="form-control-custom" placeholder="" maxlength="10" oninput="clearErr('phone'); this.value=this.value.replace(/[^0-9+\-\s]/g,'')"/>
            <span class="err-msg" id="err-phone"></span>

          </div>
        </div>

        <div class="checkbox-row">
          <input type="checkbox" class="custom-checkbox" id="primaryCheck" name="isDefault"/>
          <label class="checkbox-label" for="primaryCheck">Set as Default Address</label>
        </div>

        <div class="d-flex gap-3 btn-row">
          <button type="submit" class="btn-save"><i class="bi bi-floppy"></i> Save Address</button>
          <button type="button" class="btn-cancel-addr" onclick="window.location.href='/user/address/addressPage'">Cancel</button>
        </div>

      </form>
    </div>
  </main>
</div>

<!-- ── FOOTER ── -->
<footer>
  <div class="row g-4">
    <div class="col-lg-3 col-sm-6 col-12">
      <div class="footer-brand"><i class="bi bi-shield-fill"></i> Helmet Haven</div>
      <p class="footer-desc">The world's premier destination for high-end safety and performance headgear.</p>
    </div>
    <div class="col-lg-2 col-sm-6 col-6 offset-lg-1">
      <p class="footer-heading">Shop</p>
      <a href="#" class="footer-link">Full Face</a><a href="#" class="footer-link">Off-Road</a><a href="#" class="footer-link">Modular</a><a href="#" class="footer-link">Accessories</a>
    </div>
    <div class="col-lg-2 col-sm-6 col-6">
      <p class="footer-heading">Support</p>
      <a href="#" class="footer-link">Shipping Policy</a><a href="#" class="footer-link">Return &amp; Exchange</a><a href="#" class="footer-link">Size Guide</a><a href="#" class="footer-link">FAQ</a>
    </div>
    <div class="col-lg-3 col-sm-6 col-12">
      <p class="footer-heading">Newsletter</p>
      <p style="color:var(--text-muted);font-size:12.5px;margin-bottom:12px;">Get early access to drops and exclusive offers.</p>
      <div class="d-flex">
        <input type="email" class="footer-input" id="newsletterEmail" placeholder="Email address"/>
        <button class="btn-join" onclick="handleNewsletter()">Join</button>
      </div>
      <small id="newsletterError" style="color:var(--danger-color);font-size:11px;display:none;margin-top:5px;"></small>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-bottom-text">© 2024 Helmet Haven. All rights reserved.</span>
    <div class="d-flex gap-3 flex-wrap"><a href="#" class="footer-bottom-link">Privacy Policy</a><a href="#" class="footer-bottom-link">Terms of Service</a></div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function toggleSidebar() { document.getElementById('sidebar').classList.toggle('open'); document.getElementById('sidebarOverlay').classList.toggle('active'); }
  function closeSidebar()  { document.getElementById('sidebar').classList.remove('open'); document.getElementById('sidebarOverlay').classList.remove('active'); }

  function setErr(id, msg) { const el=document.getElementById(id); const err=document.getElementById('err-'+id); if(el) el.classList.add('is-invalid'); if(err){ err.textContent=msg; err.classList.add('visible'); } }
  function clearErr(id) { const el=document.getElementById(id); const err=document.getElementById('err-'+id); if(el) el.classList.remove('is-invalid'); if(err){ err.textContent=''; err.classList.remove('visible'); } }

  document.getElementById('addressForm').addEventListener('submit', function(e) {
    e.preventDefault(); let valid = true;
    const name=document.getElementById('name').value.trim();
    const street=document.getElementById('street').value.trim();
    const city=document.getElementById('city').value.trim();
    const state=document.getElementById('state').value.trim();
    const zip=document.getElementById('zip').value.trim();
    const phone=document.getElementById('phone').value.trim();
    if (!name) { setErr('name','Recipient name is required.'); valid=false; } else if (name.length < 2) { setErr('name','Name must be at least 2 characters.'); valid=false; } else if (!/^[a-zA-Z\s.'-]+$/.test(name)) { setErr('name','Name can only contain letters and spaces.'); valid=false; }
    if (!street) { setErr('street','Street address is required.'); valid=false; } else if (street.length < 5) { setErr('street','Please enter a complete street address.'); valid=false; }
    if (!city) { setErr('city','City is required.'); valid=false; } else if (!/^[a-zA-Z\s\-]+$/.test(city)) { setErr('city','City name is not valid.'); valid=false; }
    if (!state) { setErr('state','State is required.'); valid=false; } else if (!/^[a-zA-Z\s\-]+$/.test(state)) { setErr('state','State name is not valid.'); valid=false; }
    if (!zip) { setErr('zip','Zip/Postal code is required.'); valid=false; } else if (!/^\d{4,10}$/.test(zip)) { setErr('zip','Enter a valid zip code (4–10 digits).'); valid=false; }
    const digitsOnly=phone.replace(/[\s\-]/g,'');
    if (!phone) { setErr('phone','Phone number is required.'); valid=false; } else if (!/^\+?\d{7,15}$/.test(digitsOnly)) { setErr('phone','Enter a valid phone number (7–15 digits).'); valid=false; }
    if (!valid) { const firstErr=document.querySelector('.form-control-custom.is-invalid'); if(firstErr) firstErr.scrollIntoView({behavior:'smooth',block:'center'}); return; }
    this.submit();
  });

  function handleNewsletter() {
    const input=document.getElementById('newsletterEmail'); const errEl=document.getElementById('newsletterError'); const val=input.value.trim();
    input.classList.remove('input-error'); errEl.style.display='none';
    if (!val) { input.classList.add('input-error'); errEl.textContent='Please enter your email address.'; errEl.style.display='block'; return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) { input.classList.add('input-error'); errEl.textContent='Please enter a valid email address.'; errEl.style.display='block'; return; }
    input.value=''; errEl.style.color='#3fb950'; errEl.textContent='✓ Subscribed successfully!'; errEl.style.display='block';
    setTimeout(()=>{ errEl.style.display='none'; errEl.style.color='var(--danger-color)'; }, 3000);
  }
  document.getElementById('newsletterEmail').addEventListener('keydown', function(e){ if(e.key==='Enter') handleNewsletter(); });
</script>
</body>
</html>