<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Helmet Haven - Change Password</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>

  <style>
    :root {
      --bg-main: #0d1117;
      --bg-sidebar: #0d1117;
      --bg-card: #161b22;
      --bg-input: #0d1117;
      --border-color: #2a3240;
      --text-primary: #e6edf3;
      --text-muted: #8b949e;
      --accent-blue: #1f6feb;
      --accent-blue-hover: #388bfd;
      --sidebar-active-bg: #161b22;
      --sidebar-active-text: #1f6feb;
      --danger-color: #f85149;
      --success-color: #3fb950;
      --warning-color: #d29922;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-main);
      color: var(--text-primary);
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 14px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── NAVBAR ── */
    .navbar-custom { background-color: #0d1117; border-bottom: 1px solid var(--border-color); padding: 10px 16px; position: sticky; top: 0; z-index: 1000; }
    .navbar-inner  { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .navbar-left   { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
    .navbar-brand-text { font-weight: 700; font-size: 18px; color: var(--text-primary) !important; display: flex; align-items: center; gap: 8px; text-decoration: none; white-space: nowrap; }
    .navbar-brand-text i { color: var(--accent-blue); font-size: 20px; }
    .nav-links { display: flex; gap: 2px; }
    .nav-link-custom { color: var(--text-primary) !important; font-size: 14px; padding: 6px 10px !important; text-decoration: none; white-space: nowrap; }
    .nav-link-custom:hover { color: var(--accent-blue) !important; }
    .search-input { background-color: #161b22; border: 1px solid var(--border-color); color: var(--text-muted); border-radius: 6px; padding: 6px 14px 6px 36px; font-size: 13px; width: 100%; max-width: 320px; min-width: 120px; outline: none; }
    .search-input:focus { border-color: var(--accent-blue); }
    .search-input::placeholder { color: var(--text-muted); }
    .search-wrapper { position: relative; flex: 1; max-width: 320px; }
    .search-wrapper i { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 14px; }
    .navbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .icon-btn { background: #161b22; border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 8px; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; font-size: 17px; position: relative; cursor: pointer; text-decoration: none; flex-shrink: 0; }
    .icon-btn:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
    .badge-dot { position: absolute; top: -4px; right: -4px; background: var(--accent-blue); color: #fff; font-size: 9px; border-radius: 10px; padding: 1px 5px; font-weight: 700; border: 1px solid var(--bg-main); }
    .hamburger-btn { display: none; background: #161b22; border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 8px; width: 38px; height: 38px; align-items: center; justify-content: center; font-size: 18px; cursor: pointer; flex-shrink: 0; }

    /* ── LAYOUT ── */
    .page-wrapper { display: flex; flex: 1; min-height: 0; }

    /* ── SIDEBAR ── */
    .sidebar { width: 240px; min-width: 240px; background: var(--bg-sidebar); border-right: 1px solid var(--border-color); padding: 24px 0; transition: transform 0.3s ease; }
    .sidebar-heading { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 15px; padding: 0 20px 20px; color: var(--text-primary); }
    .sidebar-heading i { color: var(--accent-blue); font-size: 18px; }
    .sidebar-item { display: flex; align-items: center; gap: 12px; padding: 11px 20px; color: var(--text-primary); text-decoration: none; font-size: 14px; cursor: pointer; border-left: 3px solid transparent; transition: background 0.15s, color 0.15s; white-space: nowrap; }
    .sidebar-item:hover { background: var(--bg-card); color: var(--accent-blue); }
    .sidebar-item.active { background: var(--bg-card); color: var(--accent-blue); border-left-color: var(--accent-blue); }
    .sidebar-item i { font-size: 16px; width: 18px; text-align: center; }
    .sidebar-divider { border-top: 1px solid var(--border-color); margin: 12px 0; }
    .sidebar-item.logout { color: var(--danger-color); }
    .sidebar-item.logout:hover { background: rgba(248,81,73,0.08); color: var(--danger-color); }
    .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 900; }

    /* ── MAIN CONTENT ── */
    .main-content { flex: 1; padding: 32px 28px; background: var(--bg-main); overflow-x: hidden; min-width: 0; }
    .page-title { font-size: 22px; font-weight: 500; color: var(--text-primary); margin-bottom: 4px; }
    .page-subtitle { color: var(--text-muted); font-size: 13px; margin-bottom: 24px; }

    /* ── CARD ── */
    .profile-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 28px 24px 24px; max-width: 600px; }

    /* ── FORM FIELDS ── */
    .form-label-custom { color: var(--text-muted); font-size: 13px; margin-bottom: 6px; display: block; }
    
    .input-wrapper { position: relative; }
    .form-control-custom {
      background: var(--bg-input);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: var(--text-primary);
      font-size: 14px;
      padding: 10px 44px 10px 14px;
      width: 100%;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      font-family: inherit;
    }
    .form-control-custom:focus { border-color: var(--accent-blue); box-shadow: 0 0 0 3px rgba(31,111,235,0.12); }
    .form-control-custom::placeholder { color: #3a4455; }
    .form-control-custom.is-valid { border-color: var(--success-color); }
    .form-control-custom.is-invalid { border-color: var(--danger-color); }

    /* toggle eye button */
    .toggle-eye {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: var(--text-muted); cursor: pointer;
      font-size: 16px; padding: 0; line-height: 1; transition: color 0.15s;
    }
    .toggle-eye:hover { color: var(--text-primary); }

    /* field status icon */
    .field-status {
      position: absolute; right: 38px; top: 50%; transform: translateY(-50%);
      font-size: 14px; pointer-events: none; opacity: 0; transition: opacity 0.2s;
    }
    .field-status.show { opacity: 1; }
    .field-status.valid { color: var(--success-color); }
    .field-status.invalid { color: var(--danger-color); }

    /* feedback text */
    .field-feedback {
      font-size: 12px; margin-top: 5px; display: flex; align-items: center; gap: 5px;
      min-height: 18px; transition: all 0.2s;
    }
    .field-feedback.error { color: var(--danger-color); }
    .field-feedback.success { color: var(--success-color); }
    .field-feedback.hint { color: var(--text-muted); }

    /* ── STRENGTH BAR ── */
    .strength-wrap { margin-top: 10px; }
    .strength-label { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); margin-bottom: 5px; }
    .strength-label span { font-weight: 600; transition: color 0.3s; }
    .strength-track { height: 4px; background: var(--border-color); border-radius: 4px; overflow: hidden; }
    .strength-bar {
      height: 100%; width: 0%; border-radius: 4px;
      transition: width 0.4s ease, background-color 0.3s ease;
    }
    .strength-bar.weak   { background: var(--danger-color); }
    .strength-bar.fair   { background: var(--warning-color); }
    .strength-bar.good   { background: #58a6ff; }
    .strength-bar.strong { background: var(--success-color); }

    /* ── REQUIREMENTS CHECKLIST ── */
    .req-list { margin-top: 12px; display: grid; grid-template-columns: 1fr 1fr; gap: 5px 12px; }
    .req-item { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-muted); transition: color 0.2s; }
    .req-item i { font-size: 12px; transition: color 0.2s; }
    .req-item.met { color: var(--success-color); }
    .req-item.met i { color: var(--success-color); }
    .req-item.unmet i { color: var(--border-color); }

    /* ── SECTION DIVIDER ── */
    .section-divider { border-top: 1px solid var(--border-color); margin: 24px 0; }

    /* ── LOCK ICON HEADER ── */
    .card-icon-header {
      display: flex; align-items: center; gap: 14px; margin-bottom: 28px;
      padding-bottom: 20px; border-bottom: 1px solid var(--border-color);
    }
    .icon-circle {
      width: 48px; height: 48px; border-radius: 12px;
      background: rgba(31,111,235,0.12); border: 1px solid rgba(31,111,235,0.25);
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; color: var(--accent-blue); flex-shrink: 0;
    }
    .card-icon-header-text h3 { font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
    .card-icon-header-text p  { font-size: 12.5px; color: var(--text-muted); }

    /* ── BUTTONS ── */
    .btn-save {
      background: var(--accent-blue); color: #fff; border: none;
      border-radius: 8px; font-size: 14px; font-weight: 700;
      padding: 11px 28px; cursor: pointer; transition: background 0.15s, transform 0.1s;
      display: inline-flex; align-items: center; gap: 7px;
    }
    .btn-save:hover { background: var(--accent-blue-hover); }
    .btn-save:active { transform: scale(0.98); }
    .btn-save:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    .btn-reset {
      background: transparent; border: 1px solid var(--border-color);
      color: var(--text-muted); border-radius: 8px; font-size: 14px;
      padding: 11px 20px; cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
      display: inline-flex; align-items: center; gap: 7px;
    }
    .btn-reset:hover { border-color: var(--text-muted); color: var(--text-primary); }

    /* ── SUCCESS BANNER ── */
    .success-banner {
      display: none; align-items: center; gap: 12px;
      background: rgba(63,185,80,0.1); border: 1px solid rgba(63,185,80,0.3);
      border-radius: 10px; padding: 14px 18px; margin-bottom: 22px;
      animation: slideIn 0.3s ease;
    }
    .success-banner.show { display: flex; }
    .success-banner i { font-size: 20px; color: var(--success-color); flex-shrink: 0; }
    .success-banner-text strong { display: block; font-size: 14px; color: var(--success-color); }
    .success-banner-text span { font-size: 12px; color: var(--text-muted); }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── TOAST ── */
    .toast-container { position: fixed; bottom: 24px; right: 24px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; }
    .toast-msg {
      background: var(--bg-card); border: 1px solid var(--border-color);
      border-radius: 10px; padding: 14px 18px;
      display: flex; align-items: center; gap: 12px;
      font-size: 13px; color: var(--text-primary);
      box-shadow: 0 8px 32px rgba(0,0,0,0.5);
      animation: toastIn 0.3s ease;
      min-width: 260px; max-width: 340px;
    }
    .toast-msg.error  { border-color: rgba(248,81,73,0.4); }
    .toast-msg.success { border-color: rgba(63,185,80,0.4); }
    .toast-msg i { font-size: 18px; flex-shrink: 0; }
    .toast-msg.error i { color: var(--danger-color); }
    .toast-msg.success i { color: var(--success-color); }
    @keyframes toastIn { from { opacity:0; transform: translateX(20px); } to { opacity:1; transform: translateX(0); } }

    /* ── FOOTER ── */
    footer { background: var(--bg-main); border-top: 1px solid var(--border-color); padding: 36px 20px 20px; }
    .footer-brand { font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .footer-brand i { color: var(--accent-blue); }
    .footer-desc { color: var(--text-muted); font-size: 12.5px; max-width: 220px; line-height: 1.6; }
    .footer-heading { font-size: 13px; font-weight: 600; color: var(--text-primary); margin-bottom: 14px; }
    .footer-link { display: block; color: var(--text-muted); text-decoration: none; font-size: 12.5px; margin-bottom: 8px; transition: color 0.15s; }
    .footer-link:hover { color: var(--accent-blue); }
    .footer-input { background: var(--bg-input); border: 1px solid var(--border-color); border-radius: 6px 0 0 6px; color: var(--text-primary); font-size: 13px; padding: 8px 12px; outline: none; flex: 1; min-width: 0; }
    .footer-input:focus { border-color: var(--accent-blue); }
    .footer-input::placeholder { color: var(--text-muted); }
    .btn-join { background: var(--accent-blue); color: #fff; border: none; border-radius: 0 6px 6px 0; padding: 8px 16px; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .btn-join:hover { background: var(--accent-blue-hover); }
    .footer-newsletter-row { display: flex; width: 100%; max-width: 280px; }
    .footer-bottom { border-top: 1px solid var(--border-color); margin-top: 30px; padding-top: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }
    .footer-bottom-text { color: var(--text-muted); font-size: 12px; }
    .footer-bottom-link { color: var(--text-muted); font-size: 12px; text-decoration: none; }
    .footer-bottom-link:hover { color: var(--text-primary); }

    /* ── RESPONSIVE ── */
    @media (max-width: 992px) { .sidebar { width: 200px; min-width: 200px; } .sidebar-item { font-size: 13px; padding: 10px 14px; gap: 10px; } .main-content { padding: 24px 20px; } }
    @media (max-width: 768px) {
      .hamburger-btn { display: flex; }
      .nav-links { display: none; }
      .sidebar { position: fixed; top: 0; left: 0; height: 100%; z-index: 950; transform: translateX(-100%); width: 240px; min-width: 240px; padding-top: 60px; }
      .sidebar.open { transform: translateX(0); }
      .sidebar-overlay.open { display: block; }
      .main-content { padding: 20px 16px; }
      .profile-card { padding: 20px 16px; }
      .req-list { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .navbar-brand-text { font-size: 16px; }
      .search-wrapper { display: none; }
      .page-title { font-size: 18px; }
      .btn-save { padding: 10px 20px; font-size: 13px; }
      .footer-desc { max-width: 100%; }
      .footer-bottom { flex-direction: column; align-items: flex-start; }
      .toast-container { bottom: 16px; right: 12px; left: 12px; }
      .toast-msg { min-width: unset; max-width: 100%; }
    }
    @media (max-width: 360px) { .main-content { padding: 16px 12px; } .profile-card { padding: 16px 12px; } .navbar-custom { padding: 8px 12px; } }
  </style>
</head>
<body>

  <!-- SIDEBAR OVERLAY -->
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

  <!-- ── NAVBAR ── -->
  <nav class="navbar-custom">
    <div class="navbar-inner">
      <div class="navbar-left">
        <button class="hamburger-btn" id="hamburgerBtn" onclick="toggleSidebar()" aria-label="Menu">
          <i class="bi bi-list"></i>
        </button>
        <a class="navbar-brand-text" href="#"><i class="bi bi-shield-fill"></i> Helmet Haven</a>
        <div class="nav-links">
          <a href="/user/homepage" class="nav-link-custom">Home</a>
          <a href="#" class="nav-link-custom">About Us</a>
          <a href="#" class="nav-link-custom">Contact Us</a>
        </div>
      </div>
      <div class="search-wrapper">
        <i class="bi bi-search"></i>
        <input type="text" class="search-input" placeholder="Search premium helmets..."/>
      </div>
      <div class="navbar-right">
        <a href="#" class="icon-btn"><i class="bi bi-cart2"></i><span class="badge-dot">2</span></a>
        <a href="#" class="icon-btn"><i class="bi bi-heart"></i></a>
        <a href="#" class="icon-btn"><i class="bi bi-person"></i></a>
      </div>
    </div>
  </nav>

  <!-- ── PAGE BODY ── -->
  <div class="page-wrapper">

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-heading"><i class="bi bi-person-circle"></i> My Account</div>
      <a href="/user/profileinformation" class="sidebar-item"><i class="bi bi-person"></i> Profile Info</a>
      <a href="#" class="sidebar-item"><i class="bi bi-bag"></i> My Orders</a>
      <a href="/user/address/addressPage" class="sidebar-item"><i class="bi bi-geo-alt"></i> Address</a>
      <a href="#" class="sidebar-item"><i class="bi bi-wallet2"></i> Wallet</a>
      <a href="#" class="sidebar-item"><i class="bi bi-scissors"></i> Coupon</a>
      <a href="#" class="sidebar-item active"><i class="bi bi-lock"></i> Password Change</a>
      <div class="sidebar-divider"></div>
      <a href="/user/logout" class="sidebar-item logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </aside>

    <!-- MAIN -->
    <main class="main-content">
      <h1 class="page-title">Password Change</h1>
      <p class="page-subtitle">Keep your account secure by updating your password regularly.</p>

      <!-- Success banner -->
      <div class="success-banner" id="successBanner">
        <i class="bi bi-shield-check-fill"></i>
        <div class="success-banner-text">
          <strong>Password updated successfully!</strong>
          <span>Your account is now protected with the new password.</span>
        </div>
      </div>

      <div class="profile-card">

        <!-- Card header -->
        <div class="card-icon-header">
          <div class="icon-circle"><i class="bi bi-lock-fill"></i></div>
          <div class="card-icon-header-text">
            <h3>Update Password</h3>
            <p>Enter your current password, then choose a strong new one.</p>
          </div>
        </div>

        <form id="passwordForm" novalidate autocomplete="off">

          <!-- Current Password -->
          <div class="mb-4">
            <label class="form-label-custom" for="currentPassword">Current Password</label>
            <div class="input-wrapper">
              <input type="password" id="currentPassword" name="currentPassword"
                class="form-control-custom" placeholder="Enter your current password"
                autocomplete="current-password" oninput="validateCurrent()">
              <span class="field-status" id="statusCurrent"></span>
              <button type="button" class="toggle-eye" onclick="toggleVisibility('currentPassword', this)" aria-label="Toggle visibility">
                <i class="bi bi-eye"></i>
              </button>
            </div>
            <div class="field-feedback hint" id="feedbackCurrent">
              <i class="bi bi-info-circle" style="font-size:11px;"></i> Required to verify your identity
            </div>
          </div>

          <div class="section-divider"></div>

          <!-- New Password -->
          <div class="mb-3">
            <label class="form-label-custom" for="newPassword">New Password</label>
            <div class="input-wrapper">
              <input type="password" id="newPassword" name="newPassword"
                class="form-control-custom" placeholder="Create a strong new password"
                autocomplete="new-password" oninput="validateNew()">
              <span class="field-status" id="statusNew"></span>
              <button type="button" class="toggle-eye" onclick="toggleVisibility('newPassword', this)" aria-label="Toggle visibility">
                <i class="bi bi-eye"></i>
              </button>
            </div>

            <!-- Strength meter -->
            <div class="strength-wrap" id="strengthWrap" style="display:none;">
              <div class="strength-label">
                <span>Password Strength</span>
                <span id="strengthText" style="color: var(--text-muted)">—</span>
              </div>
              <div class="strength-track">
                <div class="strength-bar" id="strengthBar"></div>
              </div>
            </div>

            <!-- Requirements checklist -->
            <div class="req-list" id="reqList" style="display:none;">
              <div class="req-item unmet" id="req-len"><i class="bi bi-circle"></i> At least 8 characters</div>
              <div class="req-item unmet" id="req-upper"><i class="bi bi-circle"></i> Uppercase letter</div>
              <div class="req-item unmet" id="req-lower"><i class="bi bi-circle"></i> Lowercase letter</div>
              <div class="req-item unmet" id="req-num"><i class="bi bi-circle"></i> Number</div>
              <div class="req-item unmet" id="req-special"><i class="bi bi-circle"></i> Special character</div>
              <div class="req-item unmet" id="req-diff"><i class="bi bi-circle"></i> Different from current</div>
            </div>

            <div class="field-feedback" id="feedbackNew" style="min-height:0;"></div>
          </div>

          <!-- Confirm Password -->
          <div class="mb-4 mt-3">
            <label class="form-label-custom" for="confirmPassword">Confirm New Password</label>
            <div class="input-wrapper">
              <input type="password" id="confirmPassword" name="confirmPassword"
                class="form-control-custom" placeholder="Re-enter your new password"
                autocomplete="new-password" oninput="validateConfirm()">
              <span class="field-status" id="statusConfirm"></span>
              <button type="button" class="toggle-eye" onclick="toggleVisibility('confirmPassword', this)" aria-label="Toggle visibility">
                <i class="bi bi-eye"></i>
              </button>
            </div>
            <div class="field-feedback" id="feedbackConfirm" style="min-height:0;"></div>
          </div>

          <!-- Action buttons -->
          <div class="d-flex align-items-center gap-3 flex-wrap mt-2">
            <button type="submit" class="btn-save" id="btnSave" disabled>
              <i class="bi bi-shield-lock-fill"></i> Update Password
            </button>
            <button type="button" class="btn-reset" onclick="resetForm()">
              <i class="bi bi-arrow-counterclockwise"></i> Reset
            </button>
          </div>

        </form>
      </div>
    </main>
  </div>

  <!-- ── TOAST CONTAINER ── -->
  <div class="toast-container" id="toastContainer"></div>

  <!-- ── FOOTER ── -->
  <footer>
    <div class="row g-4">
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="footer-brand"><i class="bi bi-shield-fill"></i> Helmet Haven</div>
        <p class="footer-desc">The world's premier destination for high-end safety and performance headgear. Trusted by professionals, loved by enthusiasts.</p>
      </div>
      <div class="col-6 col-sm-3 col-lg-2">
        <p class="footer-heading">Shop</p>
        <a href="#" class="footer-link">Full Face</a>
        <a href="#" class="footer-link">Off-Road</a>
        <a href="#" class="footer-link">Modular</a>
        <a href="#" class="footer-link">Accessories</a>
      </div>
      <div class="col-6 col-sm-3 col-lg-2">
        <p class="footer-heading">Support</p>
        <a href="#" class="footer-link">Shipping Policy</a>
        <a href="#" class="footer-link">Return &amp; Exchange</a>
        <a href="#" class="footer-link">Size Guide</a>
        <a href="#" class="footer-link">FAQ</a>
      </div>
      <div class="col-12 col-sm-6 col-lg-3">
        <p class="footer-heading">Newsletter</p>
        <p class="footer-desc mb-3">Get early access to drops and exclusive offers.</p>
        <div class="footer-newsletter-row">
          <input type="email" class="footer-input" placeholder="Email address"/>
          <button class="btn-join">Join</button>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="footer-bottom-text">© 2024 Helmet Haven. All rights reserved.</span>
      <div class="d-flex gap-3 flex-wrap">
        <a href="#" class="footer-bottom-link">Privacy Policy</a>
        <a href="#" class="footer-bottom-link">Terms of Service</a>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>

    /* ── Sidebar ── */
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('open');
      document.getElementById('sidebarOverlay').classList.toggle('open');
    }
    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('sidebarOverlay').classList.remove('open');
    }

    /* ── Toggle password visibility ── */
    function toggleVisibility(fieldId, btn) {
      const input = document.getElementById(fieldId);
      const icon  = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('bi-eye', 'bi-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.replace('bi-eye-slash', 'bi-eye');
      }
    }

    /* ── State tracking ── */
    const state = { currentOk: false, newOk: false, confirmOk: false };

    /* ─────────────────────────────────────────
       CURRENT PASSWORD VALIDATION
    ───────────────────────────────────────── */
    function validateCurrent() {
      const val      = document.getElementById('currentPassword').value;
      const input    = document.getElementById('currentPassword');
      const feedback = document.getElementById('feedbackCurrent');
      const status   = document.getElementById('statusCurrent');

      if (val === '') {
        setField(input, status, feedback, '', 'hint', '<i class="bi bi-info-circle" style="font-size:11px;"></i> Required to verify your identity', false);
        state.currentOk = false;
      } else if (val.length < 6) {
        setField(input, status, feedback, 'invalid', 'error', '<i class="bi bi-x-circle"></i> Password too short', false);
        state.currentOk = false;
      } else {
        setField(input, status, feedback, 'valid', 'success', '<i class="bi bi-check-circle"></i> Looks good', true);
        state.currentOk = true;
      }
      updateSaveBtn();
      // Re-validate "different from current" req
      if (document.getElementById('newPassword').value) validateNew();
    }

    /* ─────────────────────────────────────────
       NEW PASSWORD VALIDATION + STRENGTH METER
    ───────────────────────────────────────── */
    function validateNew() {
      const val         = document.getElementById('newPassword').value;
      const currentVal  = document.getElementById('currentPassword').value;
      const input       = document.getElementById('newPassword');
      const feedback    = document.getElementById('feedbackNew');
      const status      = document.getElementById('statusNew');
      const strengthWrap = document.getElementById('strengthWrap');
      const reqList      = document.getElementById('reqList');

      if (val === '') {
        strengthWrap.style.display = 'none';
        reqList.style.display = 'none';
        setField(input, status, feedback, '', '', '', false);
        state.newOk = false;
        updateSaveBtn();
        return;
      }

      strengthWrap.style.display = 'block';
      reqList.style.display = 'grid';

      // Requirements
      const reqs = {
        len:     val.length >= 8,
        upper:   /[A-Z]/.test(val),
        lower:   /[a-z]/.test(val),
        num:     /[0-9]/.test(val),
        special: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?`~]/.test(val),
        diff:    val !== currentVal || currentVal === ''
      };

      updateReq('req-len',     reqs.len);
      updateReq('req-upper',   reqs.upper);
      updateReq('req-lower',   reqs.lower);
      updateReq('req-num',     reqs.num);
      updateReq('req-special', reqs.special);
      updateReq('req-diff',    reqs.diff);

      const score = Object.values(reqs).filter(Boolean).length;
      updateStrength(score);

      const allMet = Object.values(reqs).every(Boolean);

      if (!reqs.diff && currentVal !== '') {
        setField(input, status, feedback, 'invalid', 'error', '<i class="bi bi-x-circle"></i> New password must differ from current password', false);
        state.newOk = false;
      } else if (!allMet) {
        setField(input, status, feedback, 'invalid', 'error', '<i class="bi bi-x-circle"></i> Password does not meet all requirements', false);
        state.newOk = false;
      } else {
        setField(input, status, feedback, 'valid', 'success', '<i class="bi bi-check-circle"></i> Strong password!', true);
        state.newOk = true;
      }

      updateSaveBtn();
      if (document.getElementById('confirmPassword').value) validateConfirm();
    }

    function updateReq(id, met) {
      const el   = document.getElementById(id);
      const icon = el.querySelector('i');
      if (met) {
        el.classList.add('met');
        el.classList.remove('unmet');
        icon.className = 'bi bi-check-circle-fill';
      } else {
        el.classList.remove('met');
        el.classList.add('unmet');
        icon.className = 'bi bi-circle';
      }
    }

    function updateStrength(score) {
      const bar  = document.getElementById('strengthBar');
      const text = document.getElementById('strengthText');
      const levels = [
        { pct: '0%',   cls: '',       label: '—',      color: 'var(--text-muted)' },
        { pct: '20%',  cls: 'weak',   label: 'Weak',   color: 'var(--danger-color)' },
        { pct: '40%',  cls: 'weak',   label: 'Weak',   color: 'var(--danger-color)' },
        { pct: '60%',  cls: 'fair',   label: 'Fair',   color: 'var(--warning-color)' },
        { pct: '80%',  cls: 'good',   label: 'Good',   color: '#58a6ff' },
        { pct: '100%', cls: 'strong', label: 'Strong', color: 'var(--success-color)' },
        { pct: '100%', cls: 'strong', label: 'Strong', color: 'var(--success-color)' },
      ];
      const lv = levels[Math.min(score, 6)];
      bar.style.width     = lv.pct;
      bar.className       = 'strength-bar ' + lv.cls;
      text.textContent    = lv.label;
      text.style.color    = lv.color;
    }

    /* ─────────────────────────────────────────
       CONFIRM PASSWORD VALIDATION
    ───────────────────────────────────────── */
    function validateConfirm() {
      const val      = document.getElementById('confirmPassword').value;
      const newVal   = document.getElementById('newPassword').value;
      const input    = document.getElementById('confirmPassword');
      const feedback = document.getElementById('feedbackConfirm');
      const status   = document.getElementById('statusConfirm');

      if (val === '') {
        setField(input, status, feedback, '', '', '', false);
        state.confirmOk = false;
      } else if (val !== newVal) {
        setField(input, status, feedback, 'invalid', 'error', '<i class="bi bi-x-circle"></i> Passwords do not match', false);
        state.confirmOk = false;
      } else {
        setField(input, status, feedback, 'valid', 'success', '<i class="bi bi-check-circle"></i> Passwords match', true);
        state.confirmOk = true;
      }
      updateSaveBtn();
    }

    /* ── Helpers ── */
    function setField(input, statusEl, feedbackEl, validity, feedbackClass, feedbackHTML, ok) {
      input.classList.remove('is-valid', 'is-invalid');
      if (validity === 'valid')   input.classList.add('is-valid');
      if (validity === 'invalid') input.classList.add('is-invalid');

      statusEl.className   = 'field-status' + (validity ? ' show ' + validity : '');
      statusEl.innerHTML   = validity === 'valid'   ? '<i class="bi bi-check-circle-fill"></i>'
                           : validity === 'invalid' ? '<i class="bi bi-x-circle-fill"></i>' : '';

      feedbackEl.className = 'field-feedback ' + feedbackClass;
      feedbackEl.innerHTML = feedbackHTML;
    }

    function updateSaveBtn() {
      document.getElementById('btnSave').disabled = !(state.currentOk && state.newOk && state.confirmOk);
    }

    /* ── Form Submit ── */
    document.getElementById('passwordForm').addEventListener('submit', async function(e) {
      e.preventDefault();

      // Final guard
      validateCurrent();
      validateNew();
      validateConfirm();
      if (!(state.currentOk && state.newOk && state.confirmOk)) return;

      const btn = document.getElementById('btnSave');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Updating…';

      try {
        const res = await fetch('/user/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            currentPassword: document.getElementById('currentPassword').value,
            newPassword:     document.getElementById('newPassword').value,
            confirmPassword: document.getElementById('confirmPassword').value
          })
        });
        const data = await res.json();

        if (data.success) {
          showToast('success', 'bi-shield-check-fill', 'Password updated successfully!');
          document.getElementById('successBanner').classList.add('show');
          resetForm();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          showToast('error', 'bi-exclamation-triangle-fill', data.message || 'Incorrect current password.');
          // Mark current password as wrong
          const input    = document.getElementById('currentPassword');
          const feedback = document.getElementById('feedbackCurrent');
          const status   = document.getElementById('statusCurrent');
          setField(input, status, feedback, 'invalid', 'error', '<i class="bi bi-x-circle"></i> ' + (data.message || 'Incorrect password'), false);
          state.currentOk = false;
          updateSaveBtn();
        }
      } catch (err) {
        showToast('error', 'bi-wifi-off', 'Network error. Please try again.');
      } finally {
        btn.innerHTML = '<i class="bi bi-shield-lock-fill"></i> Update Password';
        updateSaveBtn();
      }
    });

    /* ── Reset Form ── */
    function resetForm() {
      document.getElementById('passwordForm').reset();
      ['currentPassword', 'newPassword', 'confirmPassword'].forEach(id => {
        const input = document.getElementById(id);
        input.classList.remove('is-valid', 'is-invalid');
        input.type = 'password';
        // reset eye icons
        const btn = input.parentElement.querySelector('.toggle-eye i');
        if (btn) { btn.classList.remove('bi-eye-slash'); btn.classList.add('bi-eye'); }
      });
      ['statusCurrent','statusNew','statusConfirm'].forEach(id => {
        const el = document.getElementById(id);
        el.className = 'field-status'; el.innerHTML = '';
      });
      document.getElementById('feedbackCurrent').className = 'field-feedback hint';
      document.getElementById('feedbackCurrent').innerHTML = '<i class="bi bi-info-circle" style="font-size:11px;"></i> Required to verify your identity';
      document.getElementById('feedbackNew').innerHTML = '';
      document.getElementById('feedbackConfirm').innerHTML = '';
      document.getElementById('strengthWrap').style.display = 'none';
      document.getElementById('reqList').style.display = 'none';
      document.getElementById('strengthBar').style.width = '0%';
      document.getElementById('strengthBar').className = 'strength-bar';
      ['req-len','req-upper','req-lower','req-num','req-special','req-diff'].forEach(id => updateReq(id, false));
      state.currentOk = false; state.newOk = false; state.confirmOk = false;
      updateSaveBtn();
    }

    /* ── Toast ── */
    function showToast(type, icon, message) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = 'toast-msg ' + type;
      toast.innerHTML = `<i class="bi ${icon}"></i><span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(20px)';
        setTimeout(() => toast.remove(), 400);
      }, 3500);
    }

    /* ── Keyboard ── */
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeSidebar();
    });
  </script>
</body>
</html>