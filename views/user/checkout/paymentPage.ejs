<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Helmet Haven – Secure Payment</title>
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:       #0d1117;
      --bg2:      #161b24;
      --bg3:      #1e2535;
      --border:   #2a3347;
      --accent:   #2d9cff;
      --accent2:  #0a78e8;
      --danger:   #ff4757;
      --success:  #2ecc71;
      --text:     #e8edf5;
      --muted:    #7a8ba3;
      --price:    #2d9cff;
      --radius:   12px;
      --shadow:   0 4px 24px rgba(0,0,0,.45);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg); color: var(--text);
      font-family: 'DM Sans', sans-serif; font-size: 15px;
      line-height: 1.6; min-height: 100vh;
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

    .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 20px; }

    /* ── NAVBAR ── */
    .navbar {
      position: sticky; top: 0; z-index: 100;
      background: rgba(13,17,23,.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .navbar-inner {
      display: flex; align-items: center; gap: 16px;
      padding: 14px 20px; max-width: 1200px; margin: 0 auto;
    }
    .brand {
      display: flex; align-items: center; gap: 8px;
      font-family: 'Rajdhani', sans-serif; font-size: 1.4rem; font-weight: 700;
      color: var(--text); text-decoration: none; flex-shrink: 0;
    }
    .brand-icon {
      width: 32px; height: 32px; background: var(--accent);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
    }
    .brand-icon svg { width: 18px; height: 18px; fill: #fff; }
    .nav-links { display: flex; gap: 24px; list-style: none; }
    .nav-links a { color: var(--muted); text-decoration: none; font-size: .9rem; transition: color .2s; }
    .nav-links a:hover { color: var(--text); }
    .search-wrap { flex: 1; max-width: 440px; position: relative; margin: 0 auto; }
    .search-wrap input {
      width: 100%; background: var(--bg3);
      border: 1px solid var(--border); border-radius: 8px;
      padding: 8px 16px 8px 38px;
      color: var(--text); font-size: .875rem; outline: none;
      transition: border-color .2s;
    }
    .search-wrap input::placeholder { color: var(--muted); }
    .search-wrap input:focus { border-color: var(--accent); }
    .search-wrap svg {
      position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
      width: 16px; height: 16px; stroke: var(--muted); pointer-events: none;
    }

    /* ── NAV ICONS ── */
    .nav-icons { display: flex; align-items: center; gap: 8px; margin-left: auto; }

    .icon-btn {
      position: relative;
      background: none; border: none; cursor: pointer;
      padding: 8px; border-radius: 8px;
      color: var(--muted); text-decoration: none;
      display: flex; align-items: center; justify-content: center;
      transition: color .2s, background .2s;
    }
    .icon-btn:hover { color: var(--text); background: var(--bg3); }
    .icon-btn svg { width: 20px; height: 20px; }

    .icon-btn .badge {
      position: absolute; top: 3px; right: 3px;
      background: var(--accent); color: #fff;
      font-size: .6rem; font-weight: 700;
      border-radius: 50%; width: 16px; height: 16px;
      display: flex; align-items: center; justify-content: center;
      pointer-events: none;
    }

    .hamburger {
      display: none; flex-direction: column; gap: 5px;
      background: none; border: none; cursor: pointer; padding: 6px;
    }
    .hamburger span {
      display: block; width: 22px; height: 2px;
      background: var(--muted); border-radius: 2px;
      transition: transform .3s, opacity .3s;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .mobile-menu {
      display: none; flex-direction: column;
      background: var(--bg2); border-bottom: 1px solid var(--border);
      padding: 16px 20px; gap: 12px;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a { color: var(--muted); text-decoration: none; font-size: .95rem; }
    .mobile-menu a:hover { color: var(--text); }

    /* ── BREADCRUMB ── */
    .breadcrumb {
      padding: 16px 0 4px; font-size: .8rem; color: var(--muted);
      display: flex; align-items: center; gap: 6px;
    }
    .breadcrumb a { color: var(--muted); text-decoration: none; }
    .breadcrumb a:hover { color: var(--accent); }
    .breadcrumb span { color: var(--text); font-weight: 500; }

    /* ── PAGE HEADING ── */
    .page-heading { padding: 12px 0 6px; }
    .heading-row { display: flex; align-items: center; gap: 10px; }
    .heading-row h1 {
      font-family: 'Rajdhani', sans-serif;
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      font-weight: 700;
    }
    .heading-row svg { width: 22px; height: 22px; stroke: var(--success); flex-shrink: 0; }
    .page-heading p { color: var(--muted); font-size: .9rem; margin-top: 6px; margin-bottom: 20px; }

    /* ── LAYOUT (reuses cart/checkout grid) ── */
    .cart-layout { display: grid; grid-template-columns: 1fr 340px; gap: 28px; align-items: start; padding-bottom: 60px; }
    .left-col { display: flex; flex-direction: column; gap: 24px; }

    .card {
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 24px;
    }

    /* ── STEP TITLE ── */
    .step-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; gap: 12px; flex-wrap: wrap; }
    .step-title-left { display: flex; align-items: center; gap: 12px; }
    .step-num {
      width: 28px; height: 28px; border-radius: 50%;
      background: var(--accent); color: #fff; font-size: .8rem; font-weight: 700;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      font-family: 'Rajdhani', sans-serif;
    }
    .step-title h2 { font-family: 'Rajdhani', sans-serif; font-size: 1.2rem; font-weight: 700; }
    .change-link { color: var(--accent); font-size: .85rem; font-weight: 600; text-decoration: none; }
    .change-link:hover { text-decoration: underline; }

    /* ── SHIPPING ADDRESS DISPLAY ── */
    .shipping-box {
      display: flex; gap: 14px; align-items: flex-start;
      background: var(--bg3); border: 1px solid var(--border); border-radius: 10px; padding: 18px 20px;
    }
    .shipping-box svg { width: 18px; height: 18px; stroke: var(--accent); flex-shrink: 0; margin-top: 2px; }
    .shipping-name { font-family: 'Rajdhani', sans-serif; font-size: 1.05rem; font-weight: 600; margin-bottom: 8px; }
    .shipping-detail { font-size: .85rem; color: var(--muted); line-height: 1.8; }
    .no-address { color: var(--muted); font-size: .9rem; }

    /* ── PAYMENT METHODS ── */
    .payment-options { display: flex; flex-direction: column; gap: 14px; }
    .payment-option {
      position: relative; display: flex; align-items: center; gap: 16px;
      background: var(--bg3); border: 1px solid var(--border); border-radius: 10px;
      padding: 16px 20px; cursor: pointer; transition: border-color .2s, background .2s;
    }
    .payment-option:hover { border-color: var(--accent2); }
    .payment-option.selected { border-color: var(--accent); background: rgba(45,156,255,.07); }
    .payment-option input[type="radio"] {
      width: 18px; height: 18px; accent-color: var(--accent); cursor: pointer; flex-shrink: 0;
    }
    .payment-option-text { flex: 1; }
    .payment-option-title { font-family: 'Rajdhani', sans-serif; font-size: 1.02rem; font-weight: 600; color: var(--text); }
    .payment-option-sub { font-size: .8rem; color: var(--muted); margin-top: 2px; }
    .payment-option-icons { display: flex; gap: 8px; flex-shrink: 0; }
    .payment-option-icons .icon-chip {
      width: 34px; height: 30px; border-radius: 6px; background: var(--bg2);
      border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;
    }
    .payment-option-icons svg { width: 16px; height: 16px; stroke: var(--muted); }

    /* ── ORDER SUMMARY (reused from checkout) ── */
    .order-summary { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; position: sticky; top: 80px; }
    .summary-title { font-family: 'Rajdhani', sans-serif; font-size: 1.25rem; font-weight: 700; margin-bottom: 18px; }

    .summary-product-list { display: flex; flex-direction: column; gap: 14px; margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border); max-height: 260px; overflow-y: auto; }
    .summary-product { display: flex; gap: 12px; align-items: center; }
    .summary-product img, .summary-product .img-ph {
      width: 52px; height: 52px; border-radius: 8px; object-fit: contain;
      background: var(--bg3); border: 1px solid var(--border); flex-shrink: 0;
    }
    .summary-product .img-ph { display: flex; align-items: center; justify-content: center; }
    .summary-product-name { font-family: 'Rajdhani', sans-serif; font-size: .95rem; font-weight: 600; line-height: 1.3; }
    .summary-product-variant { font-size: .75rem; color: var(--muted); margin: 2px 0 4px; }
    .summary-product-price { font-family: 'Rajdhani', sans-serif; font-size: .9rem; font-weight: 700; color: var(--price); }

    .summary-row { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; font-size: .9rem; }
    .summary-row + .summary-row { border-top: 1px solid var(--border); }
    .summary-label { color: var(--muted); }
    .summary-value { font-weight: 500; }
    .summary-value.free { color: var(--success); font-weight: 600; }
    .summary-value.discount { color: var(--success); font-weight: 600; }
    .summary-total { border-top: 2px solid var(--border) !important; margin-top: 4px; }
    .summary-total .summary-label { font-weight: 700; font-size: 1rem; color: var(--text); font-family: 'Rajdhani', sans-serif; }
    .summary-total .summary-value { font-family: 'Rajdhani', sans-serif; font-size: 1.5rem; font-weight: 700; color: var(--accent); }

    .pay-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%; padding: 14px 20px; margin-top: 18px;
      background: var(--accent); color: #fff; border: none; border-radius: 10px;
      font-family: 'Rajdhani', sans-serif; font-size: 1.1rem; font-weight: 700;
      letter-spacing: .5px; cursor: pointer;
      transition: background .2s, transform .15s, box-shadow .2s;
      box-shadow: 0 4px 20px rgba(45,156,255,.3);
    }
    .pay-btn:hover { background: var(--accent2); transform: translateY(-1px); box-shadow: 0 6px 24px rgba(45,156,255,.45); }
    .pay-btn:active { transform: translateY(0); }
    .pay-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }
    .pay-btn svg { width: 18px; height: 18px; }
    .secure-note {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      font-size: .75rem; color: var(--muted); margin-top: 12px;
      text-transform: uppercase; letter-spacing: .08em;
    }
    .secure-note svg { width: 13px; height: 13px; stroke: var(--muted); }

    /* ── FOOTER ── */
    footer { margin-top: 20px; background: var(--bg2); border-top: 1px solid var(--border); padding: 48px 20px 28px; }
    .footer-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: 32px; }
    .footer-brand { display: flex; flex-direction: column; gap: 12px; }
    .footer-logo { display: flex; align-items: center; gap: 8px; font-family: 'Rajdhani', sans-serif; font-size: 1.2rem; font-weight: 700; }
    .footer-desc { color: var(--muted); font-size: .85rem; line-height: 1.7; }
    .footer-col h4 { font-family: 'Rajdhani', sans-serif; font-weight: 600; font-size: 1rem; margin-bottom: 14px; color: var(--text); }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .footer-col ul a { color: var(--muted); text-decoration: none; font-size: .875rem; transition: color .2s; }
    .footer-col ul a:hover { color: var(--accent); }
    .newsletter-row { display: flex; gap: 8px; margin-top: 4px; }
    .newsletter-input {
      flex: 1; background: var(--bg3); border: 1px solid var(--border);
      border-radius: 8px; padding: 9px 12px; color: var(--text);
      font-size: .85rem; outline: none; transition: border-color .2s;
    }
    .newsletter-input::placeholder { color: var(--muted); }
    .newsletter-input:focus { border-color: var(--accent); }
    .newsletter-input.error { border-color: var(--danger); }
    .newsletter-feedback { font-size: .75rem; margin-top: 4px; min-height: 14px; }
    .newsletter-feedback.ok { color: var(--success); }
    .newsletter-feedback.err { color: var(--danger); }
    .join-btn { background: var(--accent); color: #fff; border: none; border-radius: 8px; padding: 9px 18px; font-size: .85rem; font-weight: 600; cursor: pointer; transition: background .2s; }
    .join-btn:hover { background: var(--accent2); }
    .footer-bottom { max-width: 1200px; margin: 32px auto 0; border-top: 1px solid var(--border); padding-top: 20px; display: flex; justify-content: space-between; align-items: center; font-size: .78rem; color: var(--muted); flex-wrap: wrap; gap: 12px; }
    .footer-links { display: flex; gap: 20px; }
    .footer-links a { color: var(--muted); text-decoration: none; transition: color .2s; }
    .footer-links a:hover { color: var(--accent); }

    /* ── TOAST ── */
    .toast {
      position: fixed; bottom: 24px; right: 24px; z-index: 9999;
      background: var(--bg3); border: 1px solid var(--border);
      border-radius: 10px; padding: 16px 24px;
      font-size: 1rem; color: var(--text);
      box-shadow: 0 8px 32px rgba(0,0,0,.5);
      transform: translateY(80px); opacity: 0;
      transition: transform .3s, opacity .3s;
      max-width: 375px;
    }
    .toast.error { font-weight: 600; border-color: var(--danger); }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.success { border-color: var(--success); }

    /* ── RESPONSIVE ── */
    @media (max-width: 1024px) { .cart-layout { grid-template-columns: 1fr 300px; } .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; } }
    @media (max-width: 860px) {
      .cart-layout { grid-template-columns: 1fr; }
      .order-summary { position: static; }
      .nav-links { display: none; }
      .hamburger { display: flex; }
      .search-wrap { max-width: none; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 600px) {
      .navbar-inner { gap: 10px; }
      .search-wrap { display: none; }
      .card { padding: 18px; }
      .footer-grid { grid-template-columns: 1fr; }
      .footer-bottom { flex-direction: column; align-items: flex-start; }
      .payment-option { flex-wrap: wrap; }
      .payment-option-icons { width: 100%; justify-content: flex-start; margin-left: 34px; }
    }
  </style>
</head>
<body>

<%
  const _cartCount     = typeof cartCount     !== 'undefined' ? cartCount     : 0;
  const _wishlistCount = typeof wishlistCount !== 'undefined' ? wishlistCount : 0;
  const _address       = typeof shippingAddress !== 'undefined' ? shippingAddress : null;
  const _coupon        = typeof coupon !== 'undefined' ? coupon : null; // { code, discount } or null
  const _addressId     = typeof addressId !== 'undefined' ? addressId : (_address ? _address._id : '');
%>

<!-- ── NAVBAR ── -->
<nav class="navbar" role="navigation" aria-label="Main navigation">
  <div class="navbar-inner">

    <a href="/user/homepage" class="brand" aria-label="Helmet Haven home">
      <div class="brand-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9v4l-2 2v1h18v-1l-2-2V9c0-3.87-3.13-7-7-7zm0 20c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2z"/></svg>
      </div>
      Helmet Haven
    </a>

    <ul class="nav-links" role="list">
      <li><a href="/user/homepage">Home</a></li>
      <li><a href="#">About Us</a></li>
      <li><a href="#">Contact Us</a></li>
    </ul>

    <div class="search-wrap" role="search">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
      </svg>
      <input type="search" placeholder="Search premium helmets…" aria-label="Search helmets" autocomplete="off" />
    </div>

    <div class="nav-icons">
      <a href="/user/cart" class="icon-btn" aria-label="Shopping cart">
        <svg fill="none" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2
             2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <% if (_cartCount > 0) { %>
          <span class="badge" id="cartBadge"><%= _cartCount %></span>
        <% } else { %>
          <span class="badge" id="cartBadge" style="display:none">0</span>
        <% } %>
      </a>

      <a href="/user/wishlist" class="icon-btn" aria-label="Wishlist">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 0 1 6.364 0L12 7.636l1.318-1.318a4.5 4.5 0 1 1 6.364 6.364L12 20.364l-7.682-7.682a4.5 4.5 0 0 1 0-6.364z"/>
        </svg>
        <% if (_wishlistCount > 0) { %>
          <span class="badge" id="wishlistBadge"><%= _wishlistCount %></span>
        <% } else { %>
          <span class="badge" id="wishlistBadge" style="display:none">0</span>
        <% } %>
      </a>

      <a href="/user/profileinformation" class="icon-btn" aria-label="Account">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0zM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
        </svg>
      </a>

      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu" role="menu">
    <a href="/user/homepage" role="menuitem">Home</a>
    <a href="#" role="menuitem">About Us</a>
    <a href="#" role="menuitem">Contact Us</a>
    <a href="/user/cart" role="menuitem">Cart (<%= _cartCount %>)</a>
    <a href="/user/wishlist" role="menuitem">Wishlist (<%= _wishlistCount %>)</a>
  </div>
</nav>
<!-- ── END NAVBAR ── -->


<!-- ── MAIN ── -->
<main class="container">
  <nav aria-label="Breadcrumb">
    <div class="breadcrumb">
      <a href="/user/homepage">Home ></a>
      <a href="/user/cart">Cart</a>
      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
      <a href="/user/checkout">Checkout</a>
      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6"/></svg>
      <span>Payment</span>
    </div>
  </nav>

  <div class="page-heading">
    <div class="heading-row">
      <h1>Secure Payment</h1>
      <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <rect x="3" y="11" width="18" height="10" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>
    <p>Select your preferred payment method and complete your order.</p>
  </div>

  <div class="cart-layout">

    <div class="left-col">

      <!-- ── SHIPPING ADDRESS (step 1) ── -->
      <section class="card" aria-label="Shipping address">
        <div class="step-title">
          <div class="step-title-left">
            <span class="step-num">1</span>
            <h2>Shipping Address</h2>
          </div>
          <a href="/user/checkout" class="change-link">Change</a>
        </div>

        <% if (_address) { %>
          <div class="shipping-box">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4.5 8-11a8 8 0 1 0-16 0c0 6.5 8 11 8 11z"/>
              <circle cx="12" cy="11" r="3"/>
            </svg>
            <div>
              <div class="shipping-name"><%= _address.name %></div>
              <div class="shipping-detail">
                <%= [_address.street, _address.apartment].filter(Boolean).join(', ') %><br/>
                <%= [_address.city, _address.state].filter(Boolean).join(', ') %><br/>
                <%= _address.zip %><br/>
                +91 <%= _address.phone %>
              </div>
            </div>
          </div>
        <% } else { %>
          <p class="no-address">No shipping address selected. <a href="/user/checkout" class="change-link">Go back to checkout</a> to choose one.</p>
        <% } %>
      </section>

      <!-- ── PAYMENT METHOD (step 2) ── -->
      <section class="card" aria-label="Payment method">
        <div class="step-title">
          <div class="step-title-left">
            <span class="step-num">2</span>
            <h2>Payment Method</h2>
          </div>
        </div>

        <div class="payment-options" id="paymentOptions">

          <!-- NOTE: your Order schema's paymentMethod enum currently only allows "COD".
               Razorpay / Digital Wallet will need that enum expanded and gateway
               integration added before these options can actually complete an order. -->

          <label class="payment-option selected" data-value="Razorpay">
            <input type="radio" name="paymentMethod" value="Razorpay" checked />
            <div class="payment-option-text">
              <div class="payment-option-title">Razorpay</div>
              <div class="payment-option-sub">Cards, Netbanking, UPI &amp; Wallets</div>
            </div>
            <div class="payment-option-icons">
              <div class="icon-chip">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              </div>
            </div>
          </label>

          <label class="payment-option" data-value="Wallet">
            <input type="radio" name="paymentMethod" value="Wallet" />
            <div class="payment-option-text">
              <div class="payment-option-title">Digital Wallet</div>
              <div class="payment-option-sub">Apple Pay / Google Pay / PayPal</div>
            </div>
            <div class="payment-option-icons">
              <div class="icon-chip">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><rect x="2" y="6" width="18" height="13" rx="2"/><path stroke-linecap="round" d="M16 13h.01"/></svg>
              </div>
              <div class="icon-chip">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><circle cx="12" cy="12" r="9"/></svg>
              </div>
            </div>
          </label>

          <label class="payment-option" data-value="COD">
            <input type="radio" name="paymentMethod" value="COD" />
            <div class="payment-option-text">
              <div class="payment-option-title">Cash on Delivery</div>
              <div class="payment-option-sub">Pay when your helmet arrives</div>
            </div>
            <div class="payment-option-icons">
              <div class="icon-chip">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><rect x="2" y="7" width="20" height="10" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>
              </div>
            </div>
          </label>

        </div>
      </section>

    </div>

    <!-- ── ORDER SUMMARY ── -->
    <aside aria-label="Order summary">
      <div class="order-summary">
        <div class="summary-title">Order Summary</div>

        <%
          let subtotal = 0;
          const availableItems = (cart && cart.items ? cart.items : []).filter(item => {
            const p = item.productId;
            if (!p) return false;
            const variant = p.variants?.find(v => v.size === item.size);
            const stock = variant?.stock ?? 0;
            return stock > 0 && !p.isBlocked && !p.isDeleted;
          });
        %>

        <div class="summary-product-list">
          <% if (availableItems.length > 0) { %>
            <% availableItems.forEach((item) => { %>
              <%
                const p = item.productId;
                const variant = p.variants?.find(v => v.size === item.size);
                const price = variant?.price || 0;
                subtotal += price * item.quantity;
              %>
              <div class="summary-product">
                <% if (p?.productImage?.[0]) { %>
                  <img src="<%= p.productImage[0] %>" alt="<%= p.productName %>"/>
                <% } else { %>
                  <div class="img-ph">
                    <svg width="24" height="24" fill="none" stroke="#3a4a63" stroke-width="1.2" viewBox="0 0 64 64">
                      <ellipse cx="32" cy="28" rx="20" ry="18" stroke-linecap="round"/>
                      <path d="M14 32c0 8.8 8.1 16 18 16s18-7.2 18-16" stroke-linecap="round"/>
                    </svg>
                  </div>
                <% } %>
                <div>
                  <div class="summary-product-name"><%= p?.productName %> <span style="color:var(--muted); font-weight:400;">×<%= item.quantity %></span></div>
                  <div class="summary-product-variant">Size: <%= item.size %></div>
                  <div class="summary-product-price">₹ <%= price.toLocaleString('en-IN') %></div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div style="color: var(--muted); font-size: .85rem; text-align: center; padding: 12px 0;">
              <%= (cart && cart.items && cart.items.length > 0) ? 'None of your cart items are currently available.' : 'Your cart is empty.' %>
            </div>
          <% } %>
        </div>

        <%
          const shipping     = subtotal > 500 ? 0 : 99;
          const tax          = Math.round(subtotal * 0.08);
          const couponAmount = _coupon?.discount || 0;
          const total        = Math.max(subtotal + shipping + tax - couponAmount, 0);
        %>

        <div class="summary-row">
          <span class="summary-label">Subtotal</span>
          <span class="summary-value">₹ <%= subtotal.toLocaleString('en-IN') %></span>
        </div>

        <% if (_coupon && couponAmount > 0) { %>
        <div class="summary-row">
          <span class="summary-label">Coupon Discount</span>
          <span class="summary-value discount">-₹ <%= couponAmount.toLocaleString('en-IN') %></span>
        </div>
        <% } %>

        <div class="summary-row">
          <span class="summary-label">Shipping</span>
          <span class="summary-value <%= shipping === 0 ? 'free' : '' %>">
            <%= shipping === 0 ? 'Free' : '₹ ' + shipping %>
          </span>
        </div>
        <div class="summary-row">
          <span class="summary-label">Estimated Tax</span>
          <span class="summary-value">₹ <%= tax.toLocaleString('en-IN') %></span>
        </div>

        <div class="summary-row summary-total">
          <span class="summary-label">Total</span>
          <span class="summary-value" id="grandTotal">₹ <%= total.toLocaleString('en-IN') %></span>
        </div>

        <input type="hidden" id="addressIdField" value="<%= _addressId %>">

        <button class="pay-btn" id="payBtn" <%= (!_address || availableItems.length === 0) ? 'disabled' : '' %>>
          <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4.5 8-11a8 8 0 1 0-16 0c0 6.5 8 11 8 11z"/>
          </svg>
          Pay Now
        </button>

        <div class="secure-note">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="2">
            <rect x="3" y="11" width="18" height="10" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          SSL Encrypted Secure Checkout
        </div>
      </div>
    </aside>

  </div>
</main>


<!-- ── FOOTER ── -->
<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <div class="footer-logo">
        <div class="brand-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="white" width="16" height="16">
            <path d="M12 2C8.13 2 5 5.13 5 9v4l-2 2v1h18v-1l-2-2V9c0-3.87-3.13-7-7-7zm0 20c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2z"/>
          </svg>
        </div>
        Helmet Haven
      </div>
      <p class="footer-desc">The world's premier destination for high-end safety and performance headgear. Trusted by professionals, loved by enthusiasts.</p>
    </div>
    <div class="footer-col">
      <h4>Shop</h4>
      <ul>
        <li><a href="#">Full Face</a></li>
        <li><a href="#">Off-Road</a></li>
        <li><a href="#">Modular</a></li>
        <li><a href="#">Accessories</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Support</h4>
      <ul>
        <li><a href="#">Shipping Policy</a></li>
        <li><a href="#">Return &amp; Exchange</a></li>
        <li><a href="#">Size Guide</a></li>
        <li><a href="#">FAQ</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Newsletter</h4>
      <p style="color:var(--muted);font-size:.85rem;margin-bottom:10px;">Get early access to drops and exclusive offers.</p>
      <div class="newsletter-row">
        <input type="email" class="newsletter-input" id="newsletterEmail" placeholder="Email address" aria-label="Newsletter email"/>
        <button class="join-btn" id="joinBtn">Join</button>
      </div>
      <div class="newsletter-feedback" id="newsletterFeedback" aria-live="polite"></div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2024 Helmet Haven. All rights reserved.</span>
    <div class="footer-links">
      <a href="#">Privacy Policy</a>
      <a href="#">Terms of Service</a>
    </div>
  </div>
</footer>

<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
  /* ── Toast ── */
  function showToast(msg, type = 'success') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast ' + type + ' show';
    clearTimeout(t._timer);
    t._timer = setTimeout(() => { t.className = 'toast'; }, type === 'error' ? 4500 : 3000);
  }

  /* ── Payment method selection ── */
  let selectedPaymentMethod = document.querySelector('.payment-option.selected')?.dataset.value || 'Razorpay';

  document.querySelectorAll('.payment-option').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('.payment-option').forEach(o => o.classList.remove('selected'));
      opt.classList.add('selected');
      opt.querySelector('input[type="radio"]').checked = true;
      selectedPaymentMethod = opt.dataset.value;
    });
  });

  /* ── Pay Now ── */
  document.getElementById('payBtn').addEventListener('click', async () => {
    const addressId = document.getElementById('addressIdField')?.value;
    if (!addressId) {
      showToast('Missing shipping address. Please go back to checkout.', 'error');
      return;
    }

    const btn = document.getElementById('payBtn');
    btn.disabled = true;
    const originalHTML = btn.innerHTML;
    btn.textContent = 'Processing...';

    try {
      const res = await fetch('/user/place-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ addressId, paymentMethod: selectedPaymentMethod })
      });
      const data = await res.json();

      if (data.success) {
        showToast('Order placed successfully!');
        window.location.href = data.redirectUrl || '/user/order-success';
      } else {
        showToast(data.message || 'Payment failed. Please try again.', 'error');
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      }
    } catch (err) {
      console.log(err);
      showToast('Something went wrong. Please try again.', 'error');
      btn.disabled = false;
      btn.innerHTML = originalHTML;
    }
  });

  /* ── Newsletter ── */
  document.getElementById('joinBtn').addEventListener('click', () => {
    const inp     = document.getElementById('newsletterEmail');
    const fb      = document.getElementById('newsletterFeedback');
    const val     = inp.value.trim();
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!val) {
      inp.classList.add('error'); fb.textContent = 'Please enter your email address.'; fb.className = 'newsletter-feedback err'; return;
    }
    if (!emailRe.test(val)) {
      inp.classList.add('error'); fb.textContent = 'Please enter a valid email address.'; fb.className = 'newsletter-feedback err'; return;
    }
    inp.classList.remove('error'); inp.value = '';
    fb.textContent = "You're in! Welcome to Helmet Haven."; fb.className = 'newsletter-feedback ok';
    showToast('Subscribed successfully!');
  });
  document.getElementById('newsletterEmail').addEventListener('input', () => {
    document.getElementById('newsletterEmail').classList.remove('error');
    const fb = document.getElementById('newsletterFeedback');
    if (fb.classList.contains('err')) { fb.textContent = ''; fb.className = 'newsletter-feedback'; }
  });
  document.getElementById('newsletterEmail').addEventListener('keydown', e => {
    if (e.key === 'Enter') document.getElementById('joinBtn').click();
  });

  /* ── Hamburger ── */
  const ham = document.getElementById('hamburger');
  const mob = document.getElementById('mobileMenu');
  ham.addEventListener('click', () => {
    const open = mob.classList.toggle('open');
    ham.classList.toggle('open', open);
    ham.setAttribute('aria-expanded', open);
  });
</script>
</body>
</html>