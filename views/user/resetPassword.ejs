<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Helmet Haven — Reset Password</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>

  <style>
    :root {
      --bg-dark:   #0d1219;
      --bg-card:   #131a24;
      --bg-input:  #1a2232;
      --accent:    #1d7fea;
      --border:    #1e2d3e;
      --text-muted:#4a5f75;
      --text-body: #8fa3b8;
      --text-white:#eef2f7;
      --error:     #e05c5c;
      --success:   #2eb872;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg-dark);
      font-family: 'Inter', sans-serif;
      color: var(--text-body);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── NAVBAR ── */
    .hh-nav {
      background: var(--bg-dark);
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .brand-icon {
      width: 34px; height: 34px;
      background: var(--accent);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .brand-name {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-white);
    }

    /* ── MAIN ── */
    .hh-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem 1rem 2rem;
    }

    /* ── ICON CIRCLE ── */
    .page-icon-wrap {
      width: 56px; height: 56px;
      background: #182030;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1.5rem;
    }

    /* ── HEADING ── */
    .page-title {
      font-size: clamp(1.4rem, 5vw, 1.9rem);
      font-weight: 700;
      color: var(--text-white);
      text-align: center;
      margin-bottom: 0.55rem;
      letter-spacing: -0.01em;
    }
    .page-sub {
      font-size: clamp(0.8rem, 2.5vw, 0.875rem);
      color: var(--text-muted);
      text-align: center;
      margin-bottom: 2rem;
      padding: 0 1rem;
    }

    /* ── CARD ── */
    .rp-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: clamp(1.2rem, 5vw, 2rem) clamp(1.2rem, 5vw, 2rem) 1.8rem;
      width: 100%;
      max-width: 420px;
    }

    /* ── FORM ── */
    .form-label {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-body);
      display: block;
      margin-bottom: 0.45rem;
    }
    .input-wrap {
      position: relative;
      margin-bottom: 0.35rem;
    }
    .input-icon {
      position: absolute;
      left: 0.95rem;
      top: 50%;
      transform: translateY(-50%);
      color: #3d5068;
      font-size: 1rem;
      pointer-events: none;
      z-index: 1;
    }
    .toggle-pw {
      position: absolute;
      right: 0.95rem;
      top: 50%;
      transform: translateY(-50%);
      color: #3d5068;
      font-size: 1rem;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
      display: flex;
      align-items: center;
      transition: color .2s;
      z-index: 1;
    }
    .toggle-pw:hover { color: var(--text-body); }

    .hh-input {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 9px;
      color: var(--text-white);
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      padding: 0.8rem 2.6rem 0.8rem 2.6rem;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .hh-input::placeholder { color: var(--text-muted); opacity: 0.5; }
    .hh-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(29,127,234,.15);
    }
    .hh-input.is-invalid {
      border-color: var(--error);
      box-shadow: 0 0 0 3px rgba(224,92,92,.12);
    }
    .hh-input.is-valid {
      border-color: var(--success);
      box-shadow: 0 0 0 3px rgba(46,184,114,.12);
    }

    /* ── FIELD ERROR ── */
    .field-error {
      font-size: 0.78rem;
      color: var(--error);
      margin-top: 0.3rem;
      margin-bottom: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      min-height: 1.2rem;
    }
    .field-error.hidden { visibility: hidden; }

    /* ── PASSWORD STRENGTH ── */
    .strength-wrap {
      margin-top: 0.4rem;
      margin-bottom: 0.9rem;
    }
    .strength-bars {
      display: flex;
      gap: 4px;
      margin-bottom: 0.3rem;
    }
    .strength-bar {
      height: 4px;
      flex: 1;
      border-radius: 99px;
      background: var(--border);
      transition: background .3s;
    }
    .strength-bar.weak   { background: var(--error); }
    .strength-bar.fair   { background: #e0913c; }
    .strength-bar.good   { background: #d4c24a; }
    .strength-bar.strong { background: var(--success); }
    .strength-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      transition: color .3s;
    }
    .strength-label.weak   { color: var(--error); }
    .strength-label.fair   { color: #e0913c; }
    .strength-label.good   { color: #d4c24a; }
    .strength-label.strong { color: var(--success); }

    /* ── REQUIREMENTS LIST ── */
    .req-list {
      list-style: none;
      margin: 0.5rem 0 1rem;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.3rem 0.5rem;
    }
    .req-list li {
      font-size: 0.76rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 0.35rem;
      transition: color .2s;
    }
    .req-list li.met { color: var(--success); }
    .req-list li i { font-size: 0.7rem; }

    /* ── UPDATE BUTTON ── */
    .btn-update {
      background: var(--accent);
      border: none;
      border-radius: 9px;
      color: #fff;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      padding: 0.82rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      transition: background .2s, transform .15s, opacity .2s;
      cursor: pointer;
      margin-top: 0.5rem;
      margin-bottom: 1.6rem;
    }
    .btn-update:hover:not(:disabled) { background: #1568c9; transform: translateY(-1px); }
    .btn-update:active:not(:disabled) { transform: translateY(0); }
    .btn-update:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ── DIVIDER ── */
    .divider {
      height: 1px;
      background: var(--border);
      margin-bottom: 1.2rem;
    }

    /* ── HELP TEXT ── */
    .help-text {
      text-align: center;
      font-size: 0.84rem;
      color: var(--text-muted);
    }
    .help-text a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 500;
    }
    .help-text a:hover { text-decoration: underline; }

    /* ── BACK TO LOGIN ── */
    .back-wrap {
      text-align: center;
      margin-top: 1.8rem;
    }
    .back-link {
      font-size: 0.875rem;
      color: var(--text-muted);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: color .2s;
    }
    .back-link:hover { color: var(--text-white); }

    /* ── FOOTER ── */
    .hh-footer {
      border-top: 1px solid var(--border);
      padding: 1.1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .foot-copy {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .foot-links {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .foot-links a {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--text-muted);
      text-decoration: none;
      transition: color .2s;
    }
    .foot-links a:hover { color: var(--text-white); }

    /* ── RESPONSIVE TWEAKS ── */
    @media (max-width: 480px) {
      .hh-footer {
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 1rem;
      }
      .foot-links {
        justify-content: center;
        gap: 1rem;
      }
      .req-list {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 360px) {
      .rp-card {
        border-radius: 10px;
      }
      .hh-input {
        font-size: 0.85rem;
      }
    }

    /* ── SUCCESS STATE ── */
    .success-box {
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 1.5rem 1rem;
    }
    .success-icon {
      width: 56px; height: 56px;
      background: rgba(46,184,114,0.12);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1rem;
    }
    .success-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-white);
      margin-bottom: 0.4rem;
    }
    .success-sub {
      font-size: 0.83rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="hh-nav">
    <div class="brand-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2C8.5 2 5.5 4.5 5 8H4a2 2 0 0 0-2 2v1a2 2 0 0 0 2 2h.27A7 7 0 0 0 12 18a7 7 0 0 0 7.73-5H20a2 2 0 0 0 2-2v-1a2 2 0 0 0-2-2h-1C18.5 4.5 15.5 2 12 2zm0 2c2.76 0 5 2.24 5 5H7c0-2.76 2.24-5 5-5zm-7 7h14v1a5 5 0 0 1-10 0H5v-1z"/>
      </svg>
    </div>
    <span class="brand-name">Helmet Haven</span>
  </nav>

  <!-- MAIN -->
  <main class="hh-main">

    <!-- Page icon -->
    <div class="page-icon-wrap">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9 13V9.5C9 6.46 18.5 6.46 18.5 9.5V13" stroke="#1d7fea" stroke-width="1.6" stroke-linecap="round" fill="none"/>
        <rect x="6.5" y="13" width="12" height="9" rx="2" stroke="#1d7fea" stroke-width="1.6" fill="rgba(29,127,234,0.15)"/>
        <circle cx="12.5" cy="17" r="1.2" fill="#1d7fea"/>
        <rect x="11.8" y="17" width="1.4" height="2" rx="0.7" fill="#1d7fea"/>
        <path d="M20 5.5 C23 5.5 25.5 8 25.5 11 C25.5 14 23 16.5 20 16.5" stroke="#1d7fea" stroke-width="1.6" stroke-linecap="round" fill="none"/>
        <polyline points="18,3.5 20,5.5 18,7.5" fill="none" stroke="#1d7fea" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <!-- Title -->
    <h1 class="page-title">Reset Password</h1>
    <p class="page-sub">Please enter your new security credentials below.</p>

    <!-- Card -->
    <div class="rp-card">

      <!-- Form section -->
      <div id="form-section">
        <form id="resetForm" action="/auth/resetPassword" method="POST" novalidate>

          <!-- New Password -->
          <label class="form-label" for="password">New Password</label>
          <div class="input-wrap">
            <i class="bi bi-lock input-icon"></i>
            <input type="password" id="password" name="password" class="hh-input" placeholder="Min. 8 characters" autocomplete="new-password"/>
            <button type="button" class="toggle-pw" aria-label="Toggle password visibility" onclick="togglePw('password','icon-pw1')">
              <i id="icon-pw1" class="bi bi-eye-slash"></i>
            </button>
          </div>

          <!-- Strength meter -->
          <div class="strength-wrap" id="strengthWrap" style="display:none;">
            <div class="strength-bars">
              <div class="strength-bar" id="bar1"></div>
              <div class="strength-bar" id="bar2"></div>
              <div class="strength-bar" id="bar3"></div>
              <div class="strength-bar" id="bar4"></div>
            </div>
            <span class="strength-label" id="strengthLabel">Too weak</span>
          </div>

          <!-- Requirements -->
          <ul class="req-list" id="reqList" style="display:none;">
            <li id="req-len"><i class="bi bi-x-circle-fill"></i> 8+ characters</li>
            <li id="req-upper"><i class="bi bi-x-circle-fill"></i> Uppercase letter</li>
            <li id="req-lower"><i class="bi bi-x-circle-fill"></i> Lowercase letter</li>
            <li id="req-num"><i class="bi bi-x-circle-fill"></i> Number</li>
            <li id="req-special"><i class="bi bi-x-circle-fill"></i> Special character</li>
          </ul>

          <div class="field-error hidden" id="err-password">
            <i class="bi bi-exclamation-circle-fill"></i> <span></span>
          </div>

          <!-- Confirm New Password -->
          <label class="form-label" for="confirmpassword">Confirm New Password</label>
          <div class="input-wrap">
            <i class="bi bi-shield-lock input-icon"></i>
            <input type="password" id="confirmpassword" name="confirmpassword" class="hh-input" placeholder="Re-enter your password" autocomplete="new-password"/>
            <button type="button" class="toggle-pw" aria-label="Toggle confirm password visibility" onclick="togglePw('confirmpassword','icon-pw2')">
              <i id="icon-pw2" class="bi bi-eye-slash"></i>
            </button>
          </div>
          <div class="field-error hidden" id="err-confirm">
            <i class="bi bi-exclamation-circle-fill"></i> <span></span>
          </div>

          <!-- Update Button -->
          <button type="submit" class="btn-update" id="submitBtn" disabled>
            Update Password <i class="bi bi-arrow-right"></i>
          </button>

        </form>
      </div>

      <!-- Divider -->
      <div class="divider"></div>

      <!-- Help -->
      <p class="help-text">Need help? <a href="#">Contact Security Support</a></p>
    </div>

    <!-- Back to login -->
    <div class="back-wrap">
      <a href="/user/login" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to login
      </a>
    </div>

  </main>

  <!-- FOOTER -->
  <footer class="hh-footer">
    <span class="foot-copy">© 2024 Helmet Haven Inc.</span>
    <nav class="foot-links">
      <a href="#">Privacy Policy</a>
      <a href="#">Terms of Service</a>
      <a href="#">Global Standards</a>
    </nav>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    /* ──────────────────────────────────────────
       TOGGLE PASSWORD VISIBILITY
    ────────────────────────────────────────── */
    function togglePw(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon  = document.getElementById(iconId);
      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye';
      } else {
        input.type = 'password';
        icon.className = 'bi bi-eye-slash';
      }
    }

    /* ──────────────────────────────────────────
       PASSWORD STRENGTH
    ────────────────────────────────────────── */
    function getStrength(pw) {
      let score = 0;
      if (pw.length >= 8)  score++;
      if (/[A-Z]/.test(pw)) score++;
      if (/[a-z]/.test(pw)) score++;
      if (/[0-9]/.test(pw)) score++;
      if (/[^A-Za-z0-9]/.test(pw)) score++;
      return score; // 0–5
    }

    const strengthClasses = ['', 'weak', 'weak', 'fair', 'good', 'strong'];
    const strengthLabels  = ['', 'Too weak', 'Weak', 'Fair', 'Good', 'Strong'];

    function updateStrength(pw) {
      const bars  = [document.getElementById('bar1'), document.getElementById('bar2'),
                     document.getElementById('bar3'), document.getElementById('bar4')];
      const label = document.getElementById('strengthLabel');
      const score = getStrength(pw);

      bars.forEach((b, i) => {
        b.className = 'strength-bar';
        if (i < score) b.classList.add(strengthClasses[score]);
      });

      label.className = 'strength-label ' + strengthClasses[score];
      label.textContent = strengthLabels[score];
    }

    function updateRequirements(pw) {
      const checks = {
        'req-len':     pw.length >= 8,
        'req-upper':   /[A-Z]/.test(pw),
        'req-lower':   /[a-z]/.test(pw),
        'req-num':     /[0-9]/.test(pw),
        'req-special': /[^A-Za-z0-9]/.test(pw)
      };
      for (const [id, met] of Object.entries(checks)) {
        const li = document.getElementById(id);
        const icon = li.querySelector('i');
        if (met) {
          li.classList.add('met');
          icon.className = 'bi bi-check-circle-fill';
        } else {
          li.classList.remove('met');
          icon.className = 'bi bi-x-circle-fill';
        }
      }
    }

    /* ──────────────────────────────────────────
       SHOW / HIDE FIELD ERRORS
    ────────────────────────────────────────── */
    function showError(errId, inputEl, msg) {
      const errEl = document.getElementById(errId);
      errEl.querySelector('span').textContent = msg;
      errEl.classList.remove('hidden');
      inputEl.classList.add('is-invalid');
      inputEl.classList.remove('is-valid');
    }

    function clearError(errId, inputEl) {
      const errEl = document.getElementById(errId);
      errEl.classList.add('hidden');
      inputEl.classList.remove('is-invalid');
    }

    function markValid(errId, inputEl) {
      clearError(errId, inputEl);
      inputEl.classList.add('is-valid');
    }

    /* ──────────────────────────────────────────
       VALIDATION LOGIC
    ────────────────────────────────────────── */
    const pwInput  = document.getElementById('password');
    const cpInput  = document.getElementById('confirmpassword');
    const submitBtn = document.getElementById('submitBtn');

    function validatePassword(pw) {
      if (!pw) return 'Password is required.';
      if (pw.length < 8) return 'Password must be at least 8 characters.';
      if (!/[A-Z]/.test(pw)) return 'Include at least one uppercase letter.';
      if (!/[a-z]/.test(pw)) return 'Include at least one lowercase letter.';
      if (!/[0-9]/.test(pw)) return 'Include at least one number.';
      if (!/[^A-Za-z0-9]/.test(pw)) return 'Include at least one special character.';
      return null;
    }

    function checkSubmitState() {
      const pwErr = validatePassword(pwInput.value);
      const cpVal = cpInput.value;
      const bothFilled = pwInput.value.length > 0 && cpVal.length > 0;
      const matches = pwInput.value === cpVal;
      submitBtn.disabled = !(!pwErr && bothFilled && matches);
    }

    /* Live feedback on password field */
    pwInput.addEventListener('input', function () {
      const pw = this.value;
      const strengthWrap = document.getElementById('strengthWrap');
      const reqList      = document.getElementById('reqList');

      if (pw.length > 0) {
        strengthWrap.style.display = 'block';
        reqList.style.display = 'grid';
        updateStrength(pw);
        updateRequirements(pw);
      } else {
        strengthWrap.style.display = 'none';
        reqList.style.display = 'none';
      }

      const err = validatePassword(pw);
      if (err) {
        showError('err-password', this, err);
      } else {
        markValid('err-password', this);
      }

      // Re-validate confirm if already touched
      if (cpInput.value.length > 0) {
        validateConfirm();
      }

      checkSubmitState();
    });

    pwInput.addEventListener('blur', function () {
      if (this.value) {
        const err = validatePassword(this.value);
        if (err) showError('err-password', this, err);
        else markValid('err-password', this);
      } else {
        showError('err-password', this, 'Password is required.');
      }
    });

    /* Live feedback on confirm field */
    function validateConfirm() {
      const cp = cpInput.value;
      if (!cp) {
        showError('err-confirm', cpInput, 'Please confirm your password.');
        return false;
      }
      if (cp !== pwInput.value) {
        showError('err-confirm', cpInput, 'Passwords do not match.');
        return false;
      }
      markValid('err-confirm', cpInput);
      return true;
    }

    cpInput.addEventListener('input', function () {
      validateConfirm();
      checkSubmitState();
    });

    cpInput.addEventListener('blur', function () {
      if (this.value.length > 0) validateConfirm();
    });

    /* ──────────────────────────────────────────
       FORM SUBMIT
    ────────────────────────────────────────── */
    document.getElementById('resetForm').addEventListener('submit', function (e) {
      const pwErr = validatePassword(pwInput.value);
      const cpOk  = validateConfirm();

      if (pwErr || !cpOk) {
        e.preventDefault();
        if (pwErr) showError('err-password', pwInput, pwErr);
        return;
      }

      // All good — form will submit naturally to /auth/resetPassword
    });
  </script>
</body>
</html>