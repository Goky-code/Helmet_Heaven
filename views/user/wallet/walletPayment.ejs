<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Helmet Haven - Add Funds</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
  <style>
    :root {
      --bg-main:           #0d1117;
      --bg-sidebar:        #0d1117;
      --bg-card:           #161b22;
      --bg-input:          #0d1117;
      --border-color:      #2a3240;
      --text-primary:      #e6edf3;
      --text-muted:        #8b949e;
      --accent-blue:       #1f6feb;
      --accent-blue-hover: #388bfd;
      --sidebar-active-bg: #161b22;
      --danger-color:      #f85149;
      --success-color:     #3fb950;
      --warning-color:     #d29922;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-main);
      color: var(--text-primary);
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 14px;
      min-height: 100vh;
      display: flex; flex-direction: column;
    }

    /* ── NAVBAR ── */
    .navbar-custom {
      background-color: #0d1117;
      border-bottom: 1px solid var(--border-color);
      padding: 10px 16px;
      position: sticky; top: 0; z-index: 1000;
    }
    .navbar-inner {
      display: flex; align-items: center;
      justify-content: space-between; gap: 12px; flex-wrap: wrap;
    }
    .navbar-left { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
    .navbar-brand-text {
      font-weight: 700; font-size: 18px; color: var(--text-primary) !important;
      display: flex; align-items: center; gap: 8px;
      text-decoration: none; white-space: nowrap;
    }
    .navbar-brand-text i { color: var(--accent-blue); font-size: 20px; }
    .nav-links { display: flex; gap: 2px; }
    .nav-link-custom {
      color: var(--text-primary) !important; font-size: 14px;
      padding: 6px 10px !important; text-decoration: none; white-space: nowrap;
    }
    .nav-link-custom:hover { color: var(--accent-blue) !important; }
    .search-input {
      background-color: #161b22; border: 1px solid var(--border-color);
      color: var(--text-muted); border-radius: 6px;
      padding: 6px 14px 6px 36px; font-size: 13px;
      width: 100%; max-width: 320px; min-width: 120px; outline: none;
    }
    .search-input:focus { border-color: var(--accent-blue); }
    .search-input::placeholder { color: var(--text-muted); }
    .search-wrapper { position: relative; flex: 1; max-width: 320px; }
    .search-wrapper i { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 14px; }

    .navbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

    .icon-btn {
      background: #161b22; border: 1px solid var(--border-color);
      color: var(--text-primary); border-radius: 8px;
      width: 38px; height: 38px;
      display: flex; align-items: center; justify-content: center;
      font-size: 17px; position: relative; cursor: pointer;
      text-decoration: none; flex-shrink: 0;
      transition: border-color .2s, color .2s;
    }
    .icon-btn:hover { border-color: var(--accent-blue); color: var(--accent-blue); }

    .icon-btn .nbadge {
      position: absolute; top: -4px; right: -4px;
      background: var(--accent-blue); color: #fff;
      font-size: 9px; border-radius: 10px;
      padding: 1px 5px; font-weight: 700;
      border: 1px solid var(--bg-main);
      pointer-events: none;
    }

    .hamburger-btn {
      display: none; background: #161b22; border: 1px solid var(--border-color);
      color: var(--text-primary); border-radius: 8px;
      width: 38px; height: 38px; align-items: center; justify-content: center;
      font-size: 18px; cursor: pointer; flex-shrink: 0;
    }

    /* ── LAYOUT ── */
    .page-wrapper { display: flex; flex: 1; min-height: 0; }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 240px; min-width: 240px; background: var(--bg-sidebar);
      border-right: 1px solid var(--border-color);
      padding: 24px 0; transition: transform 0.3s ease;
    }
    .sidebar-heading {
      display: flex; align-items: center; gap: 10px;
      font-weight: 700; font-size: 15px; padding: 0 20px 20px;
      color: var(--text-primary);
    }
    .sidebar-heading i { color: var(--accent-blue); font-size: 18px; }
    .sidebar-item {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 20px; color: var(--text-primary);
      text-decoration: none; font-size: 14px; cursor: pointer;
      border-left: 3px solid transparent;
      transition: background .15s, color .15s; white-space: nowrap;
    }
    .sidebar-item:hover { background: var(--bg-card); color: var(--accent-blue); }
    .sidebar-item.active { background: var(--bg-card); color: var(--accent-blue); border-left-color: var(--accent-blue); }
    .sidebar-item i { font-size: 16px; width: 18px; text-align: center; }
    .sidebar-divider { border-top: 1px solid var(--border-color); margin: 12px 0; }
    .sidebar-item.logout { color: var(--danger-color); }
    .sidebar-item.logout:hover { background: rgba(248,81,73,0.08); color: var(--danger-color); }
    .sidebar-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.6); z-index: 900;
    }

    /* ── MAIN CONTENT ── */
    .main-content {
      flex: 1; padding: 32px 28px;
      background: var(--bg-main); overflow-x: hidden; min-width: 0;
    }
    .page-title { font-size: 22px; font-weight: 500; color: var(--text-primary); margin-bottom: 4px; }
    .page-subtitle { color: var(--text-muted); font-size: 13px; margin-bottom: 24px; }

    /* ── ADD FUNDS HEADER ── */
    .addfunds-header { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 28px; }
    .btn-back {
      background: #161b22; border: 1px solid var(--border-color);
      color: var(--text-primary); border-radius: 8px;
      width: 40px; height: 40px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; cursor: pointer; text-decoration: none;
      transition: border-color .15s, color .15s;
    }
    .btn-back:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
    .addfunds-title { font-size: 26px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px; }
    .addfunds-subtitle { color: var(--text-muted); font-size: 14px; }

    /* ── ADD FUNDS CARD ── */
    .addfunds-card {
      background: var(--bg-card); border: 1px solid var(--border-color);
      border-radius: 14px; padding: 28px; max-width: 760px;
    }

    .field-label {
      font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--text-muted); margin-bottom: 10px; display: block; font-weight: 600;
    }

    .amount-input {
      width: 100%; background: var(--bg-input); border: 1px solid var(--border-color);
      border-radius: 10px; color: var(--text-primary);
      font-size: 30px; font-weight: 700; padding: 14px 20px;
      outline: none; transition: border-color .15s;
    }
    .amount-input:focus { border-color: var(--accent-blue); }
    .amount-input::placeholder { color: var(--text-muted); font-weight: 700; }

    .quick-amounts {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
      margin: 16px 0 28px;
    }
    .quick-amount-btn {
      background: #1c2330; border: 1px solid var(--border-color);
      color: var(--text-primary); border-radius: 10px;
      font-size: 14px; font-weight: 700; padding: 12px 8px;
      cursor: pointer; text-align: center;
      transition: border-color .15s, color .15s, background .15s;
    }
    .quick-amount-btn:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
    .quick-amount-btn.active {
      background: rgba(31,111,235,0.15); border-color: var(--accent-blue); color: var(--accent-blue);
    }

    .divider-line { border-top: 1px solid var(--border-color); margin-bottom: 24px; }

    .payment-methods { display: flex; flex-direction: column; gap: 14px; margin-bottom: 28px; }
    .payment-option {
      display: flex; align-items: center; gap: 16px;
      background: #1c2330; border: 1px solid var(--border-color);
      border-radius: 10px; padding: 16px 20px; cursor: pointer;
      transition: border-color .15s, background .15s;
    }
    .payment-option:hover { border-color: var(--accent-blue); }
    .payment-option.selected {
      border-color: var(--accent-blue); background: rgba(31,111,235,0.10);
    }
    .payment-icon {
      width: 40px; height: 40px; border-radius: 8px;
      background: rgba(31,111,235,0.12); color: var(--accent-blue);
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; flex-shrink: 0;
    }
    .payment-info { flex: 1; min-width: 0; }
    .payment-name { font-size: 15px; font-weight: 700; color: var(--text-primary); margin-bottom: 2px; }
    .payment-desc { font-size: 12.5px; color: var(--text-muted); }
    .payment-radio {
      width: 20px; height: 20px; border-radius: 50%;
      border: 2px solid var(--border-color); flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      transition: border-color .15s;
    }
    .payment-option.selected .payment-radio { border-color: var(--accent-blue); }
    .payment-radio .radio-dot {
      width: 10px; height: 10px; border-radius: 50%; background: var(--accent-blue);
      display: none;
    }
    .payment-option.selected .radio-dot { display: block; }
    .payment-option input[type="radio"] { display: none; }

    .btn-proceed {
      width: 100%; background: var(--accent-blue); color: #fff; border: none;
      border-radius: 10px; font-size: 16px; font-weight: 700;
      padding: 15px 24px; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 10px;
      transition: background 0.15s;
    }
    .btn-proceed:hover { background: var(--accent-blue-hover); }

    .secure-note {
      text-align: center; color: var(--text-muted); font-size: 12px;
      margin-top: 16px; display: flex; align-items: center; justify-content: center; gap: 6px;
    }

    /* ── FOOTER ── */
    footer {
      background: var(--bg-main); border-top: 1px solid var(--border-color);
      padding: 36px 20px 20px;
    }
    .footer-brand { font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .footer-brand i { color: var(--accent-blue); }
    .footer-desc { color: var(--text-muted); font-size: 12.5px; max-width: 220px; line-height: 1.6; }
    .footer-heading { font-size: 13px; font-weight: 600; color: var(--text-primary); margin-bottom: 14px; }
    .footer-link { display: block; color: var(--text-muted); text-decoration: none; font-size: 12.5px; margin-bottom: 8px; transition: color 0.15s; }
    .footer-link:hover { color: var(--accent-blue); }
    .footer-input {
      background: var(--bg-input); border: 1px solid var(--border-color);
      border-radius: 6px 0 0 6px; color: var(--text-primary);
      font-size: 13px; padding: 8px 12px; outline: none; flex: 1; min-width: 0;
    }
    .footer-input:focus { border-color: var(--accent-blue); }
    .footer-input::placeholder { color: var(--text-muted); }
    .btn-join {
      background: var(--accent-blue); color: #fff; border: none;
      border-radius: 0 6px 6px 0; padding: 8px 16px;
      font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap;
    }
    .btn-join:hover { background: var(--accent-blue-hover); }
    .footer-newsletter-row { display: flex; width: 100%; max-width: 280px; }
    .footer-bottom {
      border-top: 1px solid var(--border-color); margin-top: 30px; padding-top: 16px;
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 8px;
    }
    .footer-bottom-text { color: var(--text-muted); font-size: 12px; }
    .footer-bottom-link { color: var(--text-muted); font-size: 12px; text-decoration: none; }
    .footer-bottom-link:hover { color: var(--text-primary); }

    /* ── RESPONSIVE ── */
    @media (max-width: 992px) {
      .sidebar { width: 200px; min-width: 200px; }
      .sidebar-item { font-size: 13px; padding: 10px 14px; gap: 10px; }
      .main-content { padding: 24px 20px; }
    }
    @media (max-width: 768px) {
      .hamburger-btn { display: flex; }
      .nav-links { display: none; }
      .sidebar {
        position: fixed; top: 0; left: 0; height: 100%; z-index: 950;
        transform: translateX(-100%); width: 240px; min-width: 240px; padding-top: 60px;
      }
      .sidebar.open { transform: translateX(0); }
      .sidebar-overlay.open { display: block; }
      .main-content { padding: 20px 16px; }
      .addfunds-card { padding: 20px; }
      .addfunds-title { font-size: 21px; }
      .amount-input { font-size: 24px; padding: 12px 16px; }
      .quick-amounts { grid-template-columns: repeat(2, 1fr); }
      .payment-option { padding: 14px 16px; gap: 12px; }
    }
    @media (max-width: 480px) {
      .navbar-brand-text { font-size: 16px; }
      .search-wrapper { display: none; }
      .page-title { font-size: 18px; }
      .footer-desc { max-width: 100%; }
      .footer-bottom { flex-direction: column; align-items: flex-start; }
      .addfunds-header { gap: 12px; }
      .addfunds-title { font-size: 19px; }
      .addfunds-subtitle { font-size: 12.5px; }
      .payment-name { font-size: 14px; }
      .payment-desc { font-size: 12px; }
    }
    @media (max-width: 360px) {
      .main-content { padding: 16px 12px; }
      .navbar-custom { padding: 8px 12px; }
      .quick-amounts { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    }
  </style>
</head>
<body>

<%
  const _cartCount     = typeof cartCount     !== 'undefined' ? cartCount     : 0;
  const _wishlistCount = typeof wishlistCount !== 'undefined' ? wishlistCount : 0;
  const _quickAmounts   = typeof quickAmounts   !== 'undefined' ? quickAmounts   : [100, 500, 1000, 2000];
  const _selectedAmount = typeof selectedAmount !== 'undefined' ? selectedAmount : 500;
  const _paymentMethods = typeof paymentMethods !== 'undefined' ? paymentMethods : [
    { id: 'saved_card', icon: 'bi-credit-card-2-front-fill', name: 'Saved Credit/Debit Card', desc: 'Visa ending in •••• 4242', selected: true },
    { id: 'razorpay',   icon: 'bi-bank',                     name: 'Razorpay',                desc: 'UPI, Net Banking, and Cards', selected: false },
    { id: 'paypal',     icon: 'bi-paypal',                   name: 'PayPal',                   desc: 'Pay via PayPal account',       selected: false }
  ];
%>

<!-- Sidebar overlay -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- ── NAVBAR ── -->
<nav class="navbar-custom">
  <div class="navbar-inner">

    <div class="navbar-left">
      <button class="hamburger-btn" id="hamburgerBtn" onclick="toggleSidebar()" aria-label="Menu">
        <i class="bi bi-list"></i>
      </button>
      <a class="navbar-brand-text" href="/user/homepage">
        <i class="bi bi-shield-fill"></i> Helmet Haven
      </a>
      <div class="nav-links">
        <a href="/user/homepage" class="nav-link-custom">Home</a>
        <a href="#" class="nav-link-custom">About Us</a>
        <a href="#" class="nav-link-custom">Contact Us</a>
      </div>
    </div>

    <div class="search-wrapper">
      <i class="bi bi-search"></i>
      <input type="text" class="search-input" placeholder="Search premium helmets..."/>
    </div>

    <div class="navbar-right">

      <a href="/user/cart" class="icon-btn" aria-label="Cart">
        <i class="bi bi-cart2"></i>
        <% if (_cartCount > 0) { %>
          <span class="nbadge" id="cartBadge"><%= _cartCount %></span>
        <% } else { %>
          <span class="nbadge" id="cartBadge" style="display:none">0</span>
        <% } %>
      </a>

      <a href="/user/wishlist" class="icon-btn" aria-label="Wishlist">
        <i class="bi bi-heart"></i>
        <% if (_wishlistCount > 0) { %>
          <span class="nbadge" id="wishlistBadge"><%= _wishlistCount %></span>
        <% } else { %>
          <span class="nbadge" id="wishlistBadge" style="display:none">0</span>
        <% } %>
      </a>

      <a href="/user/profileinformation" class="icon-btn" aria-label="Account">
        <i class="bi bi-person"></i>
      </a>

    </div>
  </div>
</nav>
<!-- ── END NAVBAR ── -->


<!-- ── PAGE BODY ── -->
<div class="page-wrapper">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-heading"><i class="bi bi-person-circle"></i> My Account</div>
    <a href="/user/profileinformation" class="sidebar-item"><i class="bi bi-person"></i> Profile Info</a>
    <a href="/user/myOrders" class="sidebar-item"><i class="bi bi-bag"></i> My Orders</a>
    <a href="/user/address/addressPage" class="sidebar-item"><i class="bi bi-geo-alt"></i> Address</a>
    <a href="/user/wallet" class="sidebar-item active"><i class="bi bi-wallet2"></i> Wallet</a>
    <a href="#" class="sidebar-item"><i class="bi bi-scissors"></i> Coupon</a>
    <a href="/user/passwordChange" class="sidebar-item"><i class="bi bi-lock"></i> Password Change</a>
    <div class="sidebar-divider"></div>
    <a href="/user/logout" class="sidebar-item logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
  </aside>

  <!-- MAIN -->
  <main class="main-content">

    <div class="addfunds-header">
      <a href="/user/wallet" class="btn-back" aria-label="Back to wallet">
        <i class="bi bi-arrow-left"></i>
      </a>
      <div>
        <div class="addfunds-title">Add Funds to Wallet</div>
        <div class="addfunds-subtitle">Recharge your wallet for a faster checkout experience.</div>
      </div>
    </div>

    <form class="addfunds-card" action="/user/wallet/addMoney" method="POST" id="addFundsForm">

      <label class="field-label" for="amountInput">Enter Amount</label>
      <input
        type="number"
        min="1"
        step="0.01"
        class="amount-input"
        id="amountInput"
        name="amount"
        value="<%= _selectedAmount %>"
        placeholder="0.00"
        required
      />

      <div class="quick-amounts" id="quickAmounts">
        <% _quickAmounts.forEach(function(amt) { %>
          <button
            type="button"
            class="quick-amount-btn <%= Number(amt) === Number(_selectedAmount) ? 'active' : '' %>"
            data-amount="<%= amt %>"
          >+<%= amt %></button>
        <% }); %>
      </div>

      <div class="divider-line"></div>

      <label class="field-label">Select Payment Method</label>
      <div class="payment-methods" id="paymentMethods">
        <% _paymentMethods.forEach(function(pm, idx) { %>
          <label class="payment-option <%= pm.selected ? 'selected' : '' %>" data-method-id="<%= pm.id %>">
            <input type="radio" name="paymentMethod" value="<%= pm.id %>" <%= pm.selected ? 'checked' : '' %> />
            <div class="payment-icon"><i class="bi <%= pm.icon %>"></i></div>
            <div class="payment-info">
              <div class="payment-name"><%= pm.name %></div>
              <div class="payment-desc"><%= pm.desc %></div>
            </div>
            <div class="payment-radio"><span class="radio-dot"></span></div>
          </label>
        <% }); %>
      </div>

      <button type="submit" class="btn-proceed">
        Proceed to Top-up <i class="bi bi-arrow-right"></i>
      </button>

      <div class="secure-note">
        <i class="bi bi-lock-fill"></i> Secure 256-bit SSL Encrypted Payment
      </div>

    </form>

  </main>
</div>


<!-- ── FOOTER ── -->
<footer>
  <div class="row g-4">
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="footer-brand"><i class="bi bi-shield-fill"></i> Helmet Haven</div>
      <p class="footer-desc">The world's premier destination for high-end safety and performance headgear.</p>
    </div>
    <div class="col-6 col-sm-3 col-lg-2">
      <p class="footer-heading">Shop</p>
      <a href="#" class="footer-link">Full Face</a>
      <a href="#" class="footer-link">Off-Road</a>
      <a href="#" class="footer-link">Modular</a>
      <a href="#" class="footer-link">Accessories</a>
    </div>
    <div class="col-6 col-sm-3 col-lg-2">
      <p class="footer-heading">Support</p>
      <a href="#" class="footer-link">Shipping Policy</a>
      <a href="#" class="footer-link">Return &amp; Exchange</a>
      <a href="#" class="footer-link">Size Guide</a>
      <a href="#" class="footer-link">FAQ</a>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
      <p class="footer-heading">Newsletter</p>
      <p class="footer-desc mb-3">Get early access to drops and exclusive offers.</p>
      <div class="footer-newsletter-row">
        <input type="email" class="footer-input" placeholder="Email address"/>
        <button class="btn-join">Join</button>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="footer-bottom-text">© 2024 Helmet Haven. All rights reserved.</span>
    <div class="d-flex gap-3 flex-wrap">
      <a href="#" class="footer-bottom-link">Privacy Policy</a>
      <a href="#" class="footer-bottom-link">Terms of Service</a>
    </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sidebarOverlay').classList.toggle('open');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sidebarOverlay').classList.remove('open');
  }

  // Quick amount buttons fill the amount input
  const amountInput = document.getElementById('amountInput');
  document.querySelectorAll('.quick-amount-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.quick-amount-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      amountInput.value = Number(btn.dataset.amount).toFixed(2);
    });
  });

  // Payment method selection
  document.querySelectorAll('.payment-option').forEach(function (option) {
    option.addEventListener('click', function () {
      document.querySelectorAll('.payment-option').forEach(function (o) { o.classList.remove('selected'); });
      option.classList.add('selected');
      option.querySelector('input[type="radio"]').checked = true;
    });
  });
</script>
</body>
</html>