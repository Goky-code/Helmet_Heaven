<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Helmet Haven — Forgot Password</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>

  <style>
    :root {
      --bg-dark:   #0d1218;
      --bg-card:   #161d27;
      --bg-input:  #111820;
      --accent:    #1d7fea;
      --border:    #252f3d;
      --text-muted:#5d6e82;
      --text-body: #c8d2de;
      --text-white:#f0f4f8;
      --error:     #e84545;
      --success:   #22c55e;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg-dark);
      font-family: 'Barlow', sans-serif;
      color: var(--text-body);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── NAVBAR ── */
    .hh-nav {
      background: var(--bg-dark);
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
    }
    .brand-icon {
      width: 36px; height: 36px;
      background: var(--accent);
      border-radius: 9px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .brand-name {
      font-family: 'Barlow', sans-serif;
      font-weight: 600;
      font-size: 1rem;
      color: var(--text-white);
    }

    /* ── MAIN ── */
    .hh-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 1rem;
    }

    /* ── CARD ── */
    .fp-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-top: 3px solid var(--accent);
      border-radius: 14px;
      padding: 2.8rem 2.4rem 2.4rem;
      width: 100%;
      max-width: 460px;
      text-align: center;
      animation: fadeSlideUp 0.4s ease both;
    }

    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* lock-refresh icon circle */
    .icon-wrap {
      width: 58px; height: 58px;
      background: #1a2233;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 1.8rem;
    }
    .icon-wrap i {
      font-size: 1.4rem;
      color: var(--accent);
    }

    .card-title {
      font-family: 'Barlow', sans-serif;
      font-weight: 700;
      font-size: 1.75rem;
      color: var(--text-white);
      margin-bottom: 0.7rem;
    }
    .card-sub {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.65;
      margin-bottom: 2rem;
    }

    /* ── FORM ── */
    .form-label {
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text-body);
      text-align: left;
      display: block;
      margin-bottom: 0.45rem;
    }

    .input-wrap {
      position: relative;
      margin-bottom: 0.4rem;
    }
    .input-icon {
      position: absolute;
      left: 0.95rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 1rem;
      pointer-events: none;
      transition: color 0.2s;
    }
    .hh-input {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text-white);
      font-size: 0.9rem;
      padding: 0.78rem 0.9rem 0.78rem 2.6rem;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .hh-input::placeholder { color: var(--text-muted); }
    .hh-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(29,127,234,.18);
    }
    .hh-input.is-invalid {
      border-color: var(--error);
      box-shadow: 0 0 0 3px rgba(232,69,69,.15);
    }
    .hh-input.is-valid {
      border-color: var(--success);
      box-shadow: 0 0 0 3px rgba(34,197,94,.13);
    }

    /* error / success messages */
    .field-msg {
      font-size: 0.8rem;
      min-height: 1.3rem;
      text-align: left;
      margin-bottom: 0.85rem;
      padding-left: 0.2rem;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      transition: opacity 0.2s;
    }
    .field-msg.error  { color: var(--error); }
    .field-msg.success{ color: var(--success); }
    .field-msg.hidden { opacity: 0; pointer-events: none; }

    /* ── SEND OTP BUTTON ── */
    .btn-send {
      background: var(--accent);
      border: none;
      border-radius: 10px;
      color: #fff;
      font-family: 'Barlow', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      padding: 0.82rem;
      width: 100%;
      transition: background .2s, transform .15s, opacity .2s;
      cursor: pointer;
      margin-bottom: 1.6rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    .btn-send:hover:not(:disabled) { background: #1568c9; transform: translateY(-1px); }
    .btn-send:active:not(:disabled) { transform: translateY(0); }
    .btn-send:disabled { opacity: 0.6; cursor: not-allowed; }

    /* spinner inside button */
    .btn-spinner {
      width: 17px; height: 17px;
      border: 2.5px solid rgba(255,255,255,0.35);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      display: none;
    }
    .btn-send.loading .btn-spinner { display: inline-block; }
    .btn-send.loading .btn-label   { display: none; }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* divider */
    .divider {
      height: 1px;
      background: var(--border);
      margin-bottom: 1.3rem;
    }

    /* back to login */
    .back-link {
      font-size: 0.88rem;
      color: var(--accent);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: gap 0.2s;
    }
    .back-link:hover { text-decoration: underline; gap: 0.55rem; }

    /* ── FOOTER ── */
    .hh-footer {
      text-align: center;
      padding: 1.5rem 1rem;
      font-size: 0.82rem;
      color: var(--text-muted);
    }
    .hh-footer .foot-copy { margin-bottom: 0.4rem; }
    .hh-footer .foot-links {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .hh-footer .foot-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.82rem;
      transition: color .2s;
    }
    .hh-footer .foot-links a:hover { color: var(--text-white); }
    .hh-footer .dot { font-size: 0.4rem; vertical-align: middle; }

    /* ── RESPONSIVE ── */

    /* Large tablets & small desktops */
    @media (max-width: 768px) {
      .fp-card {
        padding: 2.2rem 1.8rem 2rem;
        border-radius: 12px;
      }
      .card-title { font-size: 1.5rem; }
    }

    /* Mobile landscape / small tablets */
    @media (max-width: 576px) {
      .hh-main {
        padding: 1.5rem 0.75rem;
        justify-content: flex-start;
        padding-top: 2rem;
      }
      .fp-card {
        padding: 1.8rem 1.25rem 1.6rem;
        border-radius: 10px;
        max-width: 100%;
      }
      .card-title { font-size: 1.35rem; }
      .card-sub   { font-size: 0.85rem; margin-bottom: 1.5rem; }
      .icon-wrap  { width: 50px; height: 50px; margin-bottom: 1.4rem; }
      .btn-send   { font-size: 0.95rem; padding: 0.78rem; }
    }

    /* Very small phones (≤360px) */
    @media (max-width: 360px) {
      .fp-card {
        padding: 1.5rem 1rem 1.3rem;
      }
      .card-title { font-size: 1.2rem; }
      .brand-name { font-size: 0.9rem; }
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="hh-nav">
    <a href="#" class="brand">
      <div class="brand-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C8.5 2 5.5 4.5 5 8H4a2 2 0 0 0-2 2v1a2 2 0 0 0 2 2h.27A7 7 0 0 0 12 18a7 7 0 0 0 7.73-5H20a2 2 0 0 0 2-2v-1a2 2 0 0 0-2-2h-1C18.5 4.5 15.5 2 12 2zm0 2c2.76 0 5 2.24 5 5H7c0-2.76 2.24-5 5-5zm-7 7h14v1a5 5 0 0 1-10 0H5v-1z"/>
        </svg>
      </div>
      <span class="brand-name">Helmet Haven</span>
    </a>
  </nav>

  <!-- MAIN -->
  <main class="hh-main">
    <div class="fp-card">

      <!-- Icon -->
      <div class="icon-wrap">
        <i class="bi bi-arrow-counterclockwise"></i>
      </div>

      <!-- Heading -->
      <h1 class="card-title">Forgot Password?</h1>
      <p class="card-sub">Enter your email address and we'll send<br>you a link to reset your password.</p>

    

      <!-- Form -->
      <form id="fpForm" action="/auth/forgotPassword" method="POST" novalidate>

        <label class="form-label" for="emailInput">Email Address</label>
        <div class="input-wrap">
          <i class="bi bi-envelope input-icon" id="emailIcon"></i>
          <% if (typeof error !== 'undefined' && error) { %>
  <div id="serverError" data-msg="<%= error %>"></div>
<% } %>

          <input
            type="email"
            id="emailInput"
            name="email"
            class="hh-input"
            placeholder="you@example.com"
            autocomplete="email"
            inputmode="email"
            aria-describedby="emailMsg"
            aria-required="true"
          />
        </div>
        <div class="field-msg hidden" id="emailMsg" role="alert" aria-live="polite"></div>

        <button type="submit" class="btn-send" id="sendBtn">
          <span class="btn-label">Send OTP</span>
          <span class="btn-spinner" aria-hidden="true"></span>
        </button>
      </form>

      <!-- Divider -->
      <div class="divider"></div>

      <!-- Back to login -->
      <a href="/user/login" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to Login
      </a>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="hh-footer">
    <p class="foot-copy">© 2024 Helmet Haven. All rights reserved.</p>
    <div class="foot-links">
      <a href="#">Privacy Policy</a>
      <span class="dot">●</span>
      <a href="#">Support</a>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
   (function () {
  const form      = document.getElementById('fpForm');
  const emailInput= document.getElementById('emailInput');
  const emailMsg  = document.getElementById('emailMsg');
  const emailIcon = document.getElementById('emailIcon');
  const sendBtn   = document.getElementById('sendBtn');
  const serverErr = document.getElementById('serverError'); // 1. Grab the element

  /* ── 2. Check for server-side errors on page load ── */
  if (serverErr) {
    const errorText = serverErr.getAttribute('data-msg');
    if (errorText) {
      setInputState(emailInput, emailIcon, 'invalid');
      showMsg(emailMsg, errorText, 'error');
    }
  }

      /* ── helpers ── */
      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

      function showMsg(msgEl, text, type) {
        const icon = type === 'error'
          ? '<i class="bi bi-exclamation-circle-fill"></i>'
          : '<i class="bi bi-check-circle-fill"></i>';
        msgEl.innerHTML = icon + ' ' + text;
        msgEl.className = 'field-msg ' + type;
      }

      function clearMsg(msgEl) {
        msgEl.innerHTML = '';
        msgEl.className = 'field-msg hidden';
      }

      function setInputState(input, icon, state) {
        input.classList.remove('is-invalid', 'is-valid');
        if (state === 'invalid') {
          input.classList.add('is-invalid');
          icon.style.color = 'var(--error)';
        } else if (state === 'valid') {
          input.classList.add('isr1msi94axd@wnbaldwy.com-valid');
          icon.style.color = 'var(--success)';
        } else {
          icon.style.color = 'var(--text-muted)';
        }
      }

      /* ── validate email field ── */
      function validateEmail(showSuccess) {
        const val = emailInput.value.trim();

        if (val === '') {
          setInputState(emailInput, emailIcon, 'invalid');
          showMsg(emailMsg, 'Email address is required.', 'error');
          return false;
        }
        if (!EMAIL_RE.test(val)) {
          setInputState(emailInput, emailIcon, 'invalid');
          showMsg(emailMsg, 'Please enter a valid email address.', 'error');
          return false;
        }

        /* valid */
        setInputState(emailInput, emailIcon, 'valid');
        if (showSuccess) {
          showMsg(emailMsg,  'success');
        } else {
          clearMsg(emailMsg);
        }
        return true;
      }

      /* ── live validation: on blur ── */
      emailInput.addEventListener('blur', function () {
        if (emailInput.value.trim() !== '') {
          validateEmail(true);
        }
      });

      /* ── clear error as user types ── */
      emailInput.addEventListener('input', function () {
        if (emailInput.classList.contains('is-invalid')) {
          const val = emailInput.value.trim();
          if (EMAIL_RE.test(val)) {
            setInputState(emailInput, emailIcon, 'valid');
            clearMsg(emailMsg);
          } else {
            setInputState(emailInput, emailIcon, 'invalid');
            /* keep existing error msg while typing */
          }
        }
      });

      /* ── form submit ── */
      form.addEventListener('submit', function (e) {
        const valid = validateEmail(true);
        if (!valid) {
          e.preventDefault();
          emailInput.focus();
          return;
        }

        /* Show loading state */
        sendBtn.disabled = true;
        sendBtn.classList.add('loading');
        /* Form will submit normally to /auth/forgotPassword */
      });
    })();
  </script>
</body>
</html>