<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Helmet Haven — Admin Portal</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>

  <style>
    :root {
      --bg-dark:    #0b0f18;
      --bg-card:    #111720;
      --bg-input:   #161d2a;
      --accent:     #1d7fea;
      --accent-h:   #1568c9;
      --accent-glow:rgba(29,127,234,.15);
      --border:     #1e2a3a;
      --border-err: #e53e3e;
      --border-ok:  #38a169;
      --text-muted: #3d5268;
      --text-body:  #7a92a8;
      --text-white: #eef2f7;
      --err-clr:    #fc8181;
      --ok-clr:     #68d391;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg-dark);
      font-family: 'Inter', sans-serif;
      color: var(--text-body);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
    }

    /* ── PAGE WRAP ── */
    .page-wrap {
      width: 100%;
      max-width: 480px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* ── BRAND ── */
    .brand-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 1.8rem;
    }
    .brand-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.45rem;
    }
    .brand-icon {
      width: 42px; height: 42px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .brand-name {
      font-size: clamp(1.2rem, 4vw, 1.55rem);
      font-weight: 800;
      color: var(--text-white);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .brand-sub {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    /* ── SERVER ERROR BANNER ── */
    .server-alert {
      width: 100%;
      background: rgba(229,62,62,.1);
      border: 1px solid rgba(229,62,62,.35);
      border-radius: 10px;
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.82rem;
      color: var(--err-clr);
      margin-bottom: 1rem;
    }
    .server-alert i { font-size: 1rem; flex-shrink: 0; }

   

    /* ── CARD ── */
    .admin-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: clamp(1.4rem, 5vw, 2.2rem) clamp(1.2rem, 5vw, 2rem);
      width: 100%;
    }

    .card-heading {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-white);
      margin-bottom: 0.3rem;
    }
    .card-sub {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 1.6rem;
    }

    /* ── FORM LABELS ── */
    .field-label {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-body);
      display: block;
      margin-bottom: 0.42rem;
    }

    /* ── INPUT WRAPPER ── */
    .input-wrap {
      position: relative;
      margin-bottom: 0.35rem;
    }
    .input-icon {
      position: absolute;
      left: 0.95rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 0.95rem;
      pointer-events: none;
      transition: color .2s;
    }
    .eye-btn {
      position: absolute;
      right: 0.95rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 0.95rem;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0; line-height: 1;
      transition: color .2s;
    }
    .eye-btn:hover { color: var(--text-body); }

    .hh-input {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text-white);
      font-family: 'Inter', sans-serif;
      font-size: 0.88rem;
      padding: 0.82rem 1rem 0.82rem 2.7rem;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .hh-input.has-eye { padding-right: 2.7rem; }
    .hh-input::placeholder { color: var(--text-muted); font-size: 0.82rem; }

    .hh-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }
    .hh-input:focus + .input-icon,
    .input-wrap:focus-within .input-icon { color: var(--accent); }

    /* validation states */
    .hh-input.is-invalid { border-color: var(--border-err) !important; box-shadow: 0 0 0 3px rgba(229,62,62,.12) !important; }
    .hh-input.is-valid   { border-color: var(--border-ok)  !important; box-shadow: 0 0 0 3px rgba(56,161,105,.1)  !important; }

    /* field group spacing */
    .field-group { margin-bottom: 1.1rem; }

    /* error / hint text */
    .field-msg {
      font-size: 0.72rem;
      margin-top: 0.38rem;
      display: none;
      align-items: center;
      gap: 0.35rem;
      padding-left: 0.1rem;
    }
    .field-msg.err  { color: var(--err-clr); }
    .field-msg.hint { color: var(--text-muted); }
    .field-msg.show { display: flex; }

    /* password strength bar */
    .pw-strength {
      height: 3px;
      border-radius: 2px;
      background: var(--border);
      margin-top: 0.5rem;
      overflow: hidden;
      display: none;
    }
    .pw-strength.show { display: block; }
    .pw-strength-fill {
      height: 100%;
      border-radius: 2px;
      width: 0%;
      transition: width .35s, background .35s;
    }

    /* ── SUBMIT BUTTON ── */
    .btn-access {
      background: var(--accent);
      border: none;
      border-radius: 10px;
      color: #fff;
      font-family: 'Inter', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      padding: 0.88rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: background .2s, transform .15s, opacity .2s;
      cursor: pointer;
      margin-top: 0.5rem;
      letter-spacing: 0.02em;
    }
    .btn-access:hover:not(:disabled) { background: var(--accent-h); transform: translateY(-1px); }
    .btn-access:active:not(:disabled) { transform: translateY(0); }
    .btn-access:disabled { opacity: .55; cursor: not-allowed; }

    /* spinner inside button */
    .btn-spinner {
      width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,.35);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .6s linear infinite;
      display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── SECURITY NOTICE ── */
    .security-block {
      margin-top: 1.8rem;
      text-align: center;
      width: 100%;
    }
    .sec-title {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.75rem;
    }
    .sec-text {
      font-size: 0.77rem;
      line-height: 1.75;
      color: var(--text-muted);
    }

    /* ── FOOTER ── */
    .hh-footer {
      margin-top: 1.8rem;
      width: 100%;
      max-width: 480px;
      border-top: 1px solid var(--border);
      padding: 1rem 0 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
    }
    .foot-copy, .foot-version {
      font-size: 0.63rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 480px) {
      body { justify-content: flex-start; padding-top: 2rem; }
      .brand-block { margin-bottom: 1.4rem; }
      .security-block { display: none; } /* hide on very small screens to reduce scroll */
    }

    @media (max-width: 360px) {
      .brand-name { font-size: 1.1rem; }
      .hh-footer  { flex-direction: column; align-items: center; text-align: center; }
    }
  </style>
</head>
<body>

  <div class="page-wrap">

    <!-- BRAND -->
    <div class="brand-block">
      <div class="brand-row">
        <div class="brand-icon">
          <svg width="42" height="42" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="22" cy="22" r="20" stroke="#1d7fea" stroke-width="2" fill="none"/>
            <path d="M13 26 C13 18 16 13 22 13 C28 13 31 18 31 26" stroke="#1d7fea" stroke-width="2" stroke-linecap="round" fill="none"/>
            <path d="M13 26 L13 28 C13 29.1 13.9 30 15 30 L29 30 C30.1 30 31 29.1 31 28 L31 26" stroke="#1d7fea" stroke-width="2" stroke-linecap="round" fill="none"/>
            <path d="M16 23 C17 20 20 18 22 18 C24 18 27 20 28 23" stroke="#1d7fea" stroke-width="1.5" stroke-linecap="round" fill="none"/>
            <circle cx="19" cy="28" r="0.8" fill="#1d7fea"/>
            <circle cx="22" cy="28" r="0.8" fill="#1d7fea"/>
            <circle cx="25" cy="28" r="0.8" fill="#1d7fea"/>
          </svg>
        </div>
        <span class="brand-name">Helmet Haven</span>
      </div>
      <span class="brand-sub">Admin Portal</span>
    </div>

   
<% if (typeof error !== 'undefined' && error !== null && error !== '') { %>
  <div id="serverError" data-msg="<%= error %>" style="display:none;"></div>
<% } %>
    <!-- CARD -->
    <div class="admin-card">
      <div class="card-heading">Welcome back</div>
      <div class="card-sub">Sign in to your administrator account</div>

      <form id="loginForm" action="/admin/adminLogin" method="POST" novalidate>

        <!-- Email -->
        <div class="field-group">
          <label class="field-label" for="emailInput">Admin Email</label>
          <div class="input-wrap">
            <i class="bi bi-envelope input-icon"></i>
            <input
              type="email"
              id="emailInput"
              name="email"
              class="hh-input"
              placeholder="admin@helmethaven.com"
              autocomplete="email"
              maxlength="100"
            />
          </div>
          <div class="field-msg err" id="emailErr"><i class="bi bi-x-circle"></i><span></span></div>
        </div>

        <!-- Password -->
        <div class="field-group">
          <label class="field-label" for="pwInput">Password</label>
          <div class="input-wrap">
            <i class="bi bi-lock input-icon"></i>
            <input
              type="password"
              id="pwInput"
              name="password"
              class="hh-input has-eye"
              placeholder="Enter your password"
              autocomplete="current-password"
              maxlength="128"
              
            />
            <button type="button" class="eye-btn" id="eyeBtn" aria-label="Toggle password">
              <i class="bi bi-eye" id="eyeIcon"></i>
            </button>
          </div>
          <div class="pw-strength" id="pwStrengthBar">
            <div class="pw-strength-fill" id="pwStrengthFill"></div>
          </div>
          <div class="field-msg err" id="pwErr"><i class="bi bi-x-circle"></i><span></span></div>
          <div class="field-msg hint" id="pwHint"><i class="bi bi-info-circle"></i><span>Min 6 characters</span></div>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn-access" id="submitBtn">
          <span id="btnText">Access Dashboard</span>
          <i class="bi bi-box-arrow-in-right" id="btnIcon"></i>
          <span class="btn-spinner" id="btnSpinner"></span>
        </button>

      </form>
    </div>

    <!-- SECURITY NOTICE -->
    <div class="security-block">
      <div class="sec-title">
        <i class="bi bi-shield-fill" style="font-size:.72rem;"></i>
        Security Notice
      </div>
      <p class="sec-text">
        This is a restricted administrative interface. Unauthorized access attempts are
        logged and strictly prohibited. By proceeding, you acknowledge compliance with
        company security protocols and data privacy policies.
      </p>
    </div>

  </div><!-- /page-wrap -->

  <!-- FOOTER -->
  <footer class="hh-footer">
    <span class="foot-copy">© 2024 Helmet Haven HQ</span>
    <span class="foot-version">V4.2.0-ADMIN</span>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
 /* ── ELEMENTS ── */
  const form       = document.getElementById('loginForm');
  const emailInput = document.getElementById('emailInput');
  const pwInput    = document.getElementById('pwInput');
  const emailErr   = document.getElementById('emailErr');
  const pwErr      = document.getElementById('pwErr');
  const pwHint     = document.getElementById('pwHint');
  const eyeBtn     = document.getElementById('eyeBtn');
  const eyeIcon    = document.getElementById('eyeIcon');
  const submitBtn  = document.getElementById('submitBtn');
  const btnText    = document.getElementById('btnText');
  const btnIcon    = document.getElementById('btnIcon');
  const btnSpinner = document.getElementById('btnSpinner');

  /* ── HELPERS ── */
 /* ── HELPERS ── */
function showErr(input, msgEl, text) {
  input.classList.add('is-invalid');
  input.classList.remove('is-valid');
  msgEl.querySelector('span').textContent = text;
  msgEl.classList.add('show');
}
function showOk(input, msgEl) {
  input.classList.remove('is-invalid');
  input.classList.add('is-valid');
  msgEl.classList.remove('show');
}
function clearState(input, msgEl) {
  input.classList.remove('is-invalid', 'is-valid');
  msgEl.classList.remove('show');
}

/* ── INJECT SERVER ERROR INTO FIELD ── */
const errEl = document.getElementById('serverError');
if (errEl) {
  const serverError = errEl.dataset.msg;
  const msg = serverError.toLowerCase();
  if (msg.includes('password')) {
    emailInput.classList.remove('is-invalid');
    emailInput.classList.add('is-valid');
    showErr(pwInput, pwErr, serverError);
  } else if (msg.includes('email')) {
    showErr(emailInput, emailErr, serverError);
  } else {
    showErr(emailInput, emailErr, serverError);
  }
}

  /* ── EMAIL VALIDATION ── */
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function validateEmail(live = false) {
    const val = emailInput.value.trim();
    if (!val) {
      if (!live) showErr(emailInput, emailErr, 'Email address is required.');
      else clearState(emailInput, emailErr);
      return false;
    }
    if (!EMAIL_RE.test(val)) {
      showErr(emailInput, emailErr, 'Please enter a valid email address.');
      return false;
    }
    showOk(emailInput, emailErr);
    return true;
  }

  emailInput.addEventListener('input', () => validateEmail(true));
  emailInput.addEventListener('blur',  () => validateEmail(false));

  /* ── PASSWORD VALIDATION ── */
  function validatePassword(live = false) {
    const val = pwInput.value;

    if (!val) {
      if (!live) showErr(pwInput, pwErr, 'Password is required.');
      else clearState(pwInput, pwErr);
      pwHint.classList.add('show');
      return false;
    }

    pwHint.classList.remove('show');
    showOk(pwInput, pwErr);
    return true;
  }

  pwInput.addEventListener('input', () => validatePassword(true));
  pwInput.addEventListener('blur',  () => validatePassword(false));

  /* ── TOGGLE PASSWORD VISIBILITY ── */
  eyeBtn.addEventListener('click', () => {
    const isText = pwInput.type === 'text';
    pwInput.type      = isText ? 'password' : 'text';
    eyeIcon.className = isText ? 'bi bi-eye' : 'bi bi-eye-slash';
  });

  /* ── FORM SUBMIT ── */
  form.addEventListener('submit', (e) => {
    const okEmail = validateEmail(false);
    const okPw    = validatePassword(false);

    if (!okEmail || !okPw) {
      e.preventDefault();
      if (!okEmail) emailInput.focus();
      else          pwInput.focus();
      return;
    }

    submitBtn.disabled       = true;
    btnText.textContent      = 'Signing in…';
    btnIcon.style.display    = 'none';
    btnSpinner.style.display = 'block';
  });

  /* ── PREVENT PASTE OF SPACES IN EMAIL ── */
  emailInput.addEventListener('paste', (e) => {
    const pasted = (e.clipboardData || window.clipboardData).getData('text');
    if (/\s/.test(pasted)) {
      e.preventDefault();
      emailInput.value = pasted.trim();
      validateEmail(true);
    }
  });
</script>
</body>
</html>