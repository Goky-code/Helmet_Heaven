    <!-- Toast -->
    <div id="toast"></div>

    <script>
      // ── Data ──────────────────────────────────────────
      let products = [
        {
          id: 1,
          name: "Arai Corsair-X Ghost",
          sku: "AR-CX-001",
          brand: "Arai",
          cat: "Full Face",
          status: "ACTIVE",
          variants: [
            { size: "M", stock: 5, price: 89000, status: "ACTIVE" },
            { size: "L", stock: 2, price: 89000, status: "ACTIVE" },
          ],
        },
        {
          id: 2,
          name: "Shoei RF-1400 White",
          sku: "SH-RF-140",
          brand: "Shoei",
          cat: "Full Face",
          status: "ACTIVE",
          variants: [
            { size: "S", stock: 8, price: 72000, status: "ACTIVE" },
            { size: "XL", stock: 0, price: 72000, status: "INACTIVE" },
          ],
        },
        {
          id: 3,
          name: "Bell Qualifier DLX",
          sku: "BL-QD-992",
          brand: "Bell",
          cat: "Full Face",
          status: "INACTIVE",
          variants: [{ size: "M", stock: 12, price: 32000, status: "ACTIVE" }],
        },
        {
          id: 4,
          name: "AGV Pista GP RR",
          sku: "AG-PGR-56",
          brand: "AGV",
          cat: "Racing",
          status: "ACTIVE",
          variants: [
            { size: "L", stock: 3, price: 120000, status: "ACTIVE" },
            { size: "XL", stock: 1, price: 120000, status: "ACTIVE" },
          ],
        },
        {
          id: 5,
          name: "Shoei X-SPR Pro",
          sku: "SH-XP-210",
          brand: "Shoei",
          cat: "Racing",
          status: "ACTIVE",
          variants: [{ size: "M", stock: 6, price: 95000, status: "ACTIVE" }],
        },
        {
          id: 6,
          name: "Bell MX-9 Adventure",
          sku: "BL-MX-900",
          brand: "Bell",
          cat: "Modular",
          status: "INACTIVE",
          variants: [],
        },
        {
          id: 7,
          name: "Arai Profile-V",
          sku: "AR-PV-330",
          brand: "Arai",
          cat: "Half Face",
          status: "ACTIVE",
          variants: [
            { size: "S", stock: 4, price: 56000, status: "ACTIVE" },
            { size: "M", stock: 9, price: 56000, status: "ACTIVE" },
          ],
        },
        {
          id: 8,
          name: "AGV K6 S",
          sku: "AG-K6-77",
          brand: "AGV",
          cat: "Full Face",
          status: "INACTIVE",
          variants: [
            { size: "XXL", stock: 0, price: 48000, status: "INACTIVE" },
          ],
        },
      ];

      let filteredProducts = [...products];
      let currentPage = 1;
      const perPage = 8;
      let editingId = null;
      let deletingId = null;
      let variantProductId = null;
      let nextId = products.length + 1;

      // ── Render ────────────────────────────────────────
      function render() {
        const start = (currentPage - 1) * perPage;
        const slice = filteredProducts.slice(start, start + perPage);
        const tbody = document.getElementById("tableBody");
        tbody.innerHTML = "";

        if (slice.length === 0) {
          tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:40px; color:var(--muted);">No products found.</td></tr>`;
        } else {
          slice.forEach((p) => {
            const tr = document.createElement("tr");
            tr.innerHTML = `
          <td>
            <span class="product-name">${escHtml(p.name)}</span>
            <span class="product-sku">SKU: ${escHtml(p.sku)}</span>
          </td>
          <td>${escHtml(p.brand)}</td>
          <td>${escHtml(p.cat)}</td>
          <td><span class="badge badge-${p.status === "ACTIVE" ? "active" : "inactive"}">${p.status}</span></td>
          <td>
            <div class="actions">
              <button class="btn-variants" onclick="openVariantsModal(${p.id})">VARIANTS</button>
              <button class="btn-icon edit" title="Edit" onclick="openEditModal(${p.id})">✏️</button>
              <button class="btn-icon del"  title="Delete" onclick="openDeleteModal(${p.id})">🗑️</button>
            </div>
          </td>`;
            tbody.appendChild(tr);
          });
        }

        renderPagination();
        document.getElementById("resultsCount").textContent =
          `Showing ${Math.min(start + slice.length, filteredProducts.length)} of ${filteredProducts.length} result${filteredProducts.length !== 1 ? "s" : ""}`;
      }

      function renderPagination() {
        const total = Math.ceil(filteredProducts.length / perPage);
        const pg = document.getElementById("pagination");
        pg.innerHTML = "";

        const prev = document.createElement("button");
        prev.className = "pg-btn";
        prev.textContent = "Previous";
        if (currentPage === 1) prev.disabled = true;
        prev.onclick = () => {
          currentPage--;
          render();
        };
        pg.appendChild(prev);

        for (let i = 1; i <= total; i++) {
          const b = document.createElement("button");
          b.className = "pg-btn" + (i === currentPage ? " active" : "");
          b.textContent = i;
          b.onclick = (function (p) {
            return () => {
              currentPage = p;
              render();
            };
          })(i);
          pg.appendChild(b);
        }

        const next = document.createElement("button");
        next.className = "pg-btn";
        next.textContent = "Next";
        if (currentPage === total || total === 0) next.disabled = true;
        next.onclick = () => {
          currentPage++;
          render();
        };
        pg.appendChild(next);
      }

      // ── Filter ────────────────────────────────────────
      function filterTable() {
        const q = document.getElementById("searchInput").value.toLowerCase();
        const cat = document.getElementById("catFilter").value;
        const brand = document.getElementById("brandFilter").value;
        const status = document.getElementById("statusFilter").value;
        filteredProducts = products.filter(
          (p) =>
            (p.name.toLowerCase().includes(q) ||
              p.sku.toLowerCase().includes(q)) &&
            (!cat || p.cat === cat) &&
            (!brand || p.brand === brand) &&
            (!status || p.status === status),
        );
        currentPage = 1;
        render();
      }

      // ── Product Modal ─────────────────────────────────
      function openAddModal() {
        editingId = null;
        document.getElementById("modalTitle").textContent = "Add New Product";
        clearErrors();

        // Clear the input fields safely
        document.getElementById("m-name").value = "";
        document.getElementById("m-brand").value = "";
        document.getElementById("m-cat").value = "";
        document.getElementById("m-desc").value = "";

        // Clear previous cropped photo states completely
        for (let i = 0; i < 3; i++) {
          removePhoto(null, i);
        }

        document.getElementById("productModal").classList.add("open");
      }

      function openEditModal(id) {
        editingId = id;
        document.getElementById("modalTitle").textContent = "Edit Product";
        clearErrors();

        const p = products.find((x) => x.id === id);
        if (!p) return;

        document.getElementById("m-name").value = p.name;
        document.getElementById("m-brand").value = p.brand;
        document.getElementById("m-cat").value = p.cat;
        document.getElementById("m-desc").value = p.desc || "";

        document.getElementById("productModal").classList.add("open");
      }

      function openFilePicker(index) {
        document.getElementById(`photo-input-${index}`).click();
      }

      function closeModal() {
        document.getElementById("productModal").classList.remove("open");
        clearModal();
      }

      function clearModal() {
        ["m-name", "m-brand", "m-cat", "m-status"].forEach((id) => {
          document.getElementById(id).value = "";
        });
        document.getElementById("m-desc").value = "";
        [0, 1, 2].forEach((i) => removePhoto(null, i));
        clearErrors();
      }

      function clearErrors() {
        ["fg-name", "fg-brand", "fg-cat", "fg-status"].forEach((id) => {
          document.getElementById(id).classList.remove("has-error");
        });
      }

      // ── Validation ────────────────────────────────────
      function validateModal() {
        clearErrors();
        let valid = true;
        const name = document.getElementById("m-name").value.trim();
        const brand = document.getElementById("m-brand").value;
        const cat = document.getElementById("m-cat").value;
        const st = document.getElementById("m-status").value;
        if (name.length < 3) {
          document.getElementById("fg-name").classList.add("has-error");
          valid = false;
        }
        if (!brand) {
          document.getElementById("fg-brand").classList.add("has-error");
          valid = false;
        }
        if (!cat) {
          document.getElementById("fg-cat").classList.add("has-error");
          valid = false;
        }
        if (!st) {
          document.getElementById("fg-status").classList.add("has-error");
          valid = false;
        }
        return valid;
      }

      // ── Asynchronous Async Submit/Save Handler ───────
      async function saveProduct() {
        clearErrors();
        let hasErr = false;

        const name = document.getElementById("m-name").value.trim();
        const brand = document.getElementById("m-brand").value;
        const cat = document.getElementById("m-cat").value;
        const desc = document.getElementById("m-desc").value.trim();

        if (name.length < 3) {
          document.getElementById("fg-name").classList.add("has-error");
          hasErr = true;
        }
        if (!brand) {
          document.getElementById("fg-brand").classList.add("has-error");
          hasErr = true;
        }
        if (!cat) {
          document.getElementById("fg-cat").classList.add("has-error");
          hasErr = true;
        }

        if (hasErr) return;

        const formData = new FormData();
        formData.append("productName", name);
        formData.append("brand", brand);
        formData.append("category", cat);
        formData.append("description", desc);

        // Filter out empty slots from our uploads array
        const finalImages = [];

        for (let i = 0; i < 3; i++) {
          const input = document.getElementById(`photo-input-${i}`);

          if (input.files.length > 0) {
            finalImages.push(input.files[0]);
          }
        }

        if (!editingId) {
          // ── NEW PRODUCT RULES ──
          if (finalImages.length < 3) {
            alert(
              "Minimum 3 cropped photos are required to save a new product.",
            );
            return;
          }
          if (!editingId && !validateImages()) {
            return;
          }
          // Add all 3 required images
          finalImages.forEach((file) => {
            formData.append("productImages", file);
          });
        } else {
          // ── EDIT PRODUCT RULES ──
          // If the user picked new photos while editing, append them to update the existing slots
          finalImages.forEach((file) => {
            formData.append("productImages", file);
          });
        }

        const targetUrl = editingId
          ? `/admin/edit-product/${editingId}`
          : "/admin/add-product";

        try {
          const response = await fetch(targetUrl, {
            method: "POST",
            body: formData,
          });

          const result = await response.json();

          if (result.success) {
            showToast(result.message || "Product saved successfully!");
            closeModal();
            if (result.redirectUrl) {
              window.location.href = result.redirectUrl;
            } else {
              window.location.reload(); // Refresh to catch changes
            }
          } else {
            showToast(
              result.message || "Error saving product information.",
              true,
            );
          }
        } catch (err) {
          console.error(err);
          showToast("Network request failed.", true);
        }
      }
      // ── Variants Modal ────────────────────────────────
      function openVariantsModal(id) {
        variantProductId = id;
        const p = products.find((x) => x.id === id);
        document.getElementById("variantsTitle").textContent =
          p.name + " — Variants";
        // clear add-form
        document.getElementById("v-size").value = "";
        document.getElementById("v-stock").value = "";
        document.getElementById("v-price").value = "";
        ["vfg-size", "vfg-stock", "vfg-price"].forEach((i) =>
          document.getElementById(i).classList.remove("has-error"),
        );
        renderVariantsTable(p);
        document.getElementById("variantsModal").classList.add("open");
      }

      function renderVariantsTable(p) {
        const tbody = document.getElementById("variantsBody");
        tbody.innerHTML = "";
        if (!p.variants || p.variants.length === 0) {
          tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:24px; color:var(--muted); font-size:13px;">No variants yet. Add one below.</td></tr>`;
          return;
        }
        p.variants.forEach((v, idx) => {
          const tr = document.createElement("tr");
          tr.innerHTML = `
        <td><span style="font-weight:600;">${escHtml(v.size)}</span></td>
        <td>${v.stock}</td>
        <td>₹${v.price.toLocaleString("en-IN")}</td>
        <td>
          <span class="badge badge-${v.status === "ACTIVE" ? "active" : "inactive"}">${v.status}</span>
        </td>
        <td>
          <div class="actions">
            <button class="btn-icon edit" title="Toggle Status" onclick="toggleVariantStatus(${idx})" style="font-size:13px;">⇄</button>
            <button class="btn-icon del" title="Delete Variant" onclick="deleteVariant(${idx})">🗑️</button>
          </div>
        </td>`;
          tbody.appendChild(tr);
        });
      }

      function addVariant() {
        ["vfg-size", "vfg-stock", "vfg-price"].forEach((i) =>
          document.getElementById(i).classList.remove("has-error"),
        );
        let valid = true;
        const size = document.getElementById("v-size").value;
        const stock = parseInt(document.getElementById("v-stock").value);
        const price = parseFloat(document.getElementById("v-price").value);
        if (!size) {
          document.getElementById("vfg-size").classList.add("has-error");
          valid = false;
        }
        if (isNaN(stock) || stock < 0) {
          document.getElementById("vfg-stock").classList.add("has-error");
          valid = false;
        }
        if (isNaN(price) || price <= 0) {
          document.getElementById("vfg-price").classList.add("has-error");
          valid = false;
        }
        if (!valid) return;

        const p = products.find((x) => x.id === variantProductId);
        p.variants.push({
          size,
          stock,
          price,
          status: stock > 0 ? "ACTIVE" : "INACTIVE",
        });
        document.getElementById("v-size").value = "";
        document.getElementById("v-stock").value = "";
        document.getElementById("v-price").value = "";
        renderVariantsTable(p);
        showToast("Variant added!");
      }

      function toggleVariantStatus(idx) {
        const p = products.find((x) => x.id === variantProductId);
        p.variants[idx].status =
          p.variants[idx].status === "ACTIVE" ? "INACTIVE" : "ACTIVE";
        renderVariantsTable(p);
      }

      function deleteVariant(idx) {
        const p = products.find((x) => x.id === variantProductId);
        p.variants.splice(idx, 1);
        renderVariantsTable(p);
        showToast("Variant removed.");
      }

      // ── Delete Product ────────────────────────────────
      function openDeleteModal(id) {
        deletingId = id;
        document.getElementById("deleteModal").classList.add("open");
      }

      function confirmDelete() {
        products = products.filter((p) => p.id !== deletingId);
        deletingId = null;
        document.getElementById("deleteModal").classList.remove("open");
        filterTable();
        showToast("Product deleted.");
      }

      // ── Toast ─────────────────────────────────────────
      function showToast(msg, isOk = true) {
        const t = document.getElementById("toast");
        t.textContent = msg;
        t.className = isOk ? "" : "error";
        t.style.display = "block";
        setTimeout(() => {
          t.style.display = "none";
        }, 3000);
      }

      // ── Sidebar (mobile) ───────────────────────────────
      function toggleSidebar() {
        document.getElementById("sidebar").classList.toggle("open");
        document.getElementById("sidebarBg").classList.toggle("open");
      }
      function closeSidebar() {
        document.getElementById("sidebar").classList.remove("open");
        document.getElementById("sidebarBg").classList.remove("open");
      }

      let cropper;
      let currentInputIndex = null;
      let croppedFiles = [null, null, null]; // Stores the cropped Blob files ready for submission

      // 1. Triggered when an image is selected from a slot
      function previewPhoto(input, index) {
        if (!input.files || !input.files[0]) return;

        currentInputIndex = index;

        const file = input.files[0];

        const reader = new FileReader();

        reader.onload = function (e) {
          const cropImage = document.getElementById("cropImage");

          cropImage.src = e.target.result;

          document.getElementById("cropModal").classList.add("open");

          // destroy old cropper
          if (cropper) {
            cropper.destroy();
          }

          cropper = new Cropper(cropImage, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            responsive: true,
            background: false,
          });
        };

        reader.readAsDataURL(file);
      }

      function removePhoto(event, index) {
        // Prevent JS crash
        if (event) {
          event.stopPropagation();
        }

        croppedFiles[index] = null;

        const input = document.getElementById(`photo-input-${index}`);

        input.value = "";

        const preview = document.getElementById(`photo-preview-${index}`);

        preview.innerHTML = `
    <svg width="24" height="24" fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      viewBox="0 0 24 24"
      style="color:var(--muted)">
      <rect x="3" y="3" width="18"
        height="18" rx="2"/>
      <circle cx="8.5" cy="8.5" r="1.5"/>
      <polyline points="21 15 16 10 5 21"/>
    </svg>

    <span>Photo ${index + 1}</span>
  `;

        input.parentElement.classList.remove("has-photo");
      }
      // ── Utility ───────────────────────────────────────
      function escHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      // Close modals on backdrop click
      document.querySelectorAll(".overlay").forEach((ov) => {
        ov.addEventListener("click", (e) => {
          if (e.target === ov) ov.classList.remove("open");
        });
      });

      // ── Init ──────────────────────────────────────────
      render();

      function cropCurrentImage() {
        if (!cropper) return;

        const canvas = cropper.getCroppedCanvas({
          width: 800,
          height: 800,
        });

        if (!canvas) {
          showToast("Crop failed", false);
          return;
        }

        canvas.toBlob(
          function (blob) {
            if (!blob) {
              showToast("Image processing failed", false);
              return;
            }

            const croppedFile = new File([blob], `cropped-${Date.now()}.jpg`, {
              type: "image/jpeg",
            });

            // save cropped file
            croppedFiles[currentInputIndex] = croppedFile;

            // preview image
            const preview = document.getElementById(
              `photo-preview-${currentInputIndex}`,
            );

            preview.innerHTML = `
      <img 
        src="${URL.createObjectURL(blob)}"
        style="
          width:100%;
          height:100%;
          object-fit:cover;
        "
      >
    `;

            // active border
            const slot = document.getElementById(
              `photo-input-${currentInputIndex}`,
            ).parentElement;

            slot.classList.add("has-photo");

            closeCropModal();
          },
          "image/jpeg",
          0.9,
        );
      }

      function closeCropModal() {
        document.getElementById("cropModal").classList.remove("open");

        if (cropper) {
          cropper.destroy();
          cropper = null;
        }

        currentInputIndex = null;
      }

      function validateImages() {
        const uploadedCount = croppedFiles.filter(
          (file) => file !== null,
        ).length;

        if (uploadedCount < 3) {
          showToast("Minimum 3 cropped product images required", false);

          return false;
        }

        return true;
      }
    </script>
  </body>
</html>
