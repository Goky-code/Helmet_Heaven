// STATUS CHANGE
async function toggleStatus(variantId) {

  const response = await fetch(
    `/admin/product/${currentProductId}/variant/${variantId}/status`,
    {
      method: "PATCH"
    }
  )

  const data = await response.json()

  if (data.success) {
    loadVariants()
  }
}

      function removePhoto(event, index) {
        // Prevent JS crash
        if (event) {
          event.stopPropagation();
        }

        croppedFiles[index] = null;

        const input = document.getElementById(`photo-input-${index}`);

        input.value = "";

        const preview = document.getElementById(`photo-preview-${index}`);

        preview.innerHTML = `
    <svg width="24" height="24" fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      viewBox="0 0 24 24"
      style="color:var(--muted)">
      <rect x="3" y="3" width="18"
        height="18" rx="2"/>
      <circle cx="8.5" cy="8.5" r="1.5"/>
      <polyline points="21 15 16 10 5 21"/>
    </svg>

    <span>Photo ${index + 1}</span>
  `;

        input.parentElement.classList.remove("has-photo");
      }
      // ── Utility ───────────────────────────────────────
      function escHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      // Close modals on backdrop click
      document.querySelectorAll(".overlay").forEach((ov) => {
        ov.addEventListener("click", (e) => {
          if (e.target === ov) ov.classList.remove("open");
        });
      });

      // ── Init ──────────────────────────────────────────
      render();

      function cropCurrentImage() {

  if (!cropper) {
    showToast("Cropper not initialized", false);
    return;
  }

  const canvas = cropper.getCroppedCanvas({
    width: 800,
    height: 800,
    imageSmoothingEnabled: true,
    imageSmoothingQuality: "high",
  });

  if (!canvas) {
    showToast("Failed to crop image", false);
    return;
  }

  canvas.toBlob(
    function (blob) {

      if (!blob) {
        showToast("Blob creation failed", false);
        return;
      }

      const croppedFile = new File(
        [blob],
        `cropped-${Date.now()}.jpg`,
        {
          type: "image/jpeg",
        }
      );

      croppedFiles[currentInputIndex] = croppedFile;

      const preview = document.getElementById(
        `photo-preview-${currentInputIndex}`
      );

      preview.innerHTML = `
        <img
          src="${URL.createObjectURL(blob)}"
          style="
            width:100%;
            height:100%;
            object-fit:cover;
          "
        />
      `;

      const slot = document.getElementById(
        `photo-input-${currentInputIndex}`
      ).parentElement;

      slot.classList.add("has-photo");

      closeCropModal();

      showToast("Image cropped successfully");

    },
    "image/jpeg",
    0.9
  );
}
      function closeCropModal() {

  document
    .getElementById("cropModal")
    .classList.remove("open");

  if (cropper) {
    cropper.destroy();
    cropper = null;
  }
}

      function validateImages() {
        const uploadedCount = croppedFiles.filter(
          (file) => file !== null,
        ).length;

        if (uploadedCount < 3) {
          showToast("Minimum 3 cropped product images required", false);

          return false;
        }

        return true;
      }
