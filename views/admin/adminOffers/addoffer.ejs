      </a>
      <a class="nav-item" href="/admin/brands">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
        Brands
      </a>
      <a class="nav-item" href="/admin/Inventory">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
        Inventory
      </a>
      <a class="nav-item active" href="/admin/offers">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
        Offers
      </a>
      <!-- <a class="nav-item" href="#">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><polyline points="3 9 12 15 21 9"/></svg>
        Banner
      </a> -->
      <a class="nav-item" href="#">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Sales Report
      </a>
      <a class="nav-item" href="/admin/logout">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </a>
    </nav>
  </aside>

  <!-- MAIN -->
  <div class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="hamburger" onclick="toggleSidebar()">☰</button>
        <a href="/admin/offers" class="back-link" title="Back to Offers">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        </a>
        <h1 class="page-title">Add New Offer</h1>
      </div>
      <div class="avatar">AD</div>
    </header>

    <div class="content">
  
      <form class="form-card" id="offerForm" action="/admin/offers/create" method="POST" novalidate>

        <!-- Offer Name -->
        <div class="form-group">
          <label for="offerName">Offer Name <span class="required">*</span></label>
          <input type="text" id="offerName" name="offerName" placeholder="e.g. Summer Special 2024" required />
          <span class="form-error" id="err-offerName">Offer name is required.</span>
        </div>

        <!-- Discount Type + Discount Value -->
        <div class="form-row">
          <div class="form-group">
            <label for="discountType">Discount Type <span class="required">*</span></label>
            <select id="discountType" name="discountType" required onchange="updateDiscountSymbol()">
              <option value="" disabled selected>Select</option>
              <option value="PERCENTAGE">Percentage (%)</option>
              <option value="FIXED">Fixed Amount (₹)</option>
            </select>
            <span class="form-error" id="err-discountType">Please select a discount type.</span>
          </div>

          <div class="form-group">
            <label for="discountValue" id="discountValueLabel">Discount</label>
            <div class="discount-input-wrap">
              <input type="number" id="discountValue" name="discountValue" min="0" step="0.01" placeholder="0" required />
              <span class="discount-symbol" id="discountSymbol">₹</span>
            </div>
            <span class="form-error" id="err-discountValue">Enter a valid discount value.</span>
          </div>
        </div>

        <!-- Start Date + Expiry Date -->
        <div class="form-row">
          <div class="form-group">
            <label for="startDate">Start Date <span class="required">*</span></label>
            <input type="date" id="startDate" name="startDate" required />
            <span class="form-error" id="err-startDate">Start date is required.</span>
          </div>

         <div class="form-group">

    <label for="endDate">
        Expiry Date <span class="required">*</span>
    </label>

    <input
        type="date"
        id="endDate"
        name="endDate"
        required
    >

    <span
        class="form-error"
        id="err-endDate"
    >
        Expiry date must be after start date.
    </span>

</div>
        </div>

        <!-- Offer Type -->
        <div class="form-group">
          <label for="offerType">Offer Type <span class="required">*</span></label>
          <select id="offerType" name="offerType" required onchange="updateOfferForOptions()">
            <option value="" disabled selected>Select</option>
            <option value="PRODUCT">Products</option>
            <option value="CATEGORY">Category</option>
            <option value="BRAND">Brand</option>
          </select>
          <span class="form-error" id="err-offerType">Please select an offer type.</span>
        </div>

       <!-- Offer For -->
<div class="form-group">

  <label for="offerFor">
    Offer For <span class="required">*</span>
  </label>

  <!-- Actual value saved in database -->
  <input
    type="hidden"
    name="offerFor"
    id="offerForValue"
  >

  <!-- Selected Product ID -->
  <input
    type="hidden"
    name="productId"
    id="productId"
  >

  <!-- Selected Category ID -->
  <input
    type="hidden"
    name="categoryId"
    id="categoryId"
  >

  <!-- Selected Brand ID -->
  <input
    type="hidden"
    name="brandId"
    id="brandId"
  >

  <!-- Visible dropdown -->
  <select
    id="offerFor"
    required
  >
    <option value="">Select</option>
  </select>

  <span
    class="form-error"
    id="err-offerFor"
  >
    Please select what this offer applies to.
  </span>

</div>

<div class="form-footer">

  <a
    href="/admin/offers"
    class="btn-cancel"
  >
    Cancel
  </a>

  <button
    type="submit"
    class="btn-primary"
    id="submitBtn"
  >
    Create Offer
  </button>

</div>
</form>
    </div>

    <!-- FOOTER -->
    <footer class="site-footer">
      <span>© <%= new Date().getFullYear() %> Helmet Haven HQ — Administrative Panel</span>
      <div class="footer-links">
        <a href="#">System Status</a>
        <a href="#">Security Policy</a>
        <a href="#">V4.2.0-Admin</a>
      </div>
    </footer>
  </div>

  <div id="toast"></div>

 <script>

  // =========================================================
  // OFFER DATA FROM BACKEND
  // =========================================================

  const OFFER_FOR_DATA = {

    PRODUCT: <%- JSON.stringify(products.map(p => ({
      id: p._id,
      name: p.productName
    }))) %>,

    CATEGORY: <%- JSON.stringify(categories.map(c => ({
      id: c._id,
      name: c.name
    }))) %>
   

  };


  console.log("OFFER_FOR_DATA:", OFFER_FOR_DATA);



  // =========================================================
  // DISCOUNT SYMBOL
  // =========================================================

  function updateDiscountSymbol() {

    const type =
      document.getElementById('discountType').value;

    const symbolEl =
      document.getElementById('discountSymbol');

    const input =
      document.getElementById('discountValue');

    const label =
      document.getElementById('discountValueLabel');


    if (type === 'PERCENTAGE') {

      symbolEl.textContent = '%';

      input.max = 100;

      label.textContent =
        'Discount Percentage (%)';

      input.placeholder = 'e.g. 20';

    }

    else if (type === 'FIXED') {

      symbolEl.textContent = '₹';

      input.removeAttribute('max');

      label.textContent =
        'Discount Amount (₹)';

      input.placeholder = 'e.g. 500';

    }

    else {

      symbolEl.textContent = '₹';

      label.textContent =
        'Discount';

      input.placeholder = '0';

    }

  }



  // =========================================================
  // OFFER FOR OPTIONS
  // =========================================================

 function updateOfferForOptions() {

    const type = document.getElementById("offerType").value;

    const offerForSelect = document.getElementById("offerFor");
    const offerForValue = document.getElementById("offerForValue");

    const productId = document.getElementById("productId");
    const categoryId = document.getElementById("categoryId");
    const brandId = document.getElementById("brandId");

    // Clear old values
    offerForSelect.innerHTML = "";

    offerForValue.value = "";
    productId.value = "";
    categoryId.value = "";
    brandId.value = "";


    // =========================
    // PRODUCT
    // =========================

    if (type === "PRODUCT") {

        // All Products
        const allOption = document.createElement("option");

        allOption.value = "ALL_PRODUCTS";
        allOption.textContent = "All Products";

        offerForSelect.appendChild(allOption);


        // Product list
        const products = OFFER_FOR_DATA.PRODUCT || [];

        products.forEach(product => {

            const option = document.createElement("option");

            option.value = product.id;
            option.textContent = product.name;

            offerForSelect.appendChild(option);

        });


        // Default = All Products
        offerForValue.value = "All Products";


        // When product is selected
        offerForSelect.onchange = function () {

            if (this.value === "ALL_PRODUCTS") {

                offerForValue.value = "All Products";

                productId.value = "";

            } else {

                const selectedProduct =
                    products.find(product => product.id === this.value);

                if (selectedProduct) {

                    offerForValue.value = selectedProduct.name;

                    productId.value = selectedProduct.id;

                }

            }

        };

        return;
    }


    // =========================
    // CATEGORY
    // =========================

    if (type === "CATEGORY") {

        const placeholder = document.createElement("option");

        placeholder.value = "";
        placeholder.textContent = "Select Category";
        placeholder.disabled = true;
        placeholder.selected = true;

        offerForSelect.appendChild(placeholder);


        const categories = OFFER_FOR_DATA.CATEGORY || [];

        categories.forEach(category => {

            const option = document.createElement("option");

            option.value = category.id;
            option.textContent = category.name;

            offerForSelect.appendChild(option);

        });


        offerForSelect.onchange = function () {

            const selectedCategory =
                categories.find(category => category.id === this.value);

            if (selectedCategory) {

                offerForValue.value = selectedCategory.name;

                categoryId.value = selectedCategory.id;

            }

        };

        return;
    }
}


  // =========================================================
  // FORM VALIDATION
  // =========================================================

  function clearErrors() {

    document
      .querySelectorAll('.form-error')
      .forEach(el => {

        el.classList.remove('show');

      });

  }



  function showError(fieldId) {

    const err =
      document.getElementById(
        'err-' + fieldId
      );


    if (err) {

      err.classList.add('show');

    }

  }



  // =========================================================
  // PAGE INITIALIZATION
  // =========================================================

  document.addEventListener(
    'DOMContentLoaded',
    function () {

      const offerType =
        document.getElementById('offerType');


      const offerFor =
        document.getElementById('offerFor');


      const discountType =
        document.getElementById('discountType');


      // -----------------------------------------------
      // Discount
      // -----------------------------------------------

      updateDiscountSymbol();


      discountType.addEventListener(
        'change',
        updateDiscountSymbol
      );


      // -----------------------------------------------
      // Offer Type
      // -----------------------------------------------

      offerType.addEventListener(
        'change',
        updateOfferForOptions
      );


      // -----------------------------------------------
      // IMPORTANT
      // Populate Offer For immediately
      // -----------------------------------------------

      updateOfferForOptions();



      // =================================================
      // FORM SUBMIT
      // =================================================

      document
        .getElementById('offerForm')
        .addEventListener(
          'submit',
          function (e) {

            clearErrors();

            let valid = true;



            // -----------------------------------------
            // Get values
            // -----------------------------------------

            const offerName =
              document
                .getElementById('offerName')
                .value
                .trim();


            const discountTypeValue =
              document
                .getElementById('discountType')
                .value;


            const discountValue =
              document
                .getElementById('discountValue')
                .value;


            const startDate =
              document
                .getElementById('startDate')
                .value;


            const endDate =
              document
                .getElementById('endDate')
                .value;


            const offerTypeValue =
              document
                .getElementById('offerType')
                .value;


            const offerForSelectValue =
              document
                .getElementById('offerFor')
                .value;


            const offerForValue =
              document
                .getElementById('offerForValue')
                .value;



            // -----------------------------------------
            // Offer Name
            // -----------------------------------------

            if (!offerName) {

              showError('offerName');

              valid = false;

            }



            // -----------------------------------------
            // Discount Type
            // -----------------------------------------

            if (!discountTypeValue) {

              showError('discountType');

              valid = false;

            }



            // -----------------------------------------
            // Discount Value
            // -----------------------------------------

            if (
              !discountValue ||
              Number(discountValue) <= 0
            ) {

              showError('discountValue');

              valid = false;

            }


            if (
              discountTypeValue === 'PERCENTAGE' &&
              Number(discountValue) > 100
            ) {

              showError('discountValue');

              valid = false;

            }



            // -----------------------------------------
            // Start Date
            // -----------------------------------------

            if (!startDate) {

              showError('startDate');

              valid = false;

            }



            // -----------------------------------------
            // End Date
            // -----------------------------------------

            if (!endDate) {

              showError('endDate');

              valid = false;

            }

            if (
             startDate &&
             endDate &&
             new Date(endDate) <= new Date(startDate)
            ) {

              showError('endDate');

              valid = false;

            }



            // -----------------------------------------
            // Offer Type
            // -----------------------------------------

            if (!offerTypeValue) {

              showError('offerType');

              valid = false;

            }



            // -----------------------------------------
            // Offer For
            // -----------------------------------------

            if (
              !offerForSelectValue ||
              !offerForValue
            ) {

              showError('offerFor');

              valid = false;

            }



            // -----------------------------------------
            // Stop submit if invalid
            // -----------------------------------------

            if (!valid) {

              e.preventDefault();

              if (typeof showToast === 'function') {

                showToast(
                  'Please fix the highlighted fields.',
                  false
                );

              }

              return;

            }

          }
        );

    }
  );



  // =========================================================
  // SIDEBAR
  // =========================================================

  function toggleSidebar() {

    document
      .getElementById('sidebar')
      .classList
      .toggle('open');


    document
      .getElementById('sidebarBg')
      .classList
      .toggle('open');

  }



  function closeSidebar() {

    document
      .getElementById('sidebar')
      .classList
      .remove('open');


    document
      .getElementById('sidebarBg')
      .classList
      .remove('open');

  }

</script>
</body>
</html>