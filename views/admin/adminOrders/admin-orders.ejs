<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Helmet Haven – Orders</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d0f14;
      --sidebar: #111318;
      --card: #161a22;
      --border: #252934;
      --surface: #1e2330;
      --accent: #3b6ef5;
      --accent2: #5c87ff;
      --text: #e8eaf0;
      --muted: #6b7280;
      --green: #22c55e;
      --orange: #f59e0b;
      --red: #ef4444;
      --font-head: "Syne", sans-serif;
      --font-body: "DM Sans", sans-serif;
      --sidebar-w: 240px;
      --radius: 10px;
    }

    body { font-family: var(--font-body); background: var(--bg); color: var(--text); min-height: 100vh; }

    /* SIDEBAR */
    .sidebar { width: var(--sidebar-w); background: var(--sidebar); border-right: 1px solid var(--border); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh; z-index: 100; transition: transform 0.3s ease; }
    .sidebar-logo { display: flex; align-items: center; gap: 10px; padding: 22px 20px; border-bottom: 1px solid var(--border); }
    .logo-icon { width: 34px; height: 34px; background: var(--accent); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .logo-text { font-family: var(--font-head); font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text); }
    nav.nav-list { flex: 1; padding: 14px 0; overflow-y: auto; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 20px; font-size: 12px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); cursor: pointer; transition: all 0.2s; border-left: 3px solid transparent; text-decoration: none; }
    .nav-item:hover { color: var(--text); background: rgba(255,255,255,0.04); }
    .nav-item.active { color: var(--accent2); background: rgba(59,110,245,0.1); border-left-color: var(--accent); }
    .nav-item svg { flex-shrink: 0; opacity: 0.7; }
    .nav-item.active svg, .nav-item:hover svg { opacity: 1; }

    /* MAIN */
    .main { margin-left: var(--sidebar-w); display: flex; flex-direction: column; min-height: 100vh; }

    /* TOPBAR */
    .topbar { display: flex; align-items: center; justify-content: space-between; padding: 18px 28px; border-bottom: 1px solid var(--border); background: var(--sidebar); position: sticky; top: 0; z-index: 50; }
    .topbar-left { display: flex; align-items: center; gap: 14px; }
    .hamburger { display: none; background: none; border: none; color: var(--text); cursor: pointer; font-size: 20px; padding: 4px; }
    .page-title { font-family: var(--font-head); font-size: 20px; font-weight: 700; }
    .topbar-right { display: flex; align-items: center; gap: 18px; }
    .bell-btn { position: relative; background: none; border: none; color: var(--text); font-size: 18px; cursor: pointer; }
    .bell-dot { position: absolute; top: -2px; right: -2px; width: 8px; height: 8px; border-radius: 50%; background: var(--red); border: 2px solid var(--sidebar); }
    .avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: #fff; display: flex; align-items: center; justify-content: center; font-family: var(--font-head); font-weight: 700; font-size: 13px; }

    /* CONTENT */
    .content { padding: 24px 28px; flex: 1; }

    /* FILTER CARD */
    .filter-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; margin-bottom: 22px; }
    .search-box { position: relative; flex: 1; min-width: 220px; }
    .search-box svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
    .search-box input { width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px 10px 40px; color: var(--text); font-family: var(--font-body); font-size: 14px; outline: none; transition: border-color 0.2s; }
    .search-box input::placeholder { color: var(--muted); }
    .search-box input:focus { border-color: var(--accent); }

    .status-tabs { display: flex; gap: 8px; flex-wrap: wrap; }
    .status-tab { background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: 999px; padding: 8px 18px; font-size: 13px; font-weight: 600; cursor: pointer; transition: 0.2s; white-space: nowrap; text-decoration: none; display: inline-block; }
    .status-tab:hover { border-color: var(--accent); color: var(--text); }
    .status-tab.active { background: var(--accent); border-color: var(--accent); color: #fff; }

    /* TABLE */
    .table-wrap { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
    .table-scroll { overflow-x: auto; }
    table.orders-table { width: 100%; border-collapse: collapse; min-width: 760px; }
    thead { background: var(--surface); }
    th { padding: 13px 18px; text-align: left; font-size: 11px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
    tbody tr { border-top: 1px solid var(--border); transition: background 0.15s; }
    tbody tr:hover { background: rgba(255,255,255,0.025); }
    td { padding: 15px 18px; font-size: 14px; vertical-align: middle; }
    .order-id { color: var(--accent2); font-weight: 700; text-decoration: none; }
    .order-id:hover { color: var(--accent); }
    .order-date { font-weight: 600; }
    .cust-name { font-weight: 600; color: var(--text); display: block; margin-bottom: 3px; }
    .cust-email { font-size: 11px; color: var(--muted); font-weight: 400; }
    .items-badge { display: inline-block; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; font-size: 12px; font-weight: 600; color: var(--text); white-space: nowrap; }
    .total-amount { font-weight: 700; }

    .badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; white-space: nowrap; }
    .badge-delivered { background: rgba(34,197,94,0.12); color: var(--green); border: 1px solid rgba(34,197,94,0.25); }
    .badge-pending { background: rgba(245,158,11,0.12); color: var(--orange); border: 1px solid rgba(245,158,11,0.25); }
    .badge-cancelled { background: rgba(239,68,68,0.12); color: var(--red); border: 1px solid rgba(239,68,68,0.25); }
    .badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

    .btn-edit { background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: 7px; padding: 7px 18px; font-family: var(--font-body); font-size: 12px; font-weight: 700; cursor: pointer; transition: 0.2s; white-space: nowrap; text-decoration: none; display: inline-block; }
    .btn-edit:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

    .empty-row td { text-align: center; padding: 48px; color: var(--muted); font-size: 14px; }

    /* PAGINATION */
    .table-footer { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 10px; }
    .results-count { font-size: 13px; color: var(--muted); }
    .pagination { display: flex; align-items: center; gap: 8px; margin: 0; }
    .pagination a { text-decoration: none; padding: 8px 14px; border: 1px solid var(--border); border-radius: 8px; color: var(--text); background: var(--surface); transition: 0.2s; font-size: 13px; }
    .pagination a:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
    .pagination a.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .pagination a.disabled { opacity: 0.4; pointer-events: none; }

    /* PAGE FOOTER */
    .page-footer { display: flex; align-items: center; justify-content: space-between; padding: 18px 28px; border-top: 1px solid var(--border); color: var(--muted); font-size: 12px; flex-wrap: wrap; gap: 10px; }
    .page-footer a { color: var(--muted); text-decoration: none; margin-left: 18px; }
    .page-footer a:hover { color: var(--text); }
    .footer-links a:first-child { margin-left: 0; }

    /* TOAST */
    #toast { position: fixed; bottom: 30px; right: 30px; background: var(--green); color: #fff; padding: 12px 22px; border-radius: 10px; font-size: 14px; font-weight: 600; display: none; z-index: 999; }
    #toast.error { background: var(--red); }

    /* SIDEBAR OVERLAY BG */
    .overlay-bg { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 90; }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      th:nth-child(3), td:nth-child(3) { display: none; }
    }
    @media (max-width: 700px) {
      :root { --sidebar-w: 0px; }
      .sidebar { transform: translateX(-240px); width: 240px; }
      .sidebar.open { transform: translateX(0); }
      .overlay-bg.open { display: block; }
      .main { margin-left: 0; }
      .hamburger { display: block; }
      .content { padding: 16px; }
      .filter-card { padding: 16px; }
      .page-footer { flex-direction: column; align-items: flex-start; text-align: left; }
      .footer-links { display: flex; flex-direction: column; gap: 4px; }
      .footer-links a { margin-left: 0; }
    }
    @media (max-width: 480px) {
      th:nth-child(4), td:nth-child(4) { display: none; }
      .status-tabs { width: 100%; }
      .status-tab { flex: 1; text-align: center; padding: 8px 10px; }
    }
  </style>
</head>
<body>

  <div class="overlay-bg" id="sidebarBg" onclick="closeSidebar()"></div>

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-icon">🪖</div>
      <span class="logo-text">Helmet Haven</span>
    </div>
    <nav class="nav-list">
      <a class="nav-item" href="/admin/adminDashboard">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Dashboard
      </a>
      <a class="nav-item" href="/admin/products">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        Products
      </a>
      <a class="nav-item" href="/admin/adminCustomer">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        Customers
      </a>
      <a class="nav-item active" href="/admin/orders">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
        Orders
      </a>
      <a class="nav-item" href="#">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        Coupons
      </a>
      <a class="nav-item" href="/admin/categories">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 20h16M4 4h16M9 4v16M15 4v16"/></svg>
        Category
      </a>
      <a class="nav-item" href="/admin/brands">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
        Brands
      </a>
      <a class="nav-item" href="#">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
        Return Requests
      </a>
      <a class="nav-item" href="#">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
        Offers
      </a>
      <a class="nav-item" href="#">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><polyline points="3 9 12 15 21 9"/></svg>
        Banner
      </a>
      <a class="nav-item" href="#">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Sales Report
      </a>
      <a class="nav-item" href="/admin/logout">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </a>
    </nav>
  </aside>

  <!-- MAIN -->
  <div class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="hamburger" onclick="toggleSidebar()">☰</button>
        <h1 class="page-title">Orders</h1>
      </div>
      <div class="topbar-right">
        <button class="bell-btn" aria-label="Notifications">
      <i class="bi bi-bell"></i>
      <span class="badge-dot"></span>
    </button>
        <div class="avatar">AD</div>
      </div>
    </header>

    <div class="content">

      <!-- Filter -->
      <form class="filter-card d-flex flex-wrap gap-3 align-items-center" id="filterForm" method="GET" action="/admin/orders">
        <div class="search-box">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            type="text"
            id="searchInput"
            name="search"
            placeholder="Search order ID, customer..."
            value="<%= typeof search !== 'undefined' ? search : '' %>"
          />
        </div>
        <input type="hidden" name="status" id="statusInput" value="<%= typeof status !== 'undefined' ? status : '' %>" />

        <div class="status-tabs ms-md-auto" id="statusTabs">
          <a
            href="?search=<%= typeof search !== 'undefined' ? search : '' %>&status=&page=1"
            class="status-tab <%= (typeof status === 'undefined' || status === '') ? 'active' : '' %>"
          >All</a>
          <a
            href="?search=<%= typeof search !== 'undefined' ? search : '' %>&status=Pending&page=1"
            class="status-tab <%= typeof status !== 'undefined' && status === 'Pending' ? 'active' : '' %>"
          >Pending</a>
          <a
            href="?search=<%= typeof search !== 'undefined' ? search : '' %>&status=Delivered&page=1"
            class="status-tab <%= typeof status !== 'undefined' && status === 'Delivered' ? 'active' : '' %>"
          >Delivered</a>
          <a
            href="?search=<%= typeof search !== 'undefined' ? search : '' %>&status=Cancelled&page=1"
            class="status-tab <%= typeof status !== 'undefined' && status === 'Cancelled' ? 'active' : '' %>"
          >Cancelled</a>
        </div>
      </form>

      <!-- Table -->
      <div class="table-wrap">
        <div class="table-scroll">
          <table class="orders-table">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Customer Name</th>
                <th>Items</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!orders || orders.length === 0) { %>
                <tr class="empty-row">
                  <td colspan="7">No orders found.</td>
                </tr>
              <% } else { %>
                <% orders.forEach((o) => { %>
                  <%
                    const statusLabel = o.orderStatus || 'Pending';
                    const statusCls =
                      statusLabel === 'Delivered' ? 'badge-delivered' :
                      statusLabel === 'Cancelled' ? 'badge-cancelled' :
                      'badge-pending';
                    const itemCount = o.items ? o.items.length : 0;
                    const orderDate = o.createdAt
                      ? new Date(o.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                      : 'N/A';
                    const customerName = (o.userId && o.userId.firstName)
                      ? `${o.userId.firstName} ${o.userId.lastName || ''}`.trim()
                      : (o.address && o.address.name ? o.address.name : 'N/A');
                  %>
                  <tr>
                    <td>
                      <a href="/admin/orders/<%= o._id %>" class="order-id">
                        #<%= o.orderId || o._id %>
                      </a>
                    </td>
                    <td><span class="order-date"><%= orderDate %></span></td>
                    <td>
                      <span class="cust-name"><%= customerName %></span>
                      <span class="cust-email"><%= o.userId && o.userId.email ? o.userId.email : '' %></span>
                    </td>
                    <td><span class="items-badge"><%= itemCount %> <%= itemCount === 1 ? 'Item' : 'Items' %></span></td>
                    <td><span class="total-amount">₹<%= (o.grandTotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span></td>
                    <td><span class="badge <%= statusCls %>"><%= statusLabel %></span></td>
                    <td><a href="/admin/orders/<%= o._id %>" class="btn-edit">View Details</a></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="table-footer">
          <span class="results-count">
            Showing <%= orders.length %> of <%= typeof totalOrders !== 'undefined' ? totalOrders : orders.length %> order<%= (typeof totalOrders !== 'undefined' ? totalOrders : orders.length) !== 1 ? 's' : '' %>
          </span>

          <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <div class="pagination">
            <% if (currentPage > 1) { %>
              <a href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>&status=<%= status || '' %>">Previous</a>
            <% } else { %>
              <a href="#" class="disabled">Previous</a>
            <% } %>

            <% for (let i = 1; i <= totalPages; i++) { %>
              <a
                href="?page=<%= i %>&search=<%= search || '' %>&status=<%= status || '' %>"
                class="<%= currentPage === i ? 'active' : '' %>"
              ><%= i %></a>
            <% } %>

            <% if (currentPage < totalPages) { %>
              <a href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>&status=<%= status || '' %>">Next</a>
            <% } else { %>
              <a href="#" class="disabled">Next</a>
            <% } %>
          </div>
          <% } %>
        </div>
      </div>

    </div>

    <footer class="page-footer">
      <span>© 2024 Helmet Haven HQ — Administrative Panel</span>
      <span class="footer-links">
        <a href="#">System Status</a>
        <a href="#">Security Policy</a>
        <a href="#">V4.2.0-Admin</a>
      </span>
    </footer>
  </div>

  <div id="toast"></div>

  <script>
    /* ── Debounced live search: resubmits the filter form ── */
    let searchDebounce;
    document.getElementById("searchInput").addEventListener("input", () => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => {
        document.getElementById("filterForm").submit();
      }, 400);
    });

    function showToast(msg, isOk = true) {
      const t = document.getElementById("toast");
      t.textContent = msg;
      t.className = isOk ? "" : "error";
      t.style.display = "block";
      setTimeout(() => { t.style.display = "none"; }, 3000);
    }

    /* ── Sidebar ── */
    function toggleSidebar() {
      document.getElementById("sidebar").classList.toggle("open");
      document.getElementById("sidebarBg").classList.toggle("open");
    }
    function closeSidebar() {
      document.getElementById("sidebar").classList.remove("open");
      document.getElementById("sidebarBg").classList.remove("open");
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>