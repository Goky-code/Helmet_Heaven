<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Helmet Haven — Edit Brand</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #0f1117;
    --sidebar-bg: #13161f;
    --card-bg: #181c27;
    --card-border: #232840;
    --accent: #3b82f6;
    --accent-glow: rgba(59,130,246,0.18);
    --active-green: #22c55e;
    --inactive-red: #ef4444;
    --text-primary: #f0f2f8;
    --text-secondary: #8892b0;
    --text-muted: #4a5278;
    --sidebar-width: 240px;
    --radius: 12px;
    --tr: 0.22s cubic-bezier(.4,0,.2,1);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text-primary); overflow-x: hidden; }

  .shell { display: flex; min-height: 100vh; }

  /* ── SIDEBAR ── */
  .sidebar {
    width: var(--sidebar-width); background: var(--sidebar-bg);
    border-right: 1px solid var(--card-border);
    display: flex; flex-direction: column;
    position: fixed; top: 0; left: 0; bottom: 0; z-index: 200;
    transition: transform var(--tr);
  }
  .sidebar-logo {
    display: flex; align-items: center; gap: 10px;
    padding: 20px 18px 16px;
    border-bottom: 1px solid var(--card-border);
  }
  .logo-icon { width: 34px; height: 34px; background: var(--accent); border-radius: 9px; display: grid; place-items: center; font-size: 18px; }
  .logo-text { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 15px; letter-spacing: .5px; }
  .nav { flex: 1; padding: 12px 10px; overflow-y: auto; }
  .nav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 12px; border-radius: 9px; cursor: pointer;
    font-size: 12.5px; font-weight: 500; color: var(--text-secondary);
    letter-spacing: .6px; text-transform: uppercase; margin-bottom: 2px;
    transition: background var(--tr), color var(--tr);
    white-space: nowrap; text-decoration: none;
  }
  .nav-item:hover { background: rgba(255,255,255,.04); color: var(--text-primary); }
  .nav-item.active { background: var(--accent-glow); color: var(--accent); font-weight: 600; }

  /* ── MAIN ── */
  .main { margin-left: var(--sidebar-width); flex: 1; display: flex; flex-direction: column; min-height: 100vh; transition: margin-left var(--tr); }

  /* ── TOPBAR ── */
  .topbar {
    height: 60px; background: var(--sidebar-bg); border-bottom: 1px solid var(--card-border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 24px; position: sticky; top: 0; z-index: 100;
  }
  .topbar-left { display: flex; align-items: center; gap: 12px; }
  .menu-btn { display: none; background: none; border: none; cursor: pointer; color: var(--text-secondary); padding: 6px; border-radius: 7px; transition: background var(--tr); }
  .menu-btn:hover { background: rgba(255,255,255,.06); }
  .logo-top { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 16px; display: flex; align-items: center; gap: 8px; }
  .topbar-right { display: flex; align-items: center; gap: 14px; }
  .notif-btn { background: none; border: none; cursor: pointer; color: var(--text-secondary); padding: 6px; border-radius: 8px; transition: color var(--tr); }
  .avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--accent); display: grid; place-items: center; font-weight: 700; font-size: 12px; }

  /* ── CONTENT ── */
  .content { padding: 28px; flex: 1; }
  .breadcrumb { font-size: 12px; color: var(--text-muted); margin-bottom: 10px; letter-spacing: .4px; text-transform: uppercase; }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; transition: color var(--tr); }
  .breadcrumb a:hover { color: var(--text-secondary); }
  .breadcrumb span { color: var(--accent); font-weight: 600; }
  .page-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; }
  .page-title { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 26px; }

  /* ── FORM CARD ── */
  .form-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--radius); max-width: 680px; }
  .form-card-header { padding: 22px 28px 20px; border-bottom: 1px solid var(--card-border); }
  .form-card-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 17px; }
  .form-card-sub { font-size: 12.5px; color: var(--text-muted); margin-top: 2px; }

  .form-body { padding: 28px; display: flex; flex-direction: column; gap: 24px; }

  /* fields */
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field label { font-size: 13px; font-weight: 600; color: var(--text-secondary); }
  .req { color: var(--inactive-red); }
  .field input, .field textarea, .field select {
    background: rgba(255,255,255,.05); border: 1.5px solid var(--card-border);
    border-radius: 9px; padding: 12px 14px;
    color: var(--text-primary); font-family: 'DM Sans', sans-serif; font-size: 14px;
    outline: none; width: 100%;
    transition: border-color var(--tr), box-shadow var(--tr);
  }
  .field textarea { resize: vertical; min-height: 110px; line-height: 1.6; }
  .field select option { background: #1a1e2e; }
  .field input::placeholder, .field textarea::placeholder { color: var(--text-muted); }
  .field input:focus, .field textarea:focus, .field select:focus {
    border-color: var(--accent); box-shadow: 0 0 0 3px rgba(59,130,246,.14);
  }
  .field input.err, .field textarea.err, .field select.err {
    border-color: var(--inactive-red); box-shadow: 0 0 0 3px rgba(239,68,68,.12);
  }
  .err-msg { font-size: 11.5px; color: var(--inactive-red); display: none; margin-top: 4px; }
  .err-msg.show { display: block; }
  .field-hint { font-size: 12px; color: var(--text-muted); line-height: 1.5; margin-top: 4px; }

  .form-footer {
    padding: 20px 28px 24px; border-top: 1px solid var(--card-border);
    display: flex; justify-content: flex-end; align-items: center; gap: 10px;
  }
  .btn-cancel {
    padding: 10px 22px; border-radius: 9px; background: rgba(255,255,255,.06);
    border: 1px solid var(--card-border); color: var(--text-secondary);
    font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 600;
    cursor: pointer; text-decoration: none; display: inline-flex; align-items: center;
    transition: background var(--tr), color var(--tr);
  }
  .btn-cancel:hover { background: rgba(255,255,255,.1); color: var(--text-primary); }
  .btn-save {
    padding: 10px 28px; border-radius: 9px; background: var(--accent);
    border: none; color: #fff; font-family: 'DM Sans', sans-serif;
    font-size: 14px; font-weight: 600; cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px;
    transition: opacity var(--tr), transform var(--tr);
  }
  .btn-save:hover:not(:disabled) { opacity: .88; transform: translateY(-1px); }
  .btn-save:disabled { opacity: .5; cursor: not-allowed; transform: none; }

  /* toast */
  .toast {
    position: fixed; bottom: 22px; right: 22px; z-index: 600;
    background: var(--card-bg); border: 1px solid var(--card-border);
    border-radius: 10px; padding: 13px 18px;
    display: flex; align-items: center; gap: 10px;
    box-shadow: 0 8px 32px rgba(0,0,0,.45);
    transform: translateY(70px); opacity: 0;
    transition: transform .3s cubic-bezier(.4,0,.2,1), opacity .3s;
    max-width: 290px;
  }
  .toast.show { transform: translateY(0); opacity: 1; }
  .toast-text { font-size: 13.5px; font-weight: 500; }

  .sb-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 150; }
  .sb-overlay.show { display: block; }

  footer {
    padding: 14px 24px; border-top: 1px solid var(--card-border);
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 8px; font-size: 11px; color: var(--text-muted); letter-spacing: .4px;
  }
  
  @media (max-width: 900px) {
    .sidebar { transform: translateX(-100%); }
    .sidebar.open { transform: translateX(0); }
    .main { margin-left: 0; }
    .menu-btn { display: flex; }
  }
</style>
</head>
<body>

<div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

<div class="shell">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-icon">🪖</div>
      <span class="logo-text">HELMET HAVEN</span>
    </div>
   <nav class="nav">
      <a href="/admin/adminDashboard" class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Dashboard
      </a>
      <a href="/admin/products" class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        Products
      </a>
      <a href="/admin/adminCustomer" class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        Customers
      </a>
      <a href ="/admin/orders" class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
        Orders
      </a>
      <div class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        Coupons
      </div>
      <a href="/admin/categories" class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 20h16M4 4h16M9 4v16M15 4v16"/></svg>
        Category
      </a>
      <a href="/admin/brands" class="nav-item active">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
        Brands
      </a>
      <div class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
        Return Requests
      </div>
      <div class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
        Offers
      </div>
      <div class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><polyline points="3 9 12 15 21 9"/></svg>
        Banner
      </div>
      <div class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Sales Report
      </div>
      <a href="/admin/logout" class="nav-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </a>
    </nav>
  </aside>

  <div class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-btn" onclick="toggleSidebar()">☰</button>
        <div class="logo-top">
          <span class="logo-text">HELMET HAVEN</span>
        </div>
      </div>
      <div class="topbar-right">
        <div class="avatar">AD</div>
      </div>
    </header>

    <main class="content">
      <div class="breadcrumb">
        Admin › <a href="/admin/brands">Brands</a> › <span>Edit Brand</span>
      </div>

      <div class="page-header">
        <h1 class="page-title">Edit Brand</h1>
      </div>

      <div class="form-card">
        <div class="form-card-header">
          <div class="form-card-title">Edit Brand Details</div>
          <div class="form-card-sub">Update the information below and save your changes</div>
        </div>

        <div class="form-body">
          <div class="field">
            <label for="bName">Brand Name <span class="req">*</span></label>
            <input
              type="text"
              id="bName"
              name="name"
              value="<%= brand.name %>"
              placeholder="e.g. Arai Helmets"
              maxlength="60"
              autocomplete="off"
              oninput="liveVal('bName')"
            />
            <span class="err-msg" id="bNameErr">Brand name is required (minimum 2 characters).</span>
          </div>

          <div class="field">
            <label for="bDesc">Description <span class="req">*</span></label>
            <textarea
              id="bDesc"
              name="description"
              placeholder="Short description about this brand…"
              maxlength="300"
              oninput="liveVal('bDesc')"
            ><%= brand.description %></textarea>
            <span class="err-msg" id="bDescErr">Description is required (minimum 10 characters).</span>
          </div>

          <div class="field">
            <label for="bStatus">Status <span class="req">*</span></label>
            <select id="bStatus" name="status" onchange="liveVal('bStatus')">
              <option value="">— Select Status —</option>
              <option value="active"  <%= brand.isListed ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= !brand.isListed ? 'selected' : '' %>>Inactive</option>
            </select>
            <span class="err-msg" id="bStatusErr">Please select a status for this brand.</span>
            <span class="field-hint">Active brands will be visible in the product catalogue.</span>
          </div>
        </div>

        <div class="form-footer">
          <a href="/admin/brands" class="btn-cancel">Cancel</a>
          <button class="btn-save" id="saveBtn" onclick="saveBrand()">Update Brand</button>
        </div>
      </div>
    </main>

    <footer>
      <span>© 2026 HELMET HAVEN SYSTEM</span>
    </footer>
  </div>
</div>

<div class="toast" id="toast">
  <span id="toastIcon" style="font-size:17px"></span>
  <span class="toast-text" id="toastText"></span>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

const brandId = "<%= brand._id %>";
const originalStatus = <%- JSON.stringify(brand.isListed ? "active" : "inactive") %>;
  // ── VALIDATION ──
  function validateField(id) {
    const val = document.getElementById(id).value.trim();
    let ok = true;
    if (id === 'bName') ok = val.length >= 2;
    if (id === 'bDesc') ok = val.length >= 10;
    if (id === 'bStatus') ok = val !== '';
    
    document.getElementById(id).classList.toggle('err', !ok);
    document.getElementById(id + 'Err').classList.toggle('show', !ok);
    return ok;
  }

  function liveVal(id) {
    if (document.getElementById(id).classList.contains('err')) {
      validateField(id);
    }
  }

  function validateAll() {
    return ['bName', 'bDesc', 'bStatus'].map(id => validateField(id)).every(Boolean);
  }

  // ── SAVE ROUTINE ──
 async function saveBrand() {
  if (!validateAll()) return;

  const name = document.getElementById('bName').value.trim();
  const description = document.getElementById('bDesc').value.trim();
  const status = document.getElementById('bStatus').value;

  // Show confirmation only if status changed
  if (status !== originalStatus) {

    const action = status === "inactive" ? "Unlist" : "List";

    const result = await Swal.fire({
      title: `${action} Brand?`,
      text: status === "inactive"
        ? "This brand will no longer be visible to customers."
        : "This brand will be visible to customers again.",
      icon: "warning",
        background: "#161b24",
          color: "#ffffff",
      showCancelButton: true,
      confirmButtonColor: "#d33",
      cancelButtonColor: "#6c757d",
      confirmButtonText: `Yes, ${action}`,
      cancelButtonText: "Cancel"
    });

    if (!result.isConfirmed) {
      return;
    }
  }

  const saveBtn = document.getElementById('saveBtn');
  saveBtn.disabled = true;
  saveBtn.textContent = 'Saving…';

  try {

    const response = await fetch('/admin/edit-brand/' + brandId, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        name,
        description,
        isListed: status === 'active'
      })
    });

    const result = await response.json();

    if (result.success) {

      await Swal.fire({
        icon: "success",
        title: "Success",
        text: result.message || "Brand updated successfully.",
          background: "#161b24",
          color: "#ffffff",
        timer: 1500,
        showConfirmButton: false
      });

      window.location.href = "/admin/brands";

    } else {

      Swal.fire({
        icon: "error",
        title: "Error",
          background: "#161b24",
          color: "#ffffff",
        text: result.message || "Failed to update brand."
      });

      saveBtn.disabled = false;
      saveBtn.textContent = 'Update Brand';
    }

  } catch (err) {

    console.error(err);

    Swal.fire({
      icon: "error",
      title: "Error",
        background: "#161b24",
          color: "#ffffff",
      text: "Something went wrong."
    });

    saveBtn.disabled = false;
    saveBtn.textContent = 'Update Brand';
  }
}
  // ── TOAST MESSAGE ──
  let toastTimer;
  function toast(icon, text) {
    clearTimeout(toastTimer);
    document.getElementById('toastIcon').textContent = icon;
    document.getElementById('toastText').textContent = text;
    const el = document.getElementById('toast');
    el.classList.add('show');
    toastTimer = setTimeout(() => el.classList.remove('show'), 3200);
  }

  // ── RESPONSIVE MOBILE SIDEBAR ──
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sbOverlay').classList.toggle('show');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sbOverlay').classList.remove('show');
  }
</script>
</body>
</html>