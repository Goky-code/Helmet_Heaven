       Inventory
      </a>
      <div class="nav-item">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/></svg>
        Offers
      </div>
      <div class="nav-item">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><polyline points="3 9 12 15 21 9"/></svg>
        Banner
      </div>
      <div class="nav-item">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Sales Report
      </div>
      <a href="/admin/logout" class="nav-item">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </a>
    </nav>
  </aside>

  <!-- MAIN -->
  <div class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-btn" onclick="toggleSidebar()">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="logo-top">
          <div class="logo-icon" style="width:28px;height:28px;font-size:15px;">🪖</div>
          <span class="logo-text">HELMET HAVEN</span>
        </div>
      </div>
      <div class="topbar-right">
        <button class="notif-btn">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        </button>
        <div class="avatar">AD</div>
      </div>
    </header>

    <main class="content">
      <div class="breadcrumb">
        Admin ›
        <a href="/admin/brands">Brands</a> ›
        <span>Add New Brand</span>
      </div>

      <div class="page-header">
        <h1 class="page-title">Add New Brand</h1>
        <!-- <a href="/admin/brands" class="btn-back">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
          Back to Brands
        </a> -->
      </div>

      <div class="form-card">
        <div class="form-card-header">
          <!-- <div class="form-card-icon">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/></svg>
          </div> -->
          <div>
            <div class="form-card-title">Brand Details</div>
            <div class="form-card-sub">Fill in the information below to create a new brand</div>
          </div>
        </div>

        <div class="form-body">
          <!-- Brand Name -->
          <div class="field">
            <label for="bName">Brand Name <span class="req">*</span></label>
            <input
              type="text"
              id="bName"
              name="name"
              placeholder="e.g. Arai Helmets"
              maxlength="60"
              autocomplete="off"
              oninput="liveVal('bName'); charCount('bName','bNameCnt',60)"
            />
            <div class="field-meta">
              <span class="err-msg" id="bNameErr">Brand name is required (minimum 2 characters).</span>
              <span class="char-count" id="bNameCnt">0 / 60</span>
            </div>
          </div>

          <!-- Description -->
          <div class="field">
            <label for="bDesc">Description <span class="req">*</span></label>
            <textarea
              id="bDesc"
              name="description"
              placeholder="Short description about this brand…"
              maxlength="300"
              oninput="liveVal('bDesc'); charCount('bDesc','bDescCnt',300)"
            ></textarea>
            <div class="field-meta">
              <span class="err-msg" id="bDescErr">Description is required (minimum 10 characters).</span>
              <span class="char-count" id="bDescCnt">0 / 300</span>
            </div>
          </div>

          <!-- Status -->
          <div class="field">
            <label for="bStatus">Status <span class="req">*</span></label>
            <select id="bStatus" name="status" onchange="liveVal('bStatus')">
              <option value="">— Select Status —</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
            <div class="field-meta">
              <span class="err-msg" id="bStatusErr">Please select a status for this brand.</span>
            </div>
            <span class="field-hint">Active brands will be visible in the product catalogue.</span>
          </div>
        </div>

        <div class="form-footer">
          <a href="/admin/brands" class="btn-cancel">Cancel</a>
          <button class="btn-save" id="saveBtn" onclick="saveBrand()">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Save Brand
          </button>
        </div>
