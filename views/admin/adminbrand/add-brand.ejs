<!-- TOAST -->
<div class="toast" id="toast">
  <span id="toastIcon" style="font-size:17px"></span>
  <span class="toast-text" id="toastText"></span>
</div>

<script>
  // ── VALIDATION ──
  function validateField(id) {
    const val = document.getElementById(id).value.trim();
    let ok = true;
    if (id === 'bName') ok = val.length >= 2;
    if (id === 'bDesc') ok = val.length >= 10;
    if (id === 'bStatus') ok = val !== '';
    document.getElementById(id).classList.toggle('err', !ok);
    document.getElementById(id + 'Err').classList.toggle('show', !ok);
    return ok;
  }

  function liveVal(id) {
    if (document.getElementById(id).classList.contains('err')) validateField(id);
  }

  function charCount(fieldId, cntId, max) {
    const len = document.getElementById(fieldId).value.length;
    const el = document.getElementById(cntId);
    el.textContent = `${len} / ${max}`;
    el.classList.toggle('warn', len > max * 0.88);
  }

  function validateAll() {
    return ['bName', 'bDesc', 'bStatus'].map(id => validateField(id)).every(Boolean);
  }

  // ── SAVE ──
  async function saveBrand() {
    if (!validateAll()) return;

    const name        = document.getElementById('bName').value.trim();
    const description = document.getElementById('bDesc').value.trim();
    const status      = document.getElementById('bStatus').value;

    const saveBtn = document.getElementById('saveBtn');
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';

    try {
      const response = await fetch('/admin/add-brand', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description, isListed: status === 'active' }),
      });

      const result = await response.json();

      if (result.success) {
        toast('✅', result.message || 'Brand added successfully');
        setTimeout(() => window.location.href = '/admin/brands', 1200);
      } else {
        const nameInput = document.getElementById('bName');
        const nameErr   = document.getElementById('bNameErr');
        nameInput.classList.add('err');
        nameErr.textContent = result.message;
        nameErr.classList.add('show');
        nameInput.focus();
        saveBtn.disabled = false;
        saveBtn.innerHTML = `<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Save Brand`;
      }
    } catch (err) {
      console.error(err);
      toast('❌', 'Something went wrong. Please try again.');
      saveBtn.disabled = false;
      saveBtn.innerHTML = `<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Save Brand`;
    }
  }

  // ── TOAST ──
  let toastTimer;
  function toast(icon, text) {
    clearTimeout(toastTimer);
    document.getElementById('toastIcon').textContent = icon;
    document.getElementById('toastText').textContent = text;
    const el = document.getElementById('toast');
    el.classList.add('show');
    toastTimer = setTimeout(() => el.classList.remove('show'), 3200);
  }

  // ── SIDEBAR ──
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sbOverlay').classList.toggle('show');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sbOverlay').classList.remove('show');
  }

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeSidebar();
  });
</script>
</body>
</html>