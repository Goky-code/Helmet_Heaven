<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Helmet Haven — Brands Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #0f1117;
    --sidebar-bg: #13161f;
    --card-bg: #181c27;
    --card-border: #232840;
    --accent: #3b82f6;
    --accent-glow: rgba(59,130,246,0.18);
    --active-green: #22c55e;
    --inactive-red: #ef4444;
    --text-primary: #f0f2f8;
    --text-secondary: #8892b0;
    --text-muted: #4a5278;
    --row-hover: rgba(59,130,246,0.05);
    --sidebar-width: 240px;
    --radius: 12px;
    --tr: 0.22s cubic-bezier(.4,0,.2,1);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text-primary); overflow-x: hidden; }

  /* ── SHELL ── */
  .shell { display: flex; min-height: 100vh; }

  /* ── SIDEBAR ── */
  .sidebar {
    width: var(--sidebar-width); background: var(--sidebar-bg);
    border-right: 1px solid var(--card-border);
    display: flex; flex-direction: column;
    position: fixed; top: 0; left: 0; bottom: 0; z-index: 200;
    transition: transform var(--tr);
  }
  .sidebar-logo {
    display: flex; align-items: center; gap: 10px;
    padding: 20px 18px 16px;
    border-bottom: 1px solid var(--card-border);
  }
  .logo-icon { width: 34px; height: 34px; background: var(--accent); border-radius: 9px; display: grid; place-items: center; font-size: 18px; }
  .logo-text { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 15px; letter-spacing: .5px; }

  .nav { flex: 1; padding: 12px 10px; overflow-y: auto; }
  .nav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 12px; border-radius: 9px; cursor: pointer;
    font-size: 12.5px; font-weight: 500; color: var(--text-secondary);
    letter-spacing: .6px; text-transform: uppercase; margin-bottom: 2px;
    transition: background var(--tr), color var(--tr);
    white-space: nowrap;
  }
  .nav-item:hover { background: rgba(255,255,255,.04); color: var(--text-primary); }
  .nav-item.active { background: var(--accent-glow); color: var(--accent); font-weight: 600; }
  .nav-item svg { flex-shrink: 0; }

  /* ── MAIN ── */
  .main { margin-left: var(--sidebar-width); flex: 1; display: flex; flex-direction: column; min-height: 100vh; transition: margin-left var(--tr); }

  /* ── TOPBAR ── */
  .topbar {
    height: 60px; background: var(--sidebar-bg); border-bottom: 1px solid var(--card-border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 24px; position: sticky; top: 0; z-index: 100;
  }
  .topbar-left { display: flex; align-items: center; gap: 12px; }
  .menu-btn { display: none; background: none; border: none; cursor: pointer; color: var(--text-secondary); padding: 6px; border-radius: 7px; transition: background var(--tr); }
  .menu-btn:hover { background: rgba(255,255,255,.06); }
  .logo-top { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 16px; display: flex; align-items: center; gap: 8px; }
  .topbar-right { display: flex; align-items: center; gap: 14px; }
  .notif-btn { background: none; border: none; cursor: pointer; color: var(--text-secondary); padding: 6px; border-radius: 8px; position: relative; transition: color var(--tr); }
  .notif-btn:hover { color: var(--text-primary); }
  .avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--accent); display: grid; place-items: center; font-weight: 700; font-size: 12px; }

  /* ── CONTENT ── */
  .content { padding: 28px; flex: 1; }

  /* breadcrumb */
  .breadcrumb { font-size: 12px; color: var(--text-muted); margin-bottom: 10px; letter-spacing: .4px; text-transform: uppercase; }
  .breadcrumb span { color: var(--accent); font-weight: 600; }

  /* page header */
  .page-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
  .page-title { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 26px; }
  .btn-add {
    display: flex; align-items: center; gap: 8px;
    background: var(--accent); color: #fff; border: none;
    border-radius: 10px; padding: 10px 20px;
    font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 600;
    cursor: pointer; transition: opacity var(--tr), transform var(--tr); white-space: nowrap;
  }
  .btn-add:hover { opacity: .88; transform: translateY(-1px); }

  /* ── SEARCH BAR ── */
  .search-bar-wrap { margin-bottom: 18px; }
  .search-bar {
    display: flex; align-items: center; gap: 10px;
    background: var(--card-bg); border: 1px solid var(--card-border);
    border-radius: 10px; padding: 9px 14px;
    width: 100%; max-width: 360px;
    transition: border-color var(--tr), box-shadow var(--tr);
  }
  .search-bar:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(59,130,246,.15);
  }
  .search-bar svg { color: var(--text-muted); flex-shrink: 0; }
  .search-bar input {
    background: none; border: none; outline: none;
    color: var(--text-primary); font-family: 'DM Sans', sans-serif;
    font-size: 14px; width: 100%;
  }
  .search-bar input::placeholder { color: var(--text-muted); }
  .search-clear {
    background: none; border: none; cursor: pointer;
    color: var(--text-muted); display: none; padding: 0; line-height: 1;
    transition: color var(--tr);
  }
  .search-clear:hover { color: var(--text-secondary); }
  .search-clear.show { display: flex; }

  /* ── TABLE CARD ── */
  .table-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: var(--radius); overflow: hidden; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 500px; }
  thead tr { background: rgba(255,255,255,.025); }
  th { padding: 13px 22px; text-align: left; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--text-muted); }
  td { padding: 20px 22px; border-top: 1px solid var(--card-border); font-size: 14px; }
  tr:hover td { background: var(--row-hover); }
  .sl-no { color: var(--text-muted); font-size: 13px; font-weight: 500; }
  .brand-name { font-weight: 700; color: var(--text-primary); }
  .brand-desc { color: var(--text-secondary); font-size: 12.5px; max-width: 280px; line-height: 1.5; }

  /* no results */
  .no-results { text-align: center; padding: 40px 20px; color: var(--text-muted); font-size: 14px; }
  .no-results span { display: block; font-size: 28px; margin-bottom: 10px; }

  /* badge */
  .badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 13px; border-radius: 20px; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
  .badge-dot { width: 6px; height: 6px; border-radius: 50%; }
  .badge-active { background: rgba(34,197,94,.12); color: var(--active-green); border: 1px solid rgba(34,197,94,.22); }
  .badge-active .badge-dot { background: var(--active-green); }
  .badge-inactive { background: rgba(239,68,68,.12); color: var(--inactive-red); border: 1px solid rgba(239,68,68,.22); }
  .badge-inactive .badge-dot { background: var(--inactive-red); }

  /* action btns */
  .action-btns { display: flex; gap: 8px; }
  .icon-btn { width: 32px; height: 32px; border-radius: 8px; background: rgba(255,255,255,.05); border: 1px solid var(--card-border); display: grid; place-items: center; cursor: pointer; color: var(--text-secondary); transition: background var(--tr), color var(--tr), border-color var(--tr); }
  .icon-btn.edit-btn:hover { background: rgba(59,130,246,.15); color: var(--accent); border-color: rgba(59,130,246,.3); }
  .icon-btn.del-btn:hover { background: rgba(239,68,68,.15); color: var(--inactive-red); border-color: rgba(239,68,68,.3); }

  /* pagination */
  .pagination { display: flex; align-items: center; justify-content: space-between; padding: 14px 22px; flex-wrap: wrap; gap: 10px; }
  .pag-info { font-size: 13px; color: var(--text-secondary); }
  .pag-info strong { color: var(--text-primary); }
  .pag-btns { display: flex; align-items: center; gap: 5px; }
  .pag-btn { min-width: 32px; height: 32px; border-radius: 7px; padding: 0 8px; background: rgba(255,255,255,.05); border: 1px solid var(--card-border); color: var(--text-secondary); font-size: 13px; font-weight: 500; cursor: pointer; transition: background var(--tr), color var(--tr); }
  .pag-btn:hover:not(:disabled) { background: rgba(255,255,255,.09); color: var(--text-primary); }
  .pag-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .pag-btn:disabled { opacity: .35; cursor: not-allowed; }

  /* ── FOOTER ── */
  footer { padding: 14px 24px; border-top: 1px solid var(--card-border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 11px; color: var(--text-muted); letter-spacing: .4px; }
  .footer-links { display: flex; gap: 20px; }
  .footer-links span { cursor: pointer; transition: color var(--tr); }
  .footer-links span:hover { color: var(--text-secondary); }

  /* ── OVERLAY ── */
  .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.7); backdrop-filter: blur(5px); z-index: 400; display: none; align-items: center; justify-content: center; padding: 16px; }
  .overlay.open { display: flex; animation: fadeIn .18s ease; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  /* ── MODAL ── */
  .modal { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 16px; width: 100%; max-width: 500px; box-shadow: 0 28px 80px rgba(0,0,0,.65); animation: slideUp .22s cubic-bezier(.4,0,.2,1); }
  @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px 18px; border-bottom: 1px solid var(--card-border); }
  .modal-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 18px; }
  .modal-close { width: 32px; height: 32px; border-radius: 8px; background: rgba(255,255,255,.06); border: 1px solid var(--card-border); display: grid; place-items: center; cursor: pointer; color: var(--text-secondary); transition: background var(--tr); }
  .modal-close:hover { background: rgba(255,255,255,.12); color: var(--text-primary); }

  .modal-body { padding: 24px; display: flex; flex-direction: column; gap: 20px; }

  /* fields */
  .field { display: flex; flex-direction: column; gap: 7px; }
  .field label { font-size: 13px; font-weight: 600; color: var(--text-secondary); }
  .req { color: var(--inactive-red); }
  .field input, .field textarea, .field select {
    background: rgba(255,255,255,.05); border: 1.5px solid var(--card-border);
    border-radius: 9px; padding: 11px 14px;
    color: var(--text-primary); font-family: 'DM Sans', sans-serif; font-size: 14px;
    outline: none; width: 100%;
    transition: border-color var(--tr), box-shadow var(--tr);
  }
  .field textarea { resize: vertical; min-height: 95px; }
  .field select option { background: #1a1e2e; }
  .field input::placeholder, .field textarea::placeholder { color: var(--text-muted); }
  .field input:focus, .field textarea:focus, .field select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(59,130,246,.14); }
  .field input.err, .field textarea.err, .field select.err { border-color: var(--inactive-red); box-shadow: 0 0 0 3px rgba(239,68,68,.12); }

  .field-meta { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .err-msg { font-size: 11.5px; color: var(--inactive-red); display: none; }
  .err-msg.show { display: block; }
  .char-count { font-size: 11.5px; color: var(--text-muted); white-space: nowrap; flex-shrink: 0; }
  .char-count.warn { color: var(--inactive-red); }

  .modal-footer { display: flex; justify-content: flex-end; gap: 10px; padding: 18px 24px 22px; border-top: 1px solid var(--card-border); }
  .btn-cancel { padding: 9px 20px; border-radius: 9px; background: rgba(255,255,255,.06); border: 1px solid var(--card-border); color: var(--text-secondary); font-family: 'DM Sans', sans-serif; font-size: 13.5px; font-weight: 600; cursor: pointer; transition: background var(--tr), color var(--tr); }
  .btn-cancel:hover { background: rgba(255,255,255,.1); color: var(--text-primary); }
  .btn-save { padding: 9px 24px; border-radius: 9px; background: var(--accent); border: none; color: #fff; font-family: 'DM Sans', sans-serif; font-size: 13.5px; font-weight: 600; cursor: pointer; transition: opacity var(--tr), transform var(--tr); }
  .btn-save:hover { opacity: .88; transform: translateY(-1px); }

  /* delete modal */
  .del-modal { max-width: 390px; }
  .del-body { padding: 28px 24px 20px; text-align: center; }
  .del-icon { font-size: 42px; margin-bottom: 14px; }
  .del-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 19px; margin-bottom: 10px; }
  .del-sub { color: var(--text-secondary); font-size: 13.5px; line-height: 1.6; }
  .btn-del { background: var(--inactive-red); }
  .btn-del:hover { opacity: .88; }
.nav-item {
  text-decoration: none;
}
  /* sidebar overlay */
  .sb-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 150; }
  .sb-overlay.show { display: block; }

  /* toast */
  .toast { position: fixed; bottom: 22px; right: 22px; z-index: 600; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 10px; padding: 13px 18px; display: flex; align-items: center; gap: 10px; box-shadow: 0 8px 32px rgba(0,0,0,.45); transform: translateY(70px); opacity: 0; transition: transform .3s cubic-bezier(.4,0,.2,1), opacity .3s; max-width: 290px; }
  .toast.show { transform: translateY(0); opacity: 1; }
  .toast-text { font-size: 13.5px; font-weight: 500; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .sidebar { transform: translateX(-100%); }
    .sidebar.open { transform: translateX(0); }
    .main { margin-left: 0; }
    .menu-btn { display: flex; }
  }
  @media (max-width: 600px) {
    .content { padding: 16px; }
    .topbar { padding: 0 14px; }
    .page-title { font-size: 20px; }
    .btn-add-text { display: none; }
    th, td { padding: 12px 14px; }
    footer { flex-direction: column; align-items: flex-start; gap: 6px; }
    .modal-body { padding: 18px; }
    .modal-footer { padding: 14px 18px 18px; }
    .search-bar { max-width: 100%; }
  }
  @media (max-width: 380px) {
    .pag-info { display: none; }
  }
</style>
</head>
