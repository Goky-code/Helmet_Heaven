        Logout
        </a>
    </nav>
  </aside>

  <!-- MAIN -->
  <div class="main">
    <!-- TOPBAR -->
    <header class="topbar">
      <div class="topbar-left">
        <button class="menu-btn" onclick="toggleSidebar()">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="logo-top">
          <div class="logo-icon" style="width:28px;height:28px;font-size:15px;">🪖</div>
          <span class="logo-text">HELMET HAVEN</span>
        </div>
      </div>
      <div class="topbar-right">
        <button class="notif-btn">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        </button>
        <div class="avatar">AD</div>
      </div>
    </header>

    <!-- CONTENT -->
    <main class="content">
      <div class="breadcrumb">Admin › <span>Brands</span></div>
      <div class="page-header">
        <h1 class="page-title">Brands</h1>
        <button class="btn-add" onclick="openAddModal()">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span class="btn-add-text"> Add New Brand</span>
        </button>
      </div>

      <!-- SEARCH BAR -->
      <div class="search-bar-wrap">
        <div class="search-bar">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="searchInput" placeholder="Search brands…" oninput="onSearch()" autocomplete="off"/>
          <button class="search-clear" id="searchClear" onclick="clearSearch()" title="Clear search" aria-label="Clear search">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      <div class="table-card">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>SL No.</th>
                <th>Brand Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
           <tbody>

<% if(brands.length > 0){ %>

  <% brands.forEach((brand, index) => { %>

    <tr>

      <td class="sl-no">
        <%= ((currentPage - 1) * limit) + index + 1 %>
      </td>

      <td>
        <div class="brand-name">
          <%= brand.name %>
        </div>
      </td>

      <td>
        <div class="brand-desc">
          <%= brand.description %>
        </div>
      </td>

      <td>

        <% if(brand.isListed){ %>

          <span class="badge badge-active">
            <span class="badge-dot"></span>
            ACTIVE
          </span>

        <% } else { %>

          <span class="badge badge-inactive">
            <span class="badge-dot"></span>
            INACTIVE
          </span>

        <% } %>

      </td>

      <td>

        <div class="action-btns">

          <!-- EDIT -->

          <button
            class="icon-btn edit-btn"
            onclick="openEditModal(
              '<%= brand._id %>',
              '<%= brand.name %>',
              '<%= brand.description %>',
              '<%= brand.isListed ? "active" : "inactive" %>'
            )"
          >
            ✏️
          </button>

          <!-- DELETE -->

          <a
            href="/admin/delete-brand/<%= brand._id %>"
            class="icon-btn del-btn"
          >
            🗑️
          </a>

        </div>

      </td>

    </tr>

  <% }) %>

<% } else { %>

<tr>

  <td colspan="5" class="no-results">
    <span>🔍</span>
    No brands found
  </td>

</tr>

<% } %>

</tbody>
          </table>
        </div>
       <div class="pagination">

  <span class="pag-info">

    Showing

    <strong>
      <%= ((currentPage - 1) * limit) + 1 %>
    </strong>

    to

    <strong>
      <%= Math.min(currentPage * limit, totalBrands) %>
    </strong>

    of

    <strong>
      <%= totalBrands %>
    </strong>

    brands

  </span>

  <div class="pag-btns">

    <!-- PREVIOUS -->

    <% if(currentPage > 1){ %>

      <a href="/admin/brands?page=<%= currentPage - 1 %>&search=<%= search %>">

        <button class="pag-btn">
          ‹
        </button>

      </a>

    <% } %>

    <!-- PAGE NUMBERS -->

    <% for(let i = 1; i <= totalPages; i++){ %>

      <a href="/admin/brands?page=<%= i %>&search=<%= search %>">

        <button
          class="pag-btn <%= currentPage === i ? 'active' : '' %>"
        >
          <%= i %>
        </button>

      </a>

    <% } %>

    <!-- NEXT -->

    <% if(currentPage < totalPages){ %>

      <a href="/admin/brands?page=<%= currentPage + 1 %>&search=<%= search %>">

        <button class="pag-btn">
          ›
        </button>

      </a>

    <% } %>

  </div>

</div>
      </div>
    </main>

    <footer>
      <span>© 2024 HELMET HAVEN SYSTEM V.4.2</span>
      <div class="footer-links">
        <span>API Status: Operational</span>
        <span>Support Console</span>
      </div>
    </footer>
  </div>
</div>

<!-- ── ADD / EDIT MODAL ── -->
<div class="overlay" id="brandOverlay">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title" id="modalTitle">Add New Brand</span>
      <button class="modal-close" onclick="closeModal()">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal-body">
      <div class="field">
        <label for="bName">Brand Name <span class="req">*</span></label>
        <input type="text" id="bName" placeholder="e.g. Arai Helmets" maxlength="60"
          oninput="liveVal('bName'); charCount('bName','bNameCnt',60)"/>
        <div class="field-meta">
          <span class="err-msg" id="bNameErr">Brand name is required (minimum 2 characters).</span>
          <span class="char-count" id="bNameCnt">0 / 60</span>
        </div>
      </div>
      <div class="field">
        <label for="bDesc">Description <span class="req">*</span></label>
        <textarea id="bDesc" placeholder="Short description about this brand…" maxlength="300"
          oninput="liveVal('bDesc'); charCount('bDesc','bDescCnt',300)"></textarea>
        <div class="field-meta">
          <span class="err-msg" id="bDescErr">Description is required (minimum 10 characters).</span>
          <span class="char-count" id="bDescCnt">0 / 300</span>
        </div>
      </div>
      <div class="field">
        <label for="bStatus">Status <span class="req">*</span></label>
        <select id="bStatus" onchange="liveVal('bStatus')">
          <option value="">— Select Status —</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
        <div class="field-meta">
          <span class="err-msg" id="bStatusErr">Please select a status for this brand.</span>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-cancel" onclick="closeModal()">Cancel</button>
      <button class="btn-save" id="saveBtn" onclick="saveBrand()">Save Brand</button>
    </div>
  </div>
</div>

<!-- ── DELETE CONFIRM ── -->
<div class="overlay" id="deleteOverlay">
  <div class="modal del-modal">
    <div class="del-body">
      <div class="del-icon">🗑️</div>
      <div class="del-title">Delete Brand?</div>
      <p class="del-sub" id="delSub">This brand will be permanently deleted and cannot be recovered.</p>
    </div>
    <div class="modal-footer">
      <button class="btn-cancel" onclick="closeDelModal()">Cancel</button>
      <button class="btn-save btn-del" onclick="confirmDelete()">Yes, Delete</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast">
  <span id="toastIcon" style="font-size:17px"></span>
  <span class="toast-text" id="toastText"></span>
</div>

<script>
  
 

  const PAGE_SIZE = 5;
  let currentPage = 1;
  let nextId = 25;
  let editingId = null;
  let deletingId = null;
  let searchQuery = '';

  // ─── SEARCH ───
  function getFiltered() {
    if (!searchQuery) return brands;
    const q = searchQuery.toLowerCase();
    return brands.filter(b =>
      b.name.toLowerCase().includes(q) ||
      b.description.toLowerCase().includes(q) ||
      b.status.toLowerCase().includes(q)
    );
  }

  

 
 
  function highlight(text) {
    if (!searchQuery) return text;
    const q = esc(searchQuery).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return text.replace(new RegExp(`(${q})`, 'gi'),
      '<mark style="background:rgba(59,130,246,0.25);color:var(--text-primary);border-radius:3px;padding:0 2px">$1</mark>');
  }

 


  function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  // ─── MODAL ───
  function openAddModal() {
    editingId = null;
    document.getElementById('modalTitle').textContent = 'Add New Brand';
    document.getElementById('saveBtn').textContent = 'Save Brand';
    resetForm();
    document.getElementById('brandOverlay').classList.add('open');
  }

 function openEditModal(id, name, description, status) {

  editingId = id;

  document.getElementById('modalTitle').textContent =
    'Edit Brand';

  document.getElementById('saveBtn').textContent =
    'Update Brand';

  document.getElementById('bName').value = name;

  document.getElementById('bDesc').value = description;

  document.getElementById('bStatus').value = status;

  document.getElementById('brandOverlay')
    .classList.add('open');
}

  function closeModal() {
    document.getElementById('brandOverlay').classList.remove('open');
    resetForm();
  }

  function resetForm() {
    ['bName','bDesc','bStatus'].forEach(id => document.getElementById(id).value = '');
    charCount('bName','bNameCnt',60);
    charCount('bDesc','bDescCnt',300);
    clearErrors();
  }

  function clearErrors() {
    ['bName','bDesc','bStatus'].forEach(id => {
      document.getElementById(id).classList.remove('err');
      document.getElementById(id+'Err').classList.remove('show');
    });
  }

  function onSearch() {
  const q = document.getElementById('searchInput').value.trim();
  document.getElementById('searchClear').classList.toggle('show', q.length > 0);
  clearTimeout(window._searchTimer);
  window._searchTimer = setTimeout(() => {
    window.location.href = '/admin/brands?page=1&search=' + encodeURIComponent(q);
  }, 400);
}

function clearSearch() {
  document.getElementById('searchInput').value = '';
  document.getElementById('searchClear').classList.remove('show');
  window.location.href = '/admin/brands?page=1&search=';
}

(function () {
  const params = new URLSearchParams(window.location.search);
  const q = params.get('search') || '';
  const input = document.getElementById('searchInput');
  input.value = q;
  document.getElementById('searchClear').classList.toggle('show', q.length > 0);
})();

  // ─── VALIDATION ───
  function validateField(id) {
    const val = document.getElementById(id).value.trim();
    let ok = true;
    if (id === 'bName') ok = val.length >= 2;
    if (id === 'bDesc') ok = val.length >= 10;
    if (id === 'bStatus') ok = val !== '';
    document.getElementById(id).classList.toggle('err', !ok);
    document.getElementById(id+'Err').classList.toggle('show', !ok);
    return ok;
  }

  function liveVal(id) {
    if (document.getElementById(id).classList.contains('err')) validateField(id);
  }

  function charCount(fieldId, cntId, max) {
    const len = document.getElementById(fieldId).value.length;
    const el = document.getElementById(cntId);
    el.textContent = `${len} / ${max}`;
    el.classList.toggle('warn', len > max * 0.88);
  }

  function validateAll() {
    return ['bName','bDesc','bStatus'].map(id => validateField(id)).every(Boolean);
  }

  // ─── SAVE ───
  async function saveBrand() {
  if (!validateAll()) return;

  const name        = document.getElementById('bName').value.trim();
  const description = document.getElementById('bDesc').value.trim();
  const status      = document.getElementById('bStatus').value;

  const data = {
    name,
    description,
    isListed: status === "active",
  };

  const url = editingId
    ? `/admin/edit-brand/${editingId}`
    : "/admin/add-brand";

  const saveBtn = document.getElementById('saveBtn');

  try {
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';

    const response = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data),
    });

    const result = await response.json();

    if (result.success) {
      toast('✅', result.message || 'Brand saved successfully');
      setTimeout(() => location.reload(), 1000);
    } else {
     
      const nameInput = document.getElementById('bName');
      const nameErr   = document.getElementById('bNameErr');

      nameInput.classList.add('err');
      nameErr.textContent = result.message; 
      nameErr.classList.add('show');
      nameInput.focus();

      saveBtn.disabled = false;
      saveBtn.textContent = editingId ? 'Update Brand' : 'Save Brand';
    }
  } catch (err) {
    console.error(err);
    toast('❌', 'Something went wrong. Please try again.');
    saveBtn.disabled = false;
    saveBtn.textContent = editingId ? 'Update Brand' : 'Save Brand';
  }
}
  // ─── DELETE ───
  function openDelModal(id) {
    deletingId = id;
    const b = brands.find(x => x.id === id);
    document.getElementById('delSub').textContent =
      `"${b.name}" will be permanently deleted and cannot be recovered.`;
    document.getElementById('deleteOverlay').classList.add('open');
  }
  function closeDelModal() { document.getElementById('deleteOverlay').classList.remove('open'); deletingId = null; }
  

  // ─── TOAST ───
  let toastTimer;
  function toast(icon, text) {
    clearTimeout(toastTimer);
    document.getElementById('toastIcon').textContent = icon;
    document.getElementById('toastText').textContent = text;
    const el = document.getElementById('toast');
    el.classList.add('show');
    toastTimer = setTimeout(() => el.classList.remove('show'), 3200);
  }

  // ─── SIDEBAR ───
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sbOverlay').classList.toggle('show');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sbOverlay').classList.remove('show');
  }

  document.getElementById('brandOverlay').addEventListener('click', e => { if (e.target === e.currentTarget) closeModal(); });
  document.getElementById('deleteOverlay').addEventListener('click', e => { if (e.target === e.currentTarget) closeDelModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeModal(); closeDelModal(); closeSidebar(); } });

  
</script>
</body>
</html>