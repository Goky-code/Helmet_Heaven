<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Helmet Haven – Sales Report</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d0f14;
      --sidebar: #111318;
      --card: #161a22;
      --border: #252934;
      --surface: #1e2330;
      --accent: #3b6ef5;
      --accent2: #5c87ff;
      --text: #e8eaf0;
      --muted: #6b7280;
      --green: #22c55e;
      --red: #ef4444;
      --orange: #f59e0b;
      --font-head: "Syne", sans-serif;
      --font-body: "DM Sans", sans-serif;
      --sidebar-w: 240px;
      --radius: 10px;
    }

    body { font-family: var(--font-body); background: var(--bg); color: var(--text); min-height: 100vh; display: flex; }

    /* SIDEBAR */
    .sidebar { width: var(--sidebar-w); background: var(--sidebar); border-right: 1px solid var(--border); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh; z-index: 100; transition: transform 0.3s ease; }
    .sidebar-logo { display: flex; align-items: center; gap: 10px; padding: 22px 20px; border-bottom: 1px solid var(--border); }
    .logo-icon { width: 34px; height: 34px; background: var(--accent); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .logo-text { font-family: var(--font-head); font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text); }
    nav { flex: 1; padding: 14px 0; overflow-y: auto; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 20px; font-size: 12px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); cursor: pointer; transition: all 0.2s; border-left: 3px solid transparent; text-decoration: none; }
    .nav-item:hover { color: var(--text); background: rgba(255,255,255,0.04); }
    .nav-item.active { color: var(--accent2); background: rgba(59,110,245,0.1); border-left-color: var(--accent); }
    .nav-item svg { flex-shrink: 0; opacity: 0.7; }
    .nav-item.active svg, .nav-item:hover svg { opacity: 1; }

    /* MAIN */
    .main { margin-left: var(--sidebar-w); flex: 1; display: flex; flex-direction: column; min-height: 100vh; min-width: 0; }

    /* TOPBAR */
    .topbar { display: flex; align-items: center; justify-content: space-between; padding: 18px 28px; border-bottom: 1px solid var(--border); background: var(--sidebar); position: sticky; top: 0; z-index: 50; gap: 12px; flex-wrap: wrap; }
    .topbar-left { display: flex; align-items: center; gap: 14px; }
    .topbar-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .hamburger { display: none; background: none; border: none; color: var(--text); cursor: pointer; font-size: 20px; padding: 4px; }
    .page-title { font-family: var(--font-head); font-size: 20px; font-weight: 700; }

    .btn-primary { background: var(--accent); color: #fff; border: none; border-radius: var(--radius); padding: 9px 20px; font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer; transition: background 0.2s, transform 0.1s; white-space: nowrap; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
    .btn-primary:hover { background: var(--accent2); }
    .btn-primary:active { transform: scale(0.97); }
    .btn-pdf { background: var(--orange); color: #1a1205; }
    .btn-pdf:hover { background: #fbbf24; }
    .btn-excel { background: var(--green); color: #052e14; }
    .btn-excel:hover { background: #4ade80; }

    /* CONTENT */
    .content { padding: 24px 28px; flex: 1; }

    /* FILTER CARD */
    .filter-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 20px; margin-bottom: 22px; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
    .search-box { flex: 1; min-width: 220px; position: relative; }
    .search-box svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
    .search-box input { width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px 10px 38px; color: var(--text); font-family: var(--font-body); font-size: 14px; outline: none; transition: border-color 0.2s; }
    .search-box input::placeholder { color: var(--muted); }
    .search-box input:focus { border-color: var(--accent); }

    /* PERIOD DROPDOWN */
    .dropdown { position: relative; min-width: 190px; }
    .dropdown-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: 8px; padding: 10px 14px; font-family: var(--font-body); font-size: 13px; font-weight: 600; cursor: pointer; transition: border-color 0.2s; }
    .dropdown-btn:hover, .dropdown.open .dropdown-btn { border-color: var(--accent); }
    .dropdown-btn svg { transition: transform 0.2s; }
    .dropdown.open .dropdown-btn svg { transform: rotate(180deg); }
    .dropdown-menu { display: none; position: absolute; top: calc(100% + 6px); left: 0; min-width: 100%; background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 6px; z-index: 60; box-shadow: 0 12px 30px rgba(0,0,0,0.45); }
    .dropdown.open .dropdown-menu { display: block; }
    .dropdown-item { display: block; width: 100%; text-align: left; background: none; border: none; color: var(--text); font-family: var(--font-body); font-size: 13px; padding: 9px 12px; border-radius: 6px; cursor: pointer; text-decoration: none; white-space: nowrap; }
    .dropdown-item:hover { background: rgba(255,255,255,0.06); }
    .dropdown-item.active { color: var(--accent2); background: rgba(59,110,245,0.1); }
    .dropdown-divider { height: 1px; background: var(--border); margin: 6px 0; }

    /* CUSTOM RANGE */
    .range-card { display: none; gap: 14px; align-items: flex-end; flex-wrap: wrap; }
    .range-card.show { display: flex; }
    .range-field { flex: 1; min-width: 180px; display: flex; flex-direction: column; gap: 6px; }
    .range-field label { font-size: 11px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); }
    .range-field input { width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; color: var(--text); font-family: var(--font-body); font-size: 14px; outline: none; color-scheme: dark; transition: border-color 0.2s; }
    .range-field input:focus { border-color: var(--accent); }
    .range-card .btn-primary { flex: 1; min-width: 180px; padding: 11px 20px; }

    /* PERIOD BAR + STATS */
    .period-bar { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 20px; margin-bottom: 18px; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .period-bar h2 { font-family: var(--font-head); font-size: 15px; font-weight: 700; }
    .period-range { font-size: 14px; color: var(--text); }
    .period-range span { color: var(--muted); margin: 0 6px; }

    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 22px; }
    .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px 18px; text-align: center; }
    .stat-label { font-size: 11px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); margin-bottom: 12px; }
    .stat-value { font-family: var(--font-head); font-size: 24px; font-weight: 700; color: var(--text); }
    .stat-value.accent { color: var(--accent2); }

    /* TABLE */
    .table-wrap { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
    .table-scroll { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 780px; }
    thead { background: var(--surface); }
    th { padding: 13px 18px; text-align: left; font-size: 11px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
    tbody tr { border-top: 1px solid var(--border); transition: background 0.15s; }
    tbody tr:hover { background: rgba(255,255,255,0.025); }
    td { padding: 15px 18px; font-size: 14px; vertical-align: middle; white-space: nowrap; }
    td.product-name { white-space: normal; min-width: 180px; max-width: 280px; font-weight: 600; }
    .order-id { color: var(--accent2); font-weight: 700; letter-spacing: 0.02em; }
    .discount-val { color: var(--green); font-weight: 700; }

    .badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; background: rgba(59,110,245,0.12); color: var(--accent2); border: 1px solid rgba(59,110,245,0.25); }
    .badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

    .empty-row td { text-align: center; padding: 48px; color: var(--muted); font-size: 14px; white-space: normal; }

    /* PAGINATION */
    .table-footer { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 10px; }
    .results-count { font-size: 13px; color: var(--muted); }
    .pagination { display: flex; align-items: center; gap: 8px; margin-left: auto; flex-wrap: wrap; }
    .pagination a { text-decoration: none; padding: 8px 14px; border: 1px solid var(--border); border-radius: 8px; color: var(--text); background: var(--surface); transition: .2s; font-size: 13px; }
    .pagination a:hover { background: var(--accent); color: #fff; }
    .pagination a.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .pagination a.disabled { opacity: .4; pointer-events: none; }

    /* TOAST */
    #toast { position: fixed; bottom: 30px; right: 30px; background: var(--green); color: #fff; padding: 12px 22px; border-radius: 10px; font-size: 14px; font-weight: 600; display: none; z-index: 999; animation: slideUp 0.25s ease; }
    #toast.error { background: var(--red); }
    @keyframes slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .overlay-bg { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 90; }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      .stats { grid-template-columns: 1fr; }
      th:nth-child(5), td:nth-child(5) { display: none; } /* Price */
    }
    @media (max-width: 700px) {
      :root { --sidebar-w: 0px; }
      .sidebar { transform: translateX(-240px); width: 240px; }
      .sidebar.open { transform: translateX(0); }
      .overlay-bg.open { display: block; }
      .main { margin-left: 0; }
      .hamburger { display: block; }
      .topbar { padding: 14px 16px; }
      .topbar-right { width: 100%; }
      .topbar-right .btn-primary { flex: 1; }
      .content { padding: 16px; }
      .filter-card { flex-direction: column; align-items: stretch; }
      .dropdown { width: 100%; }
      .range-card .btn-primary, .range-field { min-width: 100%; }
      .period-bar { flex-direction: column; align-items: flex-start; }
      #toast { left: 16px; right: 16px; bottom: 16px; text-align: center; }
    }
    @media (max-width: 480px) {
      th:nth-child(8), td:nth-child(8) { display: none; } /* Payment Method */
    }
  </style>
</head>
<body>

  <%
    /* ── Safe defaults so the page never crashes if a variable is missing ── */
    const _sales         = (typeof sales !== 'undefined' && Array.isArray(sales)) ? sales : [];
    const _search        = (typeof search !== 'undefined' && search) ? search : '';
    const _period        = (typeof period !== 'undefined' && period) ? period : 'daily';
    const _page          = (typeof currentPage !== 'undefined') ? Number(currentPage) : 1;
    const _totalPages    = (typeof totalPages !== 'undefined') ? Number(totalPages) : 1;
    const _totalRecords  = (typeof totalRecords !== 'undefined') ? Number(totalRecords) : _sales.length;
    const _limit         = (typeof limit !== 'undefined') ? Number(limit) : (_sales.length || 10);
    const _revenue       = (typeof totalRevenue !== 'undefined') ? Number(totalRevenue) : 0;
    const _orders        = (typeof totalOrders !== 'undefined') ? Number(totalOrders) : 0;
    const _discount      = (typeof totalDiscount !== 'undefined') ? Number(totalDiscount) : 0;
    const _from          = (typeof startDate !== 'undefined' && startDate) ? startDate : '';
    const _to            = (typeof endDate !== 'undefined' && endDate) ? endDate : '';

    const periodLabels = { daily: 'Daily', weekly: 'Weekly', monthly: 'Monthly', yearly: 'Yearly', custom: 'Custom Date Range' };
    const periodLabel  = periodLabels[_period] || 'Daily';

    const money = (n) => '₹' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A';
    const isoDate = (d) => { if (!d) return ''; const x = new Date(d); return isNaN(x) ? String(d) : x.toISOString().slice(0, 10); };

    /* Query string builder (keeps filters while paging / downloading) */
    const qs = (extra = {}) => {
      const p = new URLSearchParams();
      p.set('period', _period);
      if (_search) p.set('search', _search);
      if (_period === 'custom') { if (_from) p.set('from', isoDate(_from)); if (_to) p.set('to', isoDate(_to)); }
      Object.entries(extra).forEach(([k, v]) => p.set(k, v));
      return p.toString();
    };
    const startIndex = (_page - 1) * _limit;
  %>

  <div class="overlay-bg" id="sidebarBg" onclick="closeSidebar()"></div>

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-icon">🪖</div>
      <span class="logo-text">Helmet Haven</span>
    </div>
    <nav class="nav">
      <a class="nav-item" href="/admin/adminDashboard">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Dashboard
      </a>
      <a class="nav-item" href="/admin/products">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        Products
      </a>
      <a class="nav-item" href="/admin/adminCustomer">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        Customers
      </a>
      <a class="nav-item" href="/admin/orders">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
        Orders
      </a>
      <a class="nav-item" href="/admin/coupons">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        Coupons
      </a>
      <a class="nav-item" href="/admin/categories">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 20h16M4 4h16M9 4v16M15 4v16"/></svg>
        Category
      </a>
      <a class="nav-item" href="/admin/brands">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
        Brands
      </a>
      <a class="nav-item" href="/admin/Inventory">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
        Inventory
      </a>
      <a class="nav-item" href="#">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
        Offers
      </a>
      <a class="nav-item" href="#">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><polyline points="3 9 12 15 21 9"/></svg>
        Banner
      </a>
      <a class="nav-item active" href="/admin/salesReport">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Sales Report
      </a>
      <a class="nav-item" href="/admin/logout">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </a>
    </nav>
  </aside>

  <!-- MAIN -->
  <div class="main">
    <header class="topbar">
      <div class="topbar-left">
        <button class="hamburger" onclick="toggleSidebar()" aria-label="Open menu">☰</button>
        <h1 class="page-title">Sales Report</h1>
      </div>
      <div class="topbar-right">
        <a href="/admin/sales-report/download/pdf?<%= qs() %>" class="btn-primary btn-pdf">PDF Download</a>
        <a href="/admin/sales-report/download/excel?<%= qs() %>" class="btn-primary btn-excel">Excel Download</a>
      </div>
    </header>

    <div class="content">

      <!-- Search + period filter -->
      <div class="filter-card">
        <div class="search-box">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="searchInput" placeholder="Search order ID or product name..." value="<%= _search %>"/>
        </div>

        <div class="dropdown" id="periodDropdown">
          <button type="button" class="dropdown-btn" id="periodBtn" aria-haspopup="true">
            <span id="periodLabel"><%= periodLabel %></span>
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="dropdown-menu">
           
        <a class="dropdown-item <%= _period === 'daily' ? 'active' : '' %>"
         href="/admin/salesReport?type=daily">Daily</a>

           <a class="dropdown-item <%= _period === 'weekly' ? 'active' : '' %>"
            href="/admin/salesReport?type=weekly">Weekly</a>

          <a class="dropdown-item <%= _period === 'monthly' ? 'active' : '' %>"
         href="/admin/salesReport?type=monthly">Monthly</a>

          <a class="dropdown-item <%= _period === 'yearly' ? 'active' : '' %>"
          href="/admin/salesReport?type=yearly">Yearly</a>

<div class="dropdown-divider"></div>

<button type="button" class="dropdown-item" id="customOption">
    Custom Date Range
</button>

          </div>
        </div>
      </div>

      <!-- Custom date range -->
      <form class="filter-card range-card <%= _period === 'custom' ? 'show' : '' %>"
      id="rangeCard"
      method="GET"
      action="/admin/salesReport">

    <input type="hidden" name="type" value="custom"/>
        <div class="range-field">
          <label for="fromDate">From Date</label>
         <input type="date" id="fromDate" name="startDate" required>
        </div>
        <div class="range-field">
          <label for="toDate">To Date</label>
        <input type="date" id="toDate" name="endDate" required>
        </div>
        <button type="submit" class="btn-primary">Apply Date Range</button>
      </form>

      <!-- Report period -->
      <div class="period-bar">
        <h2>Report Period</h2>
        <div class="period-range">
          <%= isoDate(_from) || 'N/A' %><span>→</span><%= isoDate(_to) || 'N/A' %>
        </div>
      </div>

      <!-- Stats -->
      <div class="stats">
        <div class="stat-card">
          <div class="stat-label">Total Revenue</div>
          <div class="stat-value accent"><%= money(_revenue) %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Total Orders</div>
          <div class="stat-value"><%= _orders.toLocaleString('en-IN') %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Total Discount</div>
          <div class="stat-value"><%= money(_discount) %></div>
        </div>
      </div>

      <!-- Table -->
      <div class="table-wrap">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>SL</th>
                <th>Order ID</th>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Discounted</th>
                <th>Payment Method</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% if (_sales.length === 0) { %>
                <tr class="empty-row">
                  <td colspan="8">No sales found for this period.</td>
                </tr>
              <% } else { %>
                <% _sales.forEach((s, i) => { %>
                  <tr>
                    <td><%= startIndex + i + 1 %></td>
                    <td><span class="order-id"><%= s.orderId || s.orderID || 'N/A' %></span></td>
                    <td class="product-name"><%= s.productName || s.product || 'N/A' %></td>
                    <td><%= s.quantity || 0 %></td>
                    <td><%= money(s.price) %></td>
                    <td><span class="discount-val"><%= money(s.discount ?? s.discounted) %></span></td>
                    <td><span class="badge"><%= s.paymentMethod || 'N/A' %></span></td>
                    <td><%= fmtDate(s.date || s.createdAt) %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="table-footer">
          <span class="results-count">
            Showing <%= _sales.length %> of <%= _totalRecords %> total sales
          </span>

          <% if (_totalPages > 1) { %>
          <div class="pagination">
            <a href="?<%= qs({ page: _page - 1 }) %>" class="<%= _page <= 1 ? 'disabled' : '' %>">Previous</a>
            <% for (let i = 1; i <= _totalPages; i++) { %>
              <a href="?<%= qs({ page: i }) %>" class="<%= _page === i ? 'active' : '' %>"><%= i %></a>
            <% } %>
            <a href="?<%= qs({ page: _page + 1 }) %>" class="<%= _page >= _totalPages ? 'disabled' : '' %>">Next</a>
          </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>

  <div id="toast"></div>

  <script>
    /* ── Search — reloads page with query params ── */
    function filterTable() {
      const q = document.getElementById("searchInput").value.trim();
      const params = new URLSearchParams(window.location.search);
      if (q) params.set("search", q); else params.delete("search");
      params.delete("page");
     window.location.href = `/admin/salesReport?${params.toString()}`;
    }
    let searchDebounce;
    document.getElementById("searchInput").addEventListener("input", () => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(filterTable, 400);
    });

    /* ── Period dropdown ── */
    const dropdown  = document.getElementById("periodDropdown");
    const rangeCard = document.getElementById("rangeCard");

    document.getElementById("periodBtn").addEventListener("click", (e) => {
      e.stopPropagation();
      dropdown.classList.toggle("open");
    });
    document.addEventListener("click", (e) => {
      if (!dropdown.contains(e.target)) dropdown.classList.remove("open");
    });

    document.getElementById("customOption").addEventListener("click", () => {
      document.getElementById("periodLabel").textContent = "Custom Date Range";
      rangeCard.classList.add("show");
      dropdown.classList.remove("open");
    });

    /* ── Custom range validation ── */
    rangeCard.addEventListener("submit", (e) => {
      const from = document.getElementById("fromDate").value;
      const to   = document.getElementById("toDate").value;
      if (from && to && from > to) {
        e.preventDefault();
        showToast("From date cannot be after To date.", false);
      }
    });
    document.getElementById("fromDate").addEventListener("change", (e) => {
      document.getElementById("toDate").min = e.target.value;
    });

    /* ── Toast ── */
    function showToast(msg, isOk = true) {
      const t = document.getElementById("toast");
      t.textContent   = msg;
      t.className     = isOk ? "" : "error";
      t.style.display = "block";
      setTimeout(() => { t.style.display = "none"; }, 3000);
    }

    /* ── Sidebar ── */
    function toggleSidebar() {
      document.getElementById("sidebar").classList.toggle("open");
      document.getElementById("sidebarBg").classList.toggle("open");
    }
    function closeSidebar() {
      document.getElementById("sidebar").classList.remove("open");
      document.getElementById("sidebarBg").classList.remove("open");
    }
  </script>
</body>
</html>