<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  /* ══════════════════════════
     TOAST SYSTEM
  ══════════════════════════ */
  function showToast(message, type = 'info', duration = 3000) {
    const icons = {
      success: 'bi-check-circle-fill',
      warning: 'bi-exclamation-triangle-fill',
      error:   'bi-x-circle-fill',
      info:    'bi-info-circle-fill'
    };
    const container = document.getElementById('toastContainer');
    const toast = document.createElement('div');
    toast.className = `toast-msg ${type}`;
    toast.innerHTML = `<i class="bi ${icons[type] || icons.info}"></i><span>${message}</span>`;
    container.appendChild(toast);
    setTimeout(() => {
      toast.style.animation = 'toastIn .3s ease reverse forwards';
      setTimeout(() => toast.remove(), 300);
    }, duration);
  }

  /* ══════════════════════════
     HAMBURGER / SIDEBAR
  ══════════════════════════ */
  const sidebar  = document.getElementById('sidebar');
  const overlay  = document.getElementById('sidebarOverlay');
  const hamburger = document.getElementById('hamburgerBtn');

  hamburger.addEventListener('click', toggleSidebar);
  overlay.addEventListener('click', closeSidebar);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeSidebar(); });

  function toggleSidebar() {
    const isOpen = sidebar.classList.toggle('open');
    overlay.classList.toggle('active', isOpen);
    hamburger.querySelector('i').className = isOpen ? 'bi bi-x-lg' : 'bi bi-list';
  }
  function closeSidebar() {
    sidebar.classList.remove('open');
    overlay.classList.remove('active');
    hamburger.querySelector('i').className = 'bi bi-list';
  }

  /* ══════════════════════════
     NAV CLICK VALIDATION
  ══════════════════════════ */
  function navClick(e, name) {
   
    if (e.currentTarget.getAttribute('href') === '#') {
      e.preventDefault();
      showToast(`Navigating to ${name}…`, 'info');
    }
    closeSidebar();
  }

  /* ══════════════════════════
     LOGOUT CONFIRMATION
  ══════════════════════════ */
  function confirmLogout() {
    return confirm('Are you sure you want to logout from the admin panel?');
  }

  /* ══════════════════════════
     BELL NOTIFICATION
  ══════════════════════════ */
  document.getElementById('bellBtn').addEventListener('click', function () {
    this.querySelector('.bell-dot')?.remove();
    showToast('No new notifications at this time.', 'info');
  });

  /* ══════════════════════════
     SEARCH VALIDATION
  ══════════════════════════ */
  const searchInput = document.getElementById('searchInput');
  const topSearch   = document.getElementById('topSearch');
  let searchTimer;

  searchInput.addEventListener('input', function () {
    clearTimeout(searchTimer);
    const val = this.value.trim();

    
    topSearch.classList.remove('error');

    if (val.length === 0) return;

    searchTimer = setTimeout(() => {
      if (val.length < 2) {
        topSearch.classList.add('error');
        document.getElementById('searchError').textContent = 'Please enter at least 2 characters';
      } else if (!/^[a-zA-Z0-9\s\-#]+$/.test(val)) {
        topSearch.classList.add('error');
        document.getElementById('searchError').textContent = 'Only letters, numbers, # and - allowed';
      } else {
        topSearch.classList.remove('error');
        // Simulate search feedback
        showToast(`Searching for "${val}"…`, 'info', 1800);
      }
    }, 400);
  });

  searchInput.addEventListener('blur', function () {
    const val = this.value.trim();
    if (val.length > 0 && val.length < 2) {
      topSearch.classList.add('error');
    }
  });

  searchInput.addEventListener('focus', function () {
    topSearch.classList.remove('error');
  });

  /* ══════════════════════════
     CHART
  ══════════════════════════ */
  const monthData = {
    labels: ['JAN','FEB','MAR','APR','MAY','JUN'],
    values: [18000, 26000, 22000, 32000, 45280, 36000]
  };
  const weekData = {
    labels: ['MON','TUE','WED','THU','FRI','SAT','SUN'],
    values: [3200, 4800, 3900, 5600, 7200, 6100, 4400]
  };

  const accentBlue = '#1d7fea';
  const barBg      = '#1a2a40';

  const ctx = document.getElementById('salesChart').getContext('2d');
  const salesChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: monthData.labels,
      datasets: [{
        data: monthData.values,
        backgroundColor: monthData.values.map((v, i) => i === 4 ? accentBlue : barBg),
        borderRadius: 6,
        borderSkipped: false,
        barPercentage: 0.55,
        categoryPercentage: 0.7
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#1a2232',
          titleColor: '#eef2f7',
          bodyColor: '#7a93a8',
          borderColor: '#1c2840',
          borderWidth: 1,
          callbacks: { label: ctx => ' ₹' + ctx.parsed.y.toLocaleString() }
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: '#3d5268', font: { size: 11, weight: '600' } },
          border: { display: false }
        },
        y: { display: false, grid: { display: false } }
      }
    }
  });

  function switchTab(data, activeBtn, inactiveBtn) {
    activeBtn.classList.add('active');
    inactiveBtn.classList.remove('active');
    const maxIdx = data.values.indexOf(Math.max(...data.values));
    salesChart.data.labels = data.labels;
    salesChart.data.datasets[0].data = data.values;
    salesChart.data.datasets[0].backgroundColor = data.values.map((_, i) =>
      i === maxIdx ? accentBlue : barBg
    );
    salesChart.update();
  }

  document.getElementById('monthBtn').addEventListener('click', function () {
    switchTab(monthData, this, document.getElementById('weekBtn'));
  });
  document.getElementById('weekBtn').addEventListener('click', function () {
    switchTab(weekData, this, document.getElementById('monthBtn'));
  });

  /* ══════════════════════════
     ORDER ROW CLICK
  ══════════════════════════ */
  document.querySelectorAll('tbody tr').forEach(row => {
    row.style.cursor = 'pointer';
    row.addEventListener('click', function () {
      const id = this.querySelector('.order-id')?.textContent;
      if (id) showToast(`Opening order ${id}`, 'info');
    });
  });
</script>
</body>
</html>